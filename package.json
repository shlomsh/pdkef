{
  "name": "pdkef",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Free, open-source PDF tools that run 100% locally in your browser - no upload, no signup, no watermark.",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package && node scripts/sync-pdfjs-wasm.mjs",
    "dev": "astro dev",
    "build": "node scripts/generate-font-manifest.mjs --check && node scripts/generate-language-acceptance.mjs --check && astro build && node scripts/generate-precache-manifest.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:changed": "vitest run --changed origin/main",
    "test:affected": "node scripts/affected-scope.mjs --run unit",
    "test:e2e": "npm run build && node scripts/affected-scope.mjs --run e2e-product && node scripts/affected-scope.mjs --run e2e-perf && node scripts/affected-scope.mjs --run fonts && node scripts/affected-scope.mjs --run export-guards",
    "test:e2e:product": "playwright test --project=chromium --project=webkit && playwright test --project=perf --workers=1",
    "test:e2e:fonts": "playwright test --project=fonts",
    "test:e2e:export-guards": "playwright test --project=export-guards",
    "test:csp": "node scripts/verify-csp.js",
    "test:gesture-golden-rule": "node scripts/check-gesture-golden-rule.js",
    "test:editor-dependency-directions": "node scripts/check-editor-dependency-directions.mjs",
    "test:module-boundaries": "node scripts/check-module-boundaries.mjs",
    "test:seo": "node scripts/verify-seo.js",
    "test:redirects": "node scripts/check-trailing-slash-redirects.js",
    "test:css": "node scripts/check-class-resolution.js && node scripts/check-editor-global-css.js && node scripts/check-dead-utilities.js && node scripts/check-css-duplication.js",
    "test:weight": "node scripts/check-page-weight.js",
    "test:lazy-modules": "node scripts/check-lazy-modules.js",
    "test:fonts": "node scripts/check-font-glyf-alignment.js",
    "test:licenses": "node scripts/runtime-license-inventory.mjs --check",
    "test:dependency-governance": "node scripts/verify-dependency-governance.mjs",
    "generate:font-coverage": "node scripts/generate-font-coverage.mjs",
    "generate:font-coverage-report": "node scripts/generate-font-coverage-report.mjs",
    "generate:font-manifest": "node scripts/generate-font-manifest.mjs",
    "generate:licenses": "node scripts/runtime-license-inventory.mjs --write",
    "generate:language-acceptance": "node scripts/generate-language-acceptance.mjs",
    "generate:backlog": "node scripts/generate-backlog.mjs",
    "sync:pdfjs-wasm": "node scripts/sync-pdfjs-wasm.mjs",
    "check:fast": "npm run check:backlog && npm run check:guidance && npm run test:editor-dependency-directions && npm run test:module-boundaries && npm run test:gesture-golden-rule && node scripts/check-class-resolution.js && npm run test:changed && npm run typecheck",
    "check:backlog": "node scripts/generate-backlog.mjs --check",
    "check:guidance": "node scripts/check-guidance-budget.js",
    "backlog:serve": "node scripts/serve-backlog-board.mjs",
    "seo:crawl-staleness": "node scripts/seo-crawl-staleness.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.5",
    "@cantoo/pdf-lib": "^2.9.1",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "@pdf-lib/fontkit": "^1.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.9.7",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.3.1",
    "bidi-js": "^1.1.0",
    "lucide-preact": "^1.42.0",
    "pdfjs-dist": "^6.3.289",
    "preact": "^10.29.8",
    "regenerator-runtime": "^0.14.1",
    "signature_pad": "^5.1.4",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@nx/js": "23.2.1",
    "@playwright/test": "^1.62.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sortablejs": "^1.15.8",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^30.0.1",
    "nx": "23.2.1",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "overrides": {
    "browserslist": "4.28.7",
    "fast-uri": "3.1.6",
    "svgo": "4.1.0",
    "smol-toml": "1.8.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
