{
  "name": "pdkef",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.8.0",
  "description": "Free, open-source PDF tools that run 100% locally in your browser - no upload, no signup, no watermark.",
  "license": "MIT",
  "scripts": {
    "postinstall": "patch-package && node scripts/sync-pdfjs-wasm.mjs",
    "dev": "astro dev",
    "errors:resolve": "node scripts/errors-resolve.mjs",
    "errors:read": "node scripts/errors-read.mjs",
    "ratings:read": "node scripts/ratings-read.mjs",
    "deploy:prod": "node scripts/deploy-prod.mjs",
    "build": "node scripts/generate-font-manifest.mjs --check && node scripts/generate-language-acceptance.mjs --check && astro build && node scripts/generate-precache-manifest.mjs",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:changed": "node scripts/unit-scope.mjs --run",
    "test:affected": "node scripts/affected-scope.mjs --run unit",
    "test:e2e": "npm run build && node scripts/affected-scope.mjs --run e2e-product && node scripts/affected-scope.mjs --run e2e-perf && node scripts/affected-scope.mjs --run fonts && node scripts/affected-scope.mjs --run export-guards",
    "test:e2e:product": "playwright test --project=chromium --project=webkit && playwright test --project=perf --workers=1",
    "test:e2e:fonts": "playwright test --project=fonts",
    "test:e2e:export-guards": "playwright test --project=export-guards",
    "test:csp": "node scripts/verify-csp.js",
    "test:gesture-golden-rule": "node scripts/check-gesture-golden-rule.js",
    "test:swallowed-errors": "node scripts/check-swallowed-errors.mjs",
    "test:navigating-away": "node scripts/check-navigating-away.mjs",
    "test:detection-purity": "node scripts/check-detection-purity.mjs",
    "test:editor-dependency-directions": "node scripts/check-editor-dependency-directions.mjs",
    "test:module-boundaries": "node scripts/check-module-boundaries.mjs",
    "test:ratchet-raises": "node scripts/check-ratchet-raises.mjs",
    "test:size-ratchet": "node scripts/check-size-ratchet.mjs",
    "test:e2e-sleeps": "node scripts/check-e2e-sleeps.mjs",
    "test:floating-promises": "node scripts/check-floating-promises.mjs",
    "test:reveal-observers": "node scripts/check-reveal-observers.mjs",
    "test:fetch-sites": "node scripts/check-fetch-sites.mjs",
    "test:patch-pins": "node scripts/check-patch-pins.mjs",
    "test:tool-shape": "node scripts/check-tool-shape.mjs",
    "test:js-typed": "node scripts/check-js-typed.mjs",
    "test:unused-exports": "node scripts/check-unused-exports.mjs",
    "test:seo": "node scripts/verify-seo.js",
    "test:redirects": "node scripts/check-trailing-slash-redirects.js",
    "test:css": "node scripts/check-class-resolution.js && node scripts/check-color-literals.mjs && node scripts/check-editor-global-css.js && node scripts/check-dead-utilities.js && node scripts/check-css-duplication.js && node scripts/check-built-html-comments.js && node scripts/check-animation-shorthand.js",
    "test:html-comments": "node scripts/check-built-html-comments.js",
    "test:weight": "node scripts/check-page-weight.js",
    "test:lazy-modules": "node scripts/check-lazy-modules.js",
    "test:precache-budget": "node scripts/check-precache-budget.mjs",
    "test:fonts": "node scripts/check-font-glyf-alignment.js",
    "test:licenses": "node scripts/runtime-license-inventory.mjs --check",
    "test:dependency-governance": "node scripts/verify-dependency-governance.mjs",
    "generate:font-coverage": "node scripts/generate-font-coverage.mjs",
    "generate:font-coverage-report": "node scripts/generate-font-coverage-report.mjs",
    "generate:font-manifest": "node scripts/generate-font-manifest.mjs",
    "generate:licenses": "node scripts/runtime-license-inventory.mjs --write",
    "generate:language-acceptance": "node scripts/generate-language-acceptance.mjs",
    "generate:backlog": "node scripts/generate-backlog.mjs",
    "generate:practice-form": "node scripts/generate-practice-form.mjs",
    "sync:pdfjs-wasm": "node scripts/sync-pdfjs-wasm.mjs",
    "check:fast": "node scripts/check-fast.mjs",
    "check:push": "node scripts/check-push.mjs",
    "check:e2e": "node scripts/check-push.mjs --e2e",
    "gate:ios": "node scripts/ios-gate/run.mjs",
    "check:backlog": "node scripts/generate-backlog.mjs --check",
    "check:guidance": "node scripts/check-guidance-budget.js",
    "check:never-say": "node scripts/check-never-say.mjs",
    "backlog:serve": "node scripts/serve-backlog-board.mjs",
    "seo:crawl-staleness": "node scripts/seo-crawl-staleness.mjs"
  },
  "dependencies": {
    "@astrojs/preact": "^6.1.1",
    "@cantoo/pdf-lib": "2.11.1",
    "@floating-ui/dom": "^1.8.0",
    "@floating-ui/react": "^0.27.20",
    "@pdf-lib/fontkit": "1.1.1",
    "@vercel/analytics": "^2.0.1",
    "@vercel/functions": "^3.10.3",
    "@vercel/speed-insights": "^2.0.0",
    "astro": "^7.4.2",
    "bidi-js": "^1.1.0",
    "lucide-preact": "^1.61.0",
    "pdfjs-dist": "^6.4.299",
    "preact": "^10.29.8",
    "regenerator-runtime": "^0.14.1",
    "signature_pad": "^5.1.4",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@nx/js": "24.0.0",
    "@playwright/test": "^1.64.1",
    "@preact/preset-vite": "^2.10.6",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sortablejs": "^1.15.8",
    "appium": "3.8.0",
    "esbuild": "^0.28.2",
    "fake-indexeddb": "^6.2.6",
    "jsdom": "^30.1.3",
    "nx": "24.0.0",
    "patch-package": "^8.0.1",
    "tailwindcss": "^4.3.2",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "browserslist": "4.28.7",
    "devalue": "5.9.4",
    "fast-uri": "3.1.9",
    "follow-redirects": "1.16.1",
    "svgo": "4.1.0",
    "smol-toml": "1.9.0",
    "shell-quote": "^1.11.0",
    "nx": {
      "axios": "1.20.0",
      "brace-expansion": "5.0.12",
      "undici": "7.30.1"
    }
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
