---
// Shared tool-page hero: the icon-left keyword <h1> and a value-prop subhead.
// The open-source trust chips (GitHub, MIT, Works offline) moved into
// AppBar.astro, unified with the sticky top bar the way index.astro already
// does it - see ToolPageLayout.astro, which passes them into <AppBar>.
// Keeps the single crawlable <h1> per page; the app-bar breadcrumb is nav.
import { splitHeroTitle } from '../site-lib/heroTitle';

interface Props {
  icon: any;
  title: string;
  subhead: string;
  slug: string;
  condensable: boolean;
  /** MERGE-06: fold the hero from first paint, on phones only, regardless of
   * whether a file is loaded yet - see the `data-hero-phone-condensed` style
   * block below for why this is a separate gate from `condensable`. Defaults
   * to false so every tool but merge renders exactly as before. */
  phoneCondensed?: boolean;
  /** QUAL-15: the locale's shared closer phrase ("on your device" in
   * English, DocumentationShellMessages.heroAccent) that gets the subhead's
   * citron stroke, when it occurs. Unlike QUAL-13's retired h1Accent this
   * never touches the h1 - see the stroke logic below for why it is counted
   * across the whole subhead before any sentence is touched. */
  subheadAccent?: string;
  /** HERO-01: the tool's name, the leading words of `title`, set large with
   * the rest of the h1 beneath it (see splitHeroTitle). Missing, or not a
   * clean prefix of the title, renders the h1 as one plain line. */
  titleName?: string;
}
const { icon: Icon, title, subhead, slug, condensable, phoneCondensed = false, subheadAccent, titleName } = Astro.props;

// Sign and Redact keep the icon-beside-title row: their condensed editor hero
// (ViewControl) is sized for it. The other tools stack the icon above the h1,
// every line on one start edge.
const stacked = slug !== 'sign' && slug !== 'redact';
const split = stacked ? splitHeroTitle(title, titleName) : null;

// Count occurrences of `subheadAccent` across the WHOLE subhead before
// touching any sentence: a phrase this codebase does not yet ship in every
// locale (he/id have no heroAccent yet, QUAL-14) or that a future closer
// could in principle repeat must render every sentence unchanged rather than
// guess which occurrence was meant - the same "rendering unchanged is always
// safer" rule QUAL-13's h1 split used. `subhead` splits into one
// `data-hero-sentence` span per sentence below (kept exactly as before, for
// the phone-condensed rule that hides every sentence after the first); only
// when the whole-subhead count is exactly 1 do we look for a sentence that
// carries it whole and split that one sentence's text around a
// `data-hero-accent` span. A phrase that straddled a ". " boundary would be
// counted once and found in no sentence, which falls through to the same
// unstroked render. before + subheadAccent + after reassembles to exactly
// that sentence, so the <p>'s textContent stays byte for byte what SEO tests
// expect.
function countOccurrences(haystack: string, needle: string): number {
  if (!needle) return 0;
  let count = 0;
  let index = haystack.indexOf(needle);
  while (index !== -1) {
    count += 1;
    index = haystack.indexOf(needle, index + needle.length);
  }
  return count;
}
const subheadAccentCount = subheadAccent ? countOccurrences(subhead, subheadAccent) : 0;
const sentences = subhead.split(/(?<=\. )/);

// The three gradient/text-color pairs used to be three separate arbitrary-value
// Tailwind class strings (`bg-[linear-gradient(...)]` plus a `text-[var(...)]`
// each), which is 500+ bytes of escaped-selector CSS the toolPage entry sheet
// compiles once and every one of the 12 tool pages ships identically - CLAUDE.md's
// CSS duplication ratchet in styling.md charges that in full regardless of which
// single page's icon is actually redact-toned. `data-icon-tone` plus the three
// small rules below (scoped, in this file's own <style>) say the same thing in
// far fewer bytes. Sign/redact are the two tools with a tone of their own; every
// other tool leaves the attribute unset and gets the plain default below.
const iconTone = slug === 'sign' ? 'sign' : slug === 'redact' ? 'redact' : undefined;
---

{/*
  Hero geometry lives in these custom properties so the icon tile and the
  subhead/chip indent can never drift apart.
  --hero-icon      the square icon tile
  --hero-title     the <h1> font size (pinned, not inherited from the UA's 2em)
  --hero-indent    icon + gap-4, so the subhead lines up under the title
  Icon and title are flush top-aligned (`items-start`, zero margin on both) -
  deliberately not nudged to centre against the title's first line, which
  looked right for a short one-line title but left the icon visibly adrift
  from the text once a longer h1 (e.g. Compress's) wrapped to two or three
  lines and the eye compared the icon against the whole block, not just line
  one.
*/}
<header
  class="tool-hero mx-auto w-full max-w-[1280px] px-6 pb-8 pt-14 min-[1024px]:px-8 min-[1024px]:pt-6"
  data-hero-condensable={condensable ? '' : undefined}
  data-hero-phone-condensed={phoneCondensed ? '' : undefined}
  data-hero-stacked={stacked ? '' : undefined}
>
  <div data-hero-row class="mb-3 flex gap-4">
    <div class="tool-hero-icon flex size-[var(--hero-icon)] shrink-0 items-center justify-center rounded-2xl border-0 shadow-[0_8px_18px_-8px_var(--color-primary-ring),inset_0_1px_0_rgba(255,255,255,0.5)]" data-tone={iconTone}>
      <Icon class="h-[55%] w-[55%]" size={28} strokeWidth={1.5} />
    </div>
    {split ? (
      <h1 class="mt-0 mb-0 text-start leading-[1.1]"><span data-hero-name>{split.name}</span> <span data-hero-rest>{split.rest}</span></h1>
    ) : (
      <h1 class="mt-0 mb-0 text-start text-[length:var(--hero-title)] leading-[1.1]">{title}</h1>
    )}
  </div>
  <p data-hero-sub class="type-lead max-w-[44rem]">
    {sentences.map((sentence) => {
      const accentIndex = subheadAccentCount === 1 ? sentence.indexOf(subheadAccent!) : -1;
      if (accentIndex === -1) {
        return <span data-hero-sentence>{sentence}</span>;
      }
      const sentenceBefore = sentence.slice(0, accentIndex);
      const sentenceAfter = sentence.slice(accentIndex + subheadAccent!.length);
      return <span data-hero-sentence>{sentenceBefore}<span data-hero-accent>{subheadAccent}</span>{sentenceAfter}</span>;
    })}
  </p>
  <i class="tool-hero-end" hidden></i>
</header>

<style>
  /* The hero is centred in the first screen, so a paint of a partly parsed
     hero (the icon alone, 74px tall) placed it 143px low and the rest of it
     pulled it up: CLS 0.015 on /compress/, one load in three. Same end marker
     as TrustChips.astro. */
  .tool-hero:not(:has(> .tool-hero-end)) {
    visibility: hidden;
  }

  /* The icon tile's gradient and text color, keyed off `data-tone` (see the
     frontmatter comment above): plain CSS instead of three arbitrary-value
     Tailwind class strings, which the toolPage entry sheet used to compile in
     full and ship to all 12 tool pages regardless of which one is actually
     sign- or redact-toned. The unset-attribute case is every other tool's
     default tone, so it needs no selector of its own. */
  .tool-hero-icon {
    background-image: linear-gradient(150deg, var(--color-muted-light), var(--color-border-strong));
    color: var(--color-surface);
  }
  .tool-hero-icon[data-tone='sign'] {
    background-image: linear-gradient(150deg, var(--color-primary-hover), var(--color-primary));
  }
  .tool-hero-icon[data-tone='redact'] {
    background-image: linear-gradient(150deg, var(--color-surface), var(--color-success-soft));
    color: var(--color-success);
  }

  /* Hero geometry. The stacked layout (every tool but Sign and Redact) is a
     plain block: icon, h1 and subhead on one start edge. Sign and Redact keep
     the earlier icon-beside-title row, and on desktop the two-column grid that
     lines the subhead up under the title; it lives here, not in utilities,
     so the eight stacked pages do not ship it as dead CSS. */
  .tool-hero {
    --hero-icon: 2.25rem;
    --hero-title: 2rem;
  }
  .tool-hero:not([data-hero-stacked]) {
    --hero-icon: clamp(44px, 8vw, 52px);
    --hero-indent: calc(var(--hero-icon) + 1rem);
  }
  .tool-hero:not([data-hero-stacked]) [data-hero-row] {
    align-items: flex-start;
    justify-content: center;
  }
  .tool-hero:not([data-hero-stacked]) [data-hero-sub] {
    margin-inline: auto;
  }
  .tool-hero[data-hero-stacked] [data-hero-row] {
    flex-direction: column;
    align-items: flex-start;
  }
  @media (min-width: 1024px) {
    .tool-hero[data-hero-stacked] [data-hero-sub] {
      max-width: 44ch;
    }
    .tool-hero:not([data-hero-stacked]) {
      --hero-icon: 2.75rem;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: 1.5rem;
      padding-bottom: 0.25rem;
    }
    .tool-hero:not([data-hero-stacked]) [data-hero-row] {
      grid-column: 1;
      grid-row: 1;
      margin-bottom: 0;
      justify-content: flex-start;
    }
    .tool-hero:not([data-hero-stacked]) [data-hero-sub] {
      grid-column: 1 / 3;
      grid-row: 2;
      margin-inline: var(--hero-indent) 0;
      margin-top: 0.5rem;
      text-align: start;
    }
  }

  /* HERO-01: the split h1. The name is the headline, tight and large; the
     rest of the SEO title is a quieter line under it. Both are blocks, joined
     in the markup by one literal space, so the h1's textContent is the title
     byte for byte. Scoped to this component's own elements, so no :global(). */
  [data-hero-name] {
    display: block;
    font-size: 2.25rem;
    font-weight: inherit;
    letter-spacing: -0.035em;
    line-height: 1;
    text-wrap: balance;
  }
  [data-hero-rest] {
    display: block;
    margin-top: 0.5rem;
    font-size: 1.06rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--color-muted);
  }
  @media (min-width: 1024px) {
    [data-hero-name] {
      font-size: var(--type-hero-size);
    }
    [data-hero-rest] {
      margin-top: 0.75rem;
      font-size: 1.3rem;
    }
  }

  /* QUAL-15: the subhead's citron stroke, in place of QUAL-13's retired h1
     stroke (see this file's git history for that span/rule, and the
     subheadAccent prop above for how the phrase is chosen and counted). The
     home hero draws its stroke with a rotated `::before` behind the text
     (HomePageLayout.astro's `.hero-header h1 span`/`::before`), which only
     works for a single, `nowrap` phrase. The subhead's closer can wrap at a
     narrow width ("stays on your device" on /sign/ at 390px), so the stroke
     is a background band drawn behind the text instead, no text-colour
     change: `box-decoration-break: clone` makes it restart on each wrapped
     fragment rather than stretching across the gap between lines the way a
     single `::before` would. Tuned by eye at the lead (type-lead) text size
     so the band sits under the lower half of the x-height, not the
     descenders. */
  [data-hero-accent] {
    background-image: linear-gradient(var(--color-citron), var(--color-citron));
    background-size: 100% 0.5em;
    background-position: 0 88%;
    background-repeat: no-repeat;
    box-decoration-break: clone;
    -webkit-box-decoration-break: clone;
  }

  /* MERGE-06: a phone-only fold-away, separate from the condensable gates
     below, because those only ever engage once a file is open
     ([data-tool-shell], the draft hint, the density preference) - all three
     are about giving a loaded document its room back. This one is about the
     empty state itself: on a 375-wide phone the un-collapsed hero (H1 +
     three-line subhead + the no-limit note) measured "Choose files" landing
     around 700 CSS px down, at the bottom edge of the first screen, for
     merge, the most searched tool in the suite. The fix is to start
     condensed on phones from first paint, before any file exists to trigger
     the other gates.

     The subhead is clamped to two lines, never `display: none` - the SEO
     shell stays static HTML and mobile-first Googlebot must still see the
     copy (CLAUDE.md's SEO invariant), and hiding it outright would be no
     different from deleting it for the audience that matters most for
     ranking. Two lines keeps the value prop readable while giving back most
     of the vertical space the fourth line and its wrapped third line cost.

     Only rendered when a tool opts in via `data-hero-phone-condensed`
     (src/data/tools.js's `heroPhoneCondensed`, passed through by
     ToolPageLayout.astro) - every other tool's empty state is unchanged. */
  @media (max-width: 767px) {
    .tool-hero[data-hero-phone-condensed] {
      padding-top: 1.5rem;
      padding-bottom: 0.75rem;
      --hero-title: clamp(1.5rem, 6.5vw, 1.85rem);
    }

    .tool-hero[data-hero-phone-condensed] [data-hero-name] {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
    }

    /* MERGE-06 follow-up: a line-clamp cut mid-sentence ("...and…") - the
       last visible words were never a whole thought. The subhead is now
       split into one <span data-hero-sentence> per sentence (see the
       frontmatter above), so instead of clamping lines we hide every
       sentence after the first outright, leaving exactly one complete
       sentence on a phone. Content authors keep this working by writing a
       phone-length first sentence (see src/data/tools.js). */
    .tool-hero[data-hero-phone-condensed] [data-hero-sub] [data-hero-sentence]:not(:first-child) {
      display: none;
    }
  }

  /* Once a file is open, the hero keeps its title line and folds the rest away.
     Reading the pitch is not what you are doing at that point - you are looking
     at your document, and on a 1512x870 laptop the pitch was costing about a
     fifth of the screen directly above it.

     `[data-tool-shell]` is the file-open signal: ToolShell renders only once a
     file is loaded, in every tool (see ToolShell.tsx). No JavaScript is involved
     and no state is duplicated - the DOM already says whether you have a file.

     This is deliberately not an SEO risk, and the reasoning matters more than
     the rule:
       - Every word stays server-rendered in the HTML, in its original order,
         with the one crawlable <h1> untouched. Nothing is moved into the island.
       - A crawler never opens a file, so `:has()` never matches and Googlebot
         renders the full hero exactly as before. It is state-driven CSS, the
         same as an open menu, not two different pages for two audiences.
       - The copy is visible by default, so it keeps full weight. Content hidden
         *by default* behind a tab or accordion is what gets discounted; this is
         the opposite.
     Do not "simplify" this into hiding the copy by default, or into removing it
     from the .astro file, which would be all three of those things at once.

     `html[data-draft-hint]` is the second, earlier gate: a returning visitor
     with a saved Sign/Redact draft gets the same collapse applied by a
     blocking script before first paint (see ToolPageLayout.astro), instead of
     waiting for `[data-tool-shell]` to appear once the async IndexedDB restore
     and hydration finish. Without it that restore is a real, input-less layout
     shift - the hero visibly collapsing a moment after the page already
     painted expanded - which Core Web Vitals' CLS metric scores. Both gates
     drive the exact same declarations so there is one visual state, not a
     hint state and a real state that could ever disagree; the hint is removed
     (by useDraftPersistence.js) if the restore turns out to have nothing to
     show, so a stale hint self-corrects instead of leaving the hero wrongly
     collapsed for good.

     Two more gates sit on top of both triggers now (E9): a `density`
     preference (`html[data-view-density='condensed']`) so the fold-away is
     opt-out instead of permanent, and a per-tool `condenseOnLoad` flag
     (`[data-hero-condensable]`, only rendered on the header when the tool
     opts in - see src/data/tools.js) so short single-card tools never fold at
     all. `data-draft-hint` itself is density-independent: ToolPageLayout also
     uses it to reserve space while saved work restores for Relaxed users.
     These selectors therefore repeat the density gate, so changing to
     Relaxed expands the hero while the reservation remains available.

     A third gate, viewport width, was added 2026-09-12 (Shlomi, from the
     /compress/ and /merge/ pass: picking a file used to shrink this title and
     drop the subhead at every width, which is what made the option cards and
     the primary button jump up underneath it). Below 1024px that fold-away is
     still doing real work: docs/view-density-control-spec.md 4.7 and
     src/data/tools.js record it by name for Compress and Compress Image
     specifically ("the Compress button sat ~550px below the fold" on a
     phone), and it is kept there, unchanged, for exactly that reason. At
     1024px and up the fold-away's own stated purpose - fit the page in a
     desktop viewport after a file is picked - is now met a different way: the
     loaded card's identity row below is a compact row on desktop instead of
     the ~320px stacked dropzone that used to sit there (see
     ToolShell.module.css), and the HERO-02 fold below (one row of tile and
     name) takes the hero's own height back, which together buy back more
     vertical space than this fold-away used to cost. See the fit
     numbers this traded against in pick-stability.mjs's report. Confirm the
     fit again before ever reverting this split. */
  @media (max-width: 1023px) {
    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-condensable],
    :global(html[data-view-density='condensed'][data-draft-hint]) .tool-hero[data-hero-condensable],
    :global(html[data-view-density='condensed'][data-handoff-pending]) .tool-hero[data-hero-condensable] {
      padding-bottom: 0.75rem;

      /* Below the desktop breakpoint the hero opens with 56px (pt-14) of air
         above the title. That is the opening-statement spacing; once a file is
         open the title is orientation, and on a phone those 56px were a real
         share of what pushed a tool's primary action (Compress's button, most
         visibly) below the fold. */
      padding-top: 1.5rem;
    }

    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed'][data-draft-hint]) .tool-hero[data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed'][data-handoff-pending]) .tool-hero[data-hero-condensable] [data-hero-sub] {
      display: none;
    }
  }

  /* Sign and Redact are the one exception to "no condensing at desktop"
     above, and the reason is a different rule than Compress's: their
     `ViewControl` (>=920px segmented Relaxed/Condensed/Full screen control,
     see docs/view-density-control-spec.md) is a user-facing preference
     whose *only* visible effect is this hero fold - there is nothing else
     for "Condensed" to do (`ViewControl.tsx`/`useViewDensity.js` only ever
     write the `data-view-density` attribute this file reads). The spec's own
     worked example is a 1512x870 laptop, i.e. desktop width; disabling the
     fold there would make that control's Condensed segment do nothing on a
     real desktop, which is not the "stop condensing on desktop" this ticket
     asked for - that request was about the automatic, permanent fold on
     tools with no control to turn it back on.

     Once hydration has mounted the editor, Sign/Redact are told apart by
     `ViewControl`'s own DOM footprint: `[aria-label="View density"]`. During
     a saved-work restore, however, that control cannot exist yet: the inline
     head script has already established the validated, Sign/Redact-only
     `data-editor-restore` marker while IndexedDB and Preact are still loading.
     It is the synchronous equivalent of the mounted control, so both paths
     must use the identical declarations. This keeps the pre-paint geometry
     from changing when the control appears.

     The marker is deliberately narrower than `data-draft-hint`. Merge also
     uses the latter to reserve its first viewport, but has no View Density
     control. ToolPageLayout only writes `data-editor-restore` after the
     current pointer matches a recent-file index row; an obviously stale
     pointer therefore remains a fresh, expanded visit instead of collapsing
     then expanding when hydration rejects it. Every other condensable tool
     (Compress included) falls through to the desktop-relaxed rule above. */
  @media (min-width: 1024px) {
    :global(html[data-view-density='condensed']:has([aria-label='View density'])) .tool-hero[data-hero-condensable],
    :global(html[data-view-density='condensed'][data-editor-restore]) .tool-hero[data-hero-condensable] {
      padding-bottom: 0.75rem;
      --hero-title: 1.75rem;
      --hero-icon: 2.5rem;
    }

    :global(html[data-view-density='condensed']:has([aria-label='View density'])) .tool-hero[data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed'][data-editor-restore]) .tool-hero[data-hero-condensable] [data-hero-sub] {
      display: none;
    }

  }

  /* HERO-02: after a file lands, a stacked (page-grid) hero on desktop folds
     to one row: the 2rem tile beside the tool name at 1.6rem, start-aligned,
     1rem above and 0.75rem below (5.5rem all told; PdfTool.module.css gives
     the loaded card that much less min-height than the first screen). Same
     mechanism as the folds above: the subhead leaves the paint with display:none and the rest of the h1
     is visually hidden (still read by assistive tech). The Merge restore
     markers repeat the gates so a returning visitor's hero is condensed from first paint. The signals are the page-level ones: [data-tool-shell]
     (every ToolShell tool) and [data-tool-loaded] (the loaded card; Merge has
     no ToolShell). Sign and Redact are not stacked and keep their own rules. */
  @media (min-width: 1024px) {
    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-stacked][data-hero-condensable],
    :global(html[data-view-density='condensed']:has([data-tool-loaded])) .tool-hero[data-hero-stacked][data-hero-condensable],
    :global(html[data-view-density='condensed'][data-merge-restore]) .tool-hero[data-hero-stacked][data-hero-condensable],
    :global(html[data-view-density='condensed'][data-handoff-pending]) .tool-hero[data-hero-stacked][data-hero-condensable],
    :global(html[data-view-density='condensed']:has([data-merge-restored-workspace])) .tool-hero[data-hero-stacked][data-hero-condensable] {
      --hero-icon: 2rem;
      padding-top: 1rem;
      padding-bottom: 0.75rem;
    }

    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-row],
    :global(html[data-view-density='condensed']:has([data-tool-loaded])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-row],
    :global(html[data-view-density='condensed'][data-merge-restore]) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-row],
    :global(html[data-view-density='condensed'][data-handoff-pending]) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-row],
    :global(html[data-view-density='condensed']:has([data-merge-restored-workspace])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-row] {
      flex-direction: row;
      align-items: center;
      justify-content: flex-start;
      margin-bottom: 0;
    }

    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-name],
    :global(html[data-view-density='condensed']:has([data-tool-loaded])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-name],
    :global(html[data-view-density='condensed'][data-merge-restore]) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-name],
    :global(html[data-view-density='condensed'][data-handoff-pending]) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-name],
    :global(html[data-view-density='condensed']:has([data-merge-restored-workspace])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-name] {
      font-size: 1.6rem;
    }

    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed']:has([data-tool-loaded])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed'][data-merge-restore]) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed'][data-handoff-pending]) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-sub],
    :global(html[data-view-density='condensed']:has([data-merge-restored-workspace])) .tool-hero[data-hero-stacked][data-hero-condensable] [data-hero-sub] {
      display: none;
    }

    /* Visually hidden, not display:none: the h1 keeps reading in full. */
