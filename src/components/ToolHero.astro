---
// Shared tool-page hero: the suite app bar, the icon-left keyword <h1>, a
// value-prop subhead, and the open-source chip row (identical on every tool).
// Keeps the single crawlable <h1> per page; the app-bar breadcrumb is nav.
interface Props {
  icon: any;
  title: string;
  subhead: string;
  slug: string;
  condensable: boolean;
}
const { icon: Icon, title, subhead, slug, condensable } = Astro.props;

const iconTone = slug === 'sign'
  ? 'bg-[linear-gradient(150deg,var(--color-primary-hover),var(--color-primary))] text-[var(--color-surface)]'
  : slug === 'redact'
    ? 'bg-[linear-gradient(150deg,var(--color-surface),var(--color-success-soft))] text-[var(--color-success)]'
    : 'bg-[linear-gradient(150deg,var(--color-muted-light),var(--color-border-strong))] text-[var(--color-surface)]';
---

<!--
  Hero geometry lives in these four custom properties so the icon tile, the
  title's first-line offset and the subhead/chip indent can never drift apart.
  --hero-icon      the square icon tile
  --hero-title     the <h1> font size (pinned, not inherited from the UA's 2em)
  --hero-line      that title's first line box: --hero-title x the 1.1 leading
  --hero-indent    icon + gap-4, so the subhead lines up under the title
  The tile is TALLER than the first line box, so the title is nudged down half
  the difference to centre the two. Anything below that shares --hero-indent.
-->
<header class="tool-hero mx-auto w-full max-w-[1400px] px-6 pb-8 pt-14 min-[1024px]:grid min-[1024px]:grid-cols-[minmax(0,1fr)_auto] min-[1024px]:items-center min-[1024px]:gap-x-6 min-[1024px]:px-6 min-[1024px]:pb-3 min-[1024px]:pt-2 [--hero-icon:clamp(44px,8vw,52px)] [--hero-indent:calc(var(--hero-icon)_+_1rem)] [--hero-line:calc(var(--hero-title)*1.1)] [--hero-title:2rem] min-[1024px]:[--hero-icon:2.75rem] min-[1024px]:[--hero-title:2rem]" data-hero-condensable={condensable ? '' : undefined}>
  <div class="mb-3 flex items-start justify-center gap-4 min-[1024px]:col-start-1 min-[1024px]:row-start-1 min-[1024px]:mb-0 min-[1024px]:justify-start">
    <div class={`flex size-[var(--hero-icon)] shrink-0 items-center justify-center rounded-2xl border-0 shadow-[0_8px_18px_-8px_var(--color-primary-ring),inset_0_1px_0_rgba(255,255,255,0.5)] ${iconTone}`}>
      <Icon class="h-[55%] w-[55%]" size={28} strokeWidth={1.5} />
    </div>
    <h1 class="mb-0 mt-[calc((var(--hero-icon)_-_var(--hero-line))/2)] text-left text-[length:var(--hero-title)] leading-[1.1]">{title}</h1>
  </div>
  <p data-hero-sub class="mx-auto max-w-[54rem] min-[1024px]:col-span-2 min-[1024px]:row-start-2 min-[1024px]:mx-0 min-[1024px]:ml-[var(--hero-indent)] min-[1024px]:mt-2 min-[1024px]:text-left min-[1024px]:text-[0.9375rem] min-[1024px]:leading-[1.45]">{subhead}</p>
  <div data-hero-chips class="mt-6 flex flex-wrap justify-center gap-[0.6rem] min-[1024px]:col-start-2 min-[1024px]:row-start-1 min-[1024px]:mt-0 min-[1024px]:justify-end min-[1024px]:justify-self-end min-[1024px]:pl-0">
    <a class="inline-flex items-center gap-[0.45rem] rounded-[10px] border-[0.5px] border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.45rem] text-[0.8rem] font-semibold text-[var(--color-text)] no-underline transition-[transform,border-color,color] duration-150 ease-out hover:-translate-y-px hover:border-[var(--color-border-strong)] hover:text-[var(--color-text)]" href="https://github.com/shlomsh/pdkef" target="_blank" rel="noopener noreferrer">
      <svg class="shrink-0 text-[var(--color-text)]" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.79.62-3.38-1.37-3.38-1.37-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.34 9.34 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
      </svg>
      Star us on GitHub
      <svg class="shrink-0 text-[var(--color-primary)]" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 7.1-1.01L12 2z" />
      </svg>
    </a>
    <span class="inline-flex items-center gap-[0.45rem] rounded-[10px] border-[0.5px] border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.45rem] text-[0.8rem] font-semibold text-[var(--color-muted)]">
      <svg class="shrink-0 text-[var(--color-muted-light)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3v18" /><path d="M7 7l-4 6a4 4 0 0 0 8 0l-4-6z" /><path d="M17 7l-4 6a4 4 0 0 0 8 0l-4-6z" /><path d="M6 21h12" /><path d="M8 5h8" />
      </svg>
      MIT licensed
    </span>
    <span class="inline-flex items-center gap-[0.45rem] rounded-[10px] border-[0.5px] border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.45rem] text-[0.8rem] font-semibold text-[var(--color-muted)]">
      <svg class="shrink-0 text-[var(--color-muted-light)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 20h.01" /><path d="M8.5 16.429a5 5 0 0 1 7 0" /><path d="M5 12.859a10 10 0 0 1 5.17-2.69" /><path d="M19 12.859a10 10 0 0 0-2.007-1.523" /><path d="M2 8.82a15 15 0 0 1 4.177-2.643" /><path d="M22 8.82a15 15 0 0 0-11.288-3.764" /><path d="m2 2 20 20" />
      </svg>
      Works offline
    </span>
  </div>
</header>

<style>
  /* Once a file is open, the hero keeps its title line and folds the rest away.
     Reading the pitch is not what you are doing at that point - you are looking
     at your document, and on a 1512x870 laptop the pitch was costing about a
     fifth of the screen directly above it.

     `[data-tool-shell]` is the file-open signal: ToolShell renders only once a
     file is loaded, in every tool (see ToolShell.tsx). No JavaScript is involved
     and no state is duplicated - the DOM already says whether you have a file.

     This is deliberately not an SEO risk, and the reasoning matters more than
     the rule:
       - Every word stays server-rendered in the HTML, in its original order,
         with the one crawlable <h1> untouched. Nothing is moved into the island.
       - A crawler never opens a file, so `:has()` never matches and Googlebot
         renders the full hero exactly as before. It is state-driven CSS, the
         same as an open menu, not two different pages for two audiences.
       - The copy is visible by default, so it keeps full weight. Content hidden
         *by default* behind a tab or accordion is what gets discounted; this is
         the opposite.
     Do not "simplify" this into hiding the copy by default, or into removing it
     from the .astro file, which would be all three of those things at once.

     `html[data-draft-hint]` is the second, earlier gate: a returning visitor
     with a saved Sign/Redact draft gets the same collapse applied by a
     blocking script before first paint (see ToolPageLayout.astro), instead of
     waiting for `[data-tool-shell]` to appear once the async IndexedDB restore
     and hydration finish. Without it that restore is a real, input-less layout
     shift - the hero visibly collapsing a moment after the page already
     painted expanded - which Core Web Vitals' CLS metric scores. Both gates
     drive the exact same declarations so there is one visual state, not a
     hint state and a real state that could ever disagree; the hint is removed
     (by useDraftPersistence.js) if the restore turns out to have nothing to
     show, so a stale hint self-corrects instead of leaving the hero wrongly
     collapsed for good.

     Two more gates sit on top of both triggers now (E9): a `density`
     preference (`html[data-view-density='condensed']`) so the fold-away is
     opt-out instead of permanent, and a per-tool `condenseOnLoad` flag
     (`[data-hero-condensable]`, only rendered on the header when the tool
     opts in - see src/data/tools.js) so short single-card tools never fold at
     all. The draft-hint trigger already bakes the density check into whether
     `data-draft-hint` gets set (ToolPageLayout.astro's inline script only
     sets it when density is condensed), so it only needs the condensable
     gate repeated here - not the density one again. */
  :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-condensable],
  :global(html[data-draft-hint]) .tool-hero[data-hero-condensable] {
    padding-bottom: 0.75rem;
  }

  :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-condensable] [data-hero-sub],
  :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-condensable] [data-hero-chips],
  :global(html[data-draft-hint]) .tool-hero[data-hero-condensable] [data-hero-sub],
  :global(html[data-draft-hint]) .tool-hero[data-hero-condensable] [data-hero-chips] {
    display: none;
  }

  /* The title stays, one step quieter: it is orientation now rather than the
     page's opening statement. */
  @media (min-width: 1024px) {
    :global(html[data-view-density='condensed']:has([data-tool-shell])) .tool-hero[data-hero-condensable],
    :global(html[data-draft-hint]) .tool-hero[data-hero-condensable] {
      --hero-title: 1.75rem;
      --hero-icon: 2.5rem;
    }
  }
</style>
