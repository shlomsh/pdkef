---
// The static renderer shared by English and localized documentation routes.
import FeatureCard from './FeatureCard.astro';
import CardDecor from './CardDecor.astro';
import CompareFigure from './CompareFigure.astro';
import CompareTable from './CompareTable.astro';
import ContentImage from './ContentImage.astro';
import ContentTable from './ContentTable.astro';
import OtherGuides from './OtherGuides.astro';
import { CONTENT_ICONS } from '../data/contentIcons';
import { guides } from '../data/contentPages.js';
import { CONTENT_FLOW_CLASS, CONTENT_PARAGRAPH_CLASS, STEP_ITEM_CLASS, STEP_LIST_CLASS, STEP_NUMBER_CLASS, STEP_TEXT_CLASS, renderInline } from '../site-lib/contentMarkup';
import type { DocumentationShellMessages } from '../i18n/documentationMessages';

interface Props { entry: any; pageId?: string; locale?: string; labels: DocumentationShellMessages; resolveLink?: (pageId: string, locale: string) => { href: string; effectiveLocale?: string; fallback?: boolean }; }
const { entry, pageId = entry.data.pageId ?? entry.id, locale = 'en', labels, resolveLink } = Astro.props as Props;
const page = entry.data;
const englishHref = `/${pageId}/`;
const isDeviceGuide = guides.some((guide) => guide.href === englishHref);
// Every block of a section sits in one CONTENT_FLOW_CLASS column, which owns
// the gap between any two blocks; no block carries a trailing margin of its
// own (2026-10-22: per-block gaps had drifted to 0, 24 and 32px).
const COLUMNS = 'space-layout-gap grid grid-cols-3 max-[768px]:grid-cols-1';
---

{page.sections.map((section: any) => (
  <FeatureCard density="flow" variant={section.variant} class="relative isolate overflow-hidden">
    <CardDecor sketch={section.sketch} icon={CONTENT_ICONS[section.icon as keyof typeof CONTENT_ICONS]} iconPos={section.iconPos} iconSize={280} />
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary-text)]" set:html={renderInline(section.kicker)} />
    <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]" set:html={renderInline(section.heading)} />
    <div class={CONTENT_FLOW_CLASS}>
    {section.blocks.map((block: any) => (
      <Fragment>
        {block.kind === 'prose' && <p class={CONTENT_PARAGRAPH_CLASS} set:html={renderInline(block.text)} />}
        {(block.kind === 'steps' || block.kind === 'checklist') && (() => { const ListTag = block.kind === 'steps' ? 'ol' : 'ul'; return <ListTag class={STEP_LIST_CLASS}>{block.items.map((item: string, n: number) => <li class={STEP_ITEM_CLASS}><span class={STEP_NUMBER_CLASS}>{n + 1}</span><span class={STEP_TEXT_CLASS} set:html={renderInline(item)} /></li>)}</ListTag>; })()}
        {block.kind === 'compare' && <CompareTable builtInLabel={block.builtInLabel} rows={block.rows} caption={block.caption} />}
        {block.kind === 'image' && <ContentImage {...block} />}
        {block.kind === 'compareFigure' && <CompareFigure {...block} />}
        {block.kind === 'table' && <ContentTable {...block} />}
        {block.kind === 'columns' && <div class={COLUMNS}>{block.items.map((column: any) => { const ColumnIcon = CONTENT_ICONS[column.icon as keyof typeof CONTENT_ICONS]; return <div class="flex flex-col gap-2"><div class="type-card mb-1 flex items-center gap-2 text-[var(--color-text)]"><ColumnIcon size={17} class="text-[var(--color-primary-text)]" /><Fragment set:html={renderInline(column.title)} /></div><p class="type-body m-0 text-[var(--color-muted)]" set:html={renderInline(column.body, 'muted')} /></div>; })}</div>}
      </Fragment>
    ))}
    </div>
  </FeatureCard>
))}

{isDeviceGuide && <OtherGuides currentHref={englishHref} locale={locale} labels={labels} resolveLink={resolveLink} />}
