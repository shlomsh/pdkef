---
/**
 * The three app-bar trust chips (GitHub star, open source, works offline)
 * and their wrapper, rendered from one place so the home page and every
 * tool page carry the exact same markup, icons and look.
 *
 * Their rules live in this component's own scoped style block rather than
 * in AppBar.astro, and not as utilities either: AppBar renders on every page
 * and is @source'd by every family sheet, so chip CSS there (a style block
 * or utilities) ships to the eleven guide and trust pages that never render
 * a chip, while Astro inlines this block only on the pages that import this
 * component (the home and tool layouts). Plain rules are also a third the
 * size of the equivalent utilities, whose per-breakpoint variants each wrap
 * themselves in their own media query.
 *
 * The values are the home page's, measured before the two headers were
 * unified (1440px: 1px border, 0.22rem/0.6rem padding, 0.35rem icon gap,
 * 0.45rem between chips, 28.8px min-height). Home used to carry them as
 * `.home-header .home-trust .trust-chip` overrides that out-specified an
 * older, slightly different copy in AppBar.astro, which is exactly how the
 * two headers drifted apart. Under 1024px the labels shrink; under 721px each
 * chip is the same 2rem icon square whose aria-label carries the name, and
 * the wrapper goes fixed-width so the bar's breadcrumb is what gives way.
 *
 * `offlineHref` turns the offline chip into a link (home points it at its
 * own install section, `#offline-app`, and homeWorkspace.ts scrolls there);
 * a page with no such target renders the same chip as a plain badge.
 *
 * The offline chip carries a hand-drawn crossed-out Wi-Fi mark rather than
 * lucide's `WifiOff`. It is the one element here with letters to resolve, so
 * it is the chip the shared 2rem phone-width box costs something: see the
 * note on that box below. The icon it used to carry is the iOS and macOS
 * status-bar glyph, pixel for pixel, so under 720px - where the label is
 * hidden and only the icon is left - it landed in the visual slot where the
 * system reports signal, and read as "you have no reception" rather than
 * "this needs none". A struck wordmark is a claim about a technology, the way
 * "gluten free" is; a struck status glyph can only ever report a state.
 * Drawn as strokes rather than set in a face, so it needs no web font and
 * takes `currentColor` with the chip's hover and focus states.
 */
import { Code2 } from 'lucide-preact';

interface Props {
  labels: { starOnGithub: string; openSource: string; worksOffline: string };
  offlineHref?: string;
}
const { labels, offlineHref } = Astro.props;

// One element, one copy of the mark: the link and badge forms differ only in
// tag and in the two attributes below.
const OfflineChip = offlineHref ? 'a' : 'span';
const offlineAttrs = offlineHref ? { href: offlineHref, 'data-offline-link': true } : { role: 'img' as const };
---

<div class="trust-chips">
  <a class="trust-chip" href="https://github.com/shlomsh/pdkef" target="_blank" rel="noopener noreferrer" aria-label={labels.starOnGithub}>
    <svg class="trust-chip-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.79.62-3.38-1.37-3.38-1.37-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.34 9.34 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" /></svg>
    <span>{labels.starOnGithub}</span>
  </a>
  {/* Code brackets, not the scales of justice the chip used to carry: this
      chip is the open-source-and-free promise (the same icon the home page's
      "Open source" pill uses), and a courtroom icon beside the word
      "licence" read as a legal condition rather than a gift. */}
  <a class="trust-chip" href="/licenses/" aria-label={labels.openSource}><Code2 class="trust-chip-icon" size={14} strokeWidth={1.9} aria-hidden="true" /><span>{labels.openSource}</span></a>
  <OfflineChip class="trust-chip" {...offlineAttrs} aria-label={labels.worksOffline}>
    <svg class="trust-chip-mark" viewBox="0 0 100 64" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M47 3.2 C73 1.6 95.4 6.4 96.8 30 C97.7 54.6 74.6 61.9 48 61 C23.4 60.3 3.7 56.1 2.6 33 C1.5 9.4 23 4.3 47 3.2 Z" />
      <path d="M55 9.6 C75.4 8.1 91.2 10.6 91.8 22.2 C92.7 35.2 91.5 45.2 89.3 50.7 C87.3 55.9 72.8 54.7 59.4 54.5 L45.2 61.7 L52.3 50.5 C50.3 39.4 50.7 21.4 51.8 14.1 C52.2 10.9 53.1 9.8 55 9.6 Z" />
      <path d="M9 20.5 L14.5 43 L20 28 L25.5 43 L31 20" stroke-width="4.6" />
      <path d="M38 28.5 L37.5 43" stroke-width="4.6" />
      <path d="M61 43 L61.5 20 L74 19 M61 30.5 L70.5 30" stroke-width="4.6" />
      <path d="M81.5 28.5 L81 43" stroke-width="4.6" />
      <circle cx="38.5" cy="21.6" r="2.5" fill="currentColor" stroke="none" />
      <circle cx="82" cy="21.6" r="2.5" fill="currentColor" stroke="none" />
      <path d="M5 59 Q48 34 95 6.5" stroke-width="4.8" />
    </svg>
    <span>{labels.worksOffline}</span>
  </OfflineChip>
</div>

<style>
  .trust-chips {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.75rem;
    white-space: nowrap;
  }

  .trust-chip {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    min-height: 1.8rem;
    box-sizing: border-box;
    border: 1px solid var(--color-paper-edge);
    border-radius: var(--radius-pill);
    background: var(--color-paper);
    padding: 0.22rem 0.6rem;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: color 150ms var(--ease-out), border-color 150ms var(--ease-out), background-color 150ms var(--ease-out), box-shadow 150ms var(--ease-out);
  }

  a.trust-chip:hover {
    border-color: var(--color-primary);
    background: color-mix(in srgb, var(--color-primary) 8%, var(--color-paper));
    color: var(--color-primary-text);
  }

  a.trust-chip:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: var(--shadow-focus);
    color: var(--color-primary-text);
  }

  .trust-chip-icon {
    flex: none;
    width: 14px;
    height: 14px;
    display: block;
  }

  /* Taller than the 14px lucide icons beside it: the mark is a wordmark in a
     shape, so it has letters to resolve where they have none. Its 100:64 box
     is what makes this chip wider than the other two. */
  .trust-chip-mark {
    flex: none;
    width: 25px;
    height: 16px;
    display: block;
  }

  @media (max-width: 1023px) {
    .trust-chips {
      justify-content: center;
      gap: 0.3rem;
      font-size: 0.7rem;
    }
    .trust-chip {
      min-height: 1.65rem;
      padding-inline: 0.45rem;
    }
  }

  @media (max-width: 720px) {
    .trust-chips {
      width: auto;
      flex: none;
      gap: 0.25rem;
    }
    /* One 2rem square for every chip, the app bar's on-device badge included
       (AppBar.astro matches it): a row of identical circles rather than three
       circles and one ellipse. The offline chip's mark wants more room than
       this - it is the one element here with letters to resolve, and at 22px
       wide they are near the limit of what resolves at all - but the row
       being uniform is what the bar is judged on, and 2rem is the widest box
       the three lucide icons can justify. It also buys back breadcrumb:
       measured on /merge/ at 360px, 57.7px of tool name against the old
       mixed row's 42.1px. */
    .trust-chip {
      width: 2rem;
      min-height: 2rem;
      justify-content: center;
      gap: 0;
      padding: 0.25rem;
    }
    /* The aria-labels keep each chip's accessible name while its visual text
       yields to the icon at phone widths. */
    .trust-chip span {
      display: none;
    }
    /* The mark fills the 2rem square's content box (32 - 2x0.25rem - 2x1px);
       height follows from its own 100:64 box. The 0.25rem padding is what
       keeps it at 22px rather than the 0.4rem the labelled chips carry. */
    .trust-chip-mark {
      width: 22px;
      height: 14px;
    }
  }
</style>
