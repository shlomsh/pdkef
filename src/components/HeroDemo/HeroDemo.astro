---
/** The production Sign and Redact stories, with build-time rendered copy.
 * ScrollDriver plays their shared timeline when this panel is on screen and
 * maps page scroll onto the same beat map for optional manual control. Both
 * stages occupy the same demo space; without JavaScript each is a completed
 * still.
 */
import ScrollDriver from './ScrollDriver';
import styles from './HeroDemo.module.css';
import { getHeroDemoMessages } from '../../i18n/heroDemoMessages';

interface Props {
  dir?: 'ltr' | 'rtl';
  locale?: string;
}
const { dir = 'ltr', locale = 'en' } = Astro.props;
const isRtl = dir === 'rtl';

const rootSelector = `.${styles.root}`;

// LOC-16 translates the demo through src/i18n/heroDemoMessages.ts (every
// sr-only narration, simulated phone-screen string, and chat bubble is a
// catalogue lookup keyed by `locale`, not a hardcoded literal). The panel
// motion itself stays a physical translateX() slide either way; LOC-16
// settled the open "does it mirror under RTL" question as "mirror" -
// HeroDemo.module.css's `--hero-dir` custom property flips the slide's sign
// under `html[dir="rtl"]`, so the story still reads start-to-end for a
// right-to-left reader instead of visually reversing. The two caption
// headlines and their arrows were a narrower, already-decided case before
// LOC-16: they are short, sit outside the fixed-pixel phone-screen overlay,
// and the arrow literally points at the phone, which *does* move sides
// under RTL (the grid mirrors for free, see HomePageLayout.astro/
// home-page.md section 4.3), so leaving the arrow pointing right on a page
// where the phone is now on the left would be wrong regardless of language.
const captionArrowClass = isRtl ? `${styles['caption-arrow']} ${styles['caption-arrow-rtl']}` : styles['caption-arrow'];
const captionClass = isRtl ? `type-section ${styles.caption} ${styles['caption-hebrew']}` : `type-section ${styles.caption}`;
const t = getHeroDemoMessages(locale);
// File names keep their extension on the visual right in the Hebrew edition.
// Plain bidi puts a Hebrew name's ".pdf" on the visual left (the standard
// rendering, and what a Hebrew-UI phone shows), but Shlomi judged it on the
// built page (2026-09-12) and wants the extension where an English reader
// expects it, so every file name sits in an LTR-isolated <bdi>. English gets
// a bare <bdi> (dir undefined renders no attribute), so its HTML only gains
// the wrapper element, never a direction.
const fileNameDir = isRtl ? 'ltr' : undefined;
const signCaption = t.signCaption;
const blurCaption = t.blurCaption;
const scrollHint = t.scrollHint;
---

<section class={styles.root} data-home-demo aria-label={t.ariaLabel}>
  {/* HeroDemo.module.css's .stage now defaults every --p-* beat to the value
      ScrollDriver.tsx actually writes at scroll position 0 on mount, so a
      JS-enabled visitor (including reduced motion) sees no reset-to-start
      flash on hydration - see the comment above those declarations. A true
      no-JS visitor never runs that driver at all, so without this block they
      would be stuck looking at the empty start frame forever. This restores
      the finished, plainly-visible story for that audience only, applied at
      first paint (no hydration timing to race) and scoped to the same
      [data-hero-stage] hook, never the CSS-Modules-hashed .stage class.

      An external stylesheet, not an inline <style>: Astro's compiler treats
      <noscript> content as opaque raw text and never scopes or CSP-hashes a
      <style> written directly inside it, so an inline block here ships as a
      literal unhashed style and fails the build's CSP check outright (proven
      by trying it first). public/hero-demo-noscript.css's own header has the
      full explanation; styleDirective already allows 'self', so this needs
      no hash and cannot go stale the way a hand-computed one would. */}
  <noscript>
    <link rel="stylesheet" href="/hero-demo-noscript.css" />
  </noscript>
  <ScrollDriver client:load rootSelector={rootSelector} />
  <div class={styles.track} data-hero-track="sign">
    <p class="sr-only">{t.signSrOnly}</p>
    <div class={styles.stage} data-hero-stage>
      <h2 class={captionClass}>
        <svg class={captionArrowClass} viewBox="0 0 150 46" aria-hidden="true" focusable="false">
          <path d="M3 36C36 8 88 5 133 26"></path>
          <path d="M121 13L134 26L117 32"></path>
        </svg>
        <span class={styles['caption-copy']}>{signCaption.before}<span class={styles['caption-marker']}>{signCaption.marker}</span>{signCaption.after}<br />{signCaption.line2}</span>
        <span class={styles['scroll-hint']} aria-hidden="true"><span>{scrollHint.line1}<br />{scrollHint.line2}</span></span>
      </h2>
      <div class={styles['progress-rail']} aria-hidden="true">
        <span class={`${styles['progress-seg']} ${styles['progress-seg-current']}`}></span>
        <span class={`${styles['progress-seg']} ${styles['progress-seg-pending']}`}></span>
      </div>
      <div class={styles.phone} aria-hidden="true">
        <div class={styles.screen}>
          <div class={styles['status-bar']}>
            <span>9:41</span>
            <span class={styles['status-icons']}>
              <svg class={styles['icon-airplane']} viewBox="0 0 24 24" focusable="false">
                <path
                  fill="currentColor"
                  d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2.5 2v1.5l3.5-1 3.5 1V21l-2.5-2v-5.5z"
                />
              </svg>
              <svg class={styles['icon-battery']} viewBox="0 0 24 12" focusable="false">
                <rect x="1" y="1" width="19" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" />
                <rect x="21" y="4" width="2" height="4" rx="1" fill="currentColor" />
                <rect x="3" y="3" width="14" height="6" rx="1" fill="currentColor" />
              </svg>
            </span>
          </div>
          <div class={styles.layers}>
            <div class={`${styles.layer} ${styles['chat-layer']} ${styles['layer-final']}`}>
              <div class={styles['panel-head']}>{t.signChatHead}</div>
              <div class={styles.chat}>
                <div class={`${styles.bubble} ${styles['bubble-in']} ${styles['anim-msg']}`}>
                  <p class={styles['bubble-text']}>{t.signChatMessage}</p>
                </div>
                <div class={`${styles.bubble} ${styles['bubble-in']} ${styles['bubble-file']} ${styles['anim-msg']}`}>
                  <span class={styles['tap-ring']} aria-hidden="true"></span>
                  <svg class={styles['pdf-icon']} viewBox="0 0 24 28" focusable="false">
                    <path class={styles['pdf-body']} d="M3 1h13l5 5v20a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" />
                    <path class={styles['pdf-fold']} d="M16 1v5h5" />
                    <rect class={styles['pdf-tag']} x="3" y="16" width="15" height="7" rx="1.5" />
                    <text class={styles['pdf-tag-text']} x="10.5" y="21.2" text-anchor="middle">PDF</text>
                  </svg>
                  <span class={styles['file-meta']}>
                    <span class={styles['file-name']}><bdi dir={fileNameDir}>{t.signFileName}</bdi></span>
                    <span class={styles['file-size']}>{t.signFileSize}</span>
                  </span>
                </div>
                <div class={`${styles.bubble} ${styles['bubble-out']} ${styles['anim-send']}`}>
                  <svg class={styles['pdf-icon']} viewBox="0 0 24 28" focusable="false">
                    <path class={styles['pdf-body']} d="M3 1h13l5 5v20a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" />
                    <path class={styles['pdf-fold']} d="M16 1v5h5" />
                    <rect class={styles['pdf-tag']} x="3" y="16" width="15" height="7" rx="1.5" />
                    <text class={styles['pdf-tag-text']} x="10.5" y="21.2" text-anchor="middle">PDF</text>
                  </svg>
                  <span class={styles['file-meta']}>
                    <span class={styles['file-name']}><bdi dir={fileNameDir}>{t.signFileName}</bdi></span>
                    <span class={`${styles['file-status']} ${styles['anim-sent']}`} data-hero-sent>{t.signSentLabel}</span>
                  </span>
                </div>
              </div>
            </div>

            <div class={`${styles.layer} ${styles['form-layer']}`}>
              <div class={styles['panel-head']}><bdi dir={fileNameDir}>{t.signFileName}</bdi></div>
              <div class={styles['tool-chips']} aria-hidden="true">
                <span class={`${styles['tool-chip']} ${styles['tool-chip-text']}`}>{t.signToolChipText}</span>
                <span class={`${styles['tool-chip']} ${styles['tool-chip-symbols']}`}>{t.signToolChipSymbols}</span>
                <span class={`${styles['tool-chip']} ${styles['tool-chip-sign']}`}>{t.signToolChipSign}</span>
              </div>
              <div class={styles['doc-body']}>
                <div class={styles['doc-heading']}>{t.signFormHeading}</div>
                <p class={styles['trip-sentence']}>
                  {t.signTripSentence}
                </p>
                <div class={styles['parent-fields']}>
                  <div class={styles['field-row']}>
                    <span class={styles['field-label']}>{t.signFieldStudentLabel}</span>
                    <span class={styles['blank-wrap']}
                      ><span class={`${styles['blank-value']} ${styles['blank-value-name']}`}>{t.signFieldStudentValue}</span></span
                    >
                  </div>
                  <div class={styles['field-row']}>
                    <span class={styles['field-label']}>{t.signFieldParentLabel}</span>
                    <span class={styles['blank-wrap']}
                      ><span class={`${styles['blank-value']} ${styles['blank-value-guardian']}`}>{t.signFieldParentValue}</span
                      ></span
                    >
                  </div>
                  <div class={styles['field-row']}>
                    <span class={styles['field-label']}>{t.signFieldEmergencyLabel}</span>
                    <span class={styles['blank-wrap']}
                      ><span class={`${styles['blank-value']} ${styles['blank-value-phone']}`}>{t.signFieldEmergencyValue}</span
                      ></span
                    >
                  </div>
                  <div class={styles['field-row']}>
                    <span class={styles['field-label']}>{t.signFieldAllergiesLabel}</span>
                    <span class={styles['blank-wrap']}
                      ><span class={`${styles['blank-value']} ${styles['blank-value-allergies']}`}>{t.signFieldAllergiesValue}</span
                      ></span
                    >
                  </div>
                </div>
                <div class={styles.checks}>
                  <div class={styles.check}>
                    <span class={styles['check-box-1']}
                      ><svg class={styles['check-mark-1']} viewBox="0 0 18 18" focusable="false"
                        ><path pathLength="1" d="M3 9 L7.5 13.5 L15 4.5"></path></svg
                      ></span
                    >
                    <span class={styles['check-label']}>{t.signCheckAttendLabel}</span>
                  </div>
                  <div class={styles.check}>
                    <span class={styles['check-box-2']}
                      ><svg class={styles['check-mark-2']} viewBox="0 0 18 18" focusable="false"
                        ><path pathLength="1" d="M3 9 L7.5 13.5 L15 4.5"></path></svg
                      ></span
                    >
                    <span class={styles['check-label']}>{t.signCheckPhotoLabel}</span>
                  </div>
                </div>
                <p class={styles['confirm-line']}>{t.signConfirmLine}</p>
                <div class={styles['sig-line']}>
                  <span class={styles['sig-label']}>{t.signSigLabel}</span>
                  <svg class={styles.sig} viewBox="0 0 220 70" preserveAspectRatio="none" focusable="false">
                    <path
                      pathLength="1"
                      d="M8,50 C14,20 20,15 26,35 C30,50 34,55 38,40 C40,25 46,18 50,30 C54,45 55,52 60,45 L66,20 C70,10 74,10 76,20 L80,45 C84,55 90,55 92,40 C96,20 100,15 104,25 C108,38 112,45 118,35 C124,22 130,18 136,28 C142,42 148,48 156,38 C162,30 168,26 176,32 C184,40 192,44 204,30"
                    ></path>
                  </svg>
                </div>
                <div class={styles['date-line']}>
                  <span class={styles['date-line-label']}>{t.signDateLabel}</span>
                  <span class={styles['date-line-value']}>{t.signDateValue}</span>
                </div>
              </div>
            </div>

            <div class={`${styles.layer} ${styles['share-layer']}`}>
              <div class={styles['share-scrim']} aria-hidden="true"></div>
              <div class={styles['share-sheet']}>
                <div class={styles['share-handle']} aria-hidden="true"></div>
                <div class={styles['tool-chips']} aria-hidden="true">
                  <span class={`${styles['tool-chip']} ${styles['tool-chip-share']}`}>{t.signToolChipShare}</span>
                </div>
                <div class={styles['share-file-row']}>
                  <svg class={styles['pdf-icon']} viewBox="0 0 24 28" focusable="false">
                    <path class={styles['pdf-body']} d="M3 1h13l5 5v20a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1z" />
                    <path class={styles['pdf-fold']} d="M16 1v5h5" />
                    <rect class={styles['pdf-tag']} x="3" y="16" width="15" height="7" rx="1.5" />
                    <text class={styles['pdf-tag-text']} x="10.5" y="21.2" text-anchor="middle">PDF</text>
                  </svg>
                  <span class={styles['file-meta']}>
                    <span class={styles['file-name']}><bdi dir={fileNameDir}>{t.signFileName}</bdi></span>
                    <span class={styles['file-size']}>{t.signFileSizeSigned}</span>
                  </span>
                </div>
                <div class={styles['share-targets']}>
                  <span class={styles['share-target']}>
                    <span class={styles['share-target-icon']} aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <path
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 5h16v10H9l-4 4V5z"
                        ></path>
                      </svg>
                    </span>
                    <span>{t.signShareMessages}</span>
                  </span>
                  <span class={styles['share-target']}>
                    <span class={styles['share-target-icon']} aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <rect x="4" y="6" width="16" height="12" rx="2" fill="none" stroke="currentColor" stroke-width="1.6"
                        ></rect>
                        <path
                          fill="none"
                          stroke="currentColor"
                          stroke-width="1.6"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                          d="M4 7l8 6 8-6"
                        ></path>
                      </svg>
                    </span>
                    <span>{t.signShareMail}</span>
                  </span>
                  <span class={styles['share-target']}>
                    <span class={styles['share-target-icon']} aria-hidden="true">
                      <svg viewBox="0 0 24 24" focusable="false">
                        <circle cx="6" cy="12" r="1.6" fill="currentColor"></circle>
                        <circle cx="12" cy="12" r="1.6" fill="currentColor"></circle>
                        <circle cx="18" cy="12" r="1.6" fill="currentColor"></circle>
                      </svg>
                    </span>
                    <span>{t.signShareMore}</span>
                  </span>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>


  <div class={styles.track} data-hero-track="blur">
    <p class="sr-only">{t.blurSrOnly}</p>
    <div class={styles.stage} data-hero-stage>
      <h2 class={captionClass}>
        <svg class={captionArrowClass} viewBox="0 0 150 46" aria-hidden="true" focusable="false">
          <path d="M3 36C36 8 88 5 133 26"></path>
          <path d="M121 13L134 26L117 32"></path>
        </svg>
        <span class={styles['caption-copy']}>{blurCaption.before}<span class={styles['caption-marker']}>{blurCaption.marker}</span>{blurCaption.after}<br />{blurCaption.line2}</span>
        <span class={styles['scroll-hint']} aria-hidden="true"><span>{scrollHint.line1}<br />{scrollHint.line2}</span></span>
      </h2>
      <div class={styles['progress-rail']} aria-hidden="true">
        <span class={`${styles['progress-seg']} ${styles['progress-seg-done']}`}></span>
        <span class={`${styles['progress-seg']} ${styles['progress-seg-current']}`}></span>
      </div>
      <div class={styles.phone} aria-hidden="true">
        <div class={styles.screen}>
          <div class={styles['status-bar']}>
            <span>9:41</span>
            <span class={styles['status-icons']}>
              <svg class={styles['icon-airplane']} viewBox="0 0 24 24" focusable="false">
                <path
                  fill="currentColor"
                  d="M21 16v-2l-8-5V3.5a1.5 1.5 0 0 0-3 0V9l-8 5v2l8-2.5V19l-2.5 2v1.5l3.5-1 3.5 1V21l-2.5-2v-5.5z"
                />
              </svg>
              <svg class={styles['icon-battery']} viewBox="0 0 24 12" focusable="false">
                <rect x="1" y="1" width="19" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="1.2" />
                <rect x="21" y="4" width="2" height="4" rx="1" fill="currentColor" />
                <rect x="3" y="3" width="14" height="6" rx="1" fill="currentColor" />
              </svg>
            </span>
          </div>
          <div class={styles.layers}>
            <div class={`${styles.layer} ${styles['email-layer']}`}>
              <div class={styles['mail-head']}>
                <span class={styles['mail-title']}>{t.blurMailHead}</span>
                <span class={styles['mail-count']}>2</span>
              </div>
              {/* The new message occupies no height until it arrives, so the
                  message already in the inbox is pushed down by it rather than
                  being crossfaded past. It used to fade and translate 10px
                  inside a row whose height never changed, which is the one
                  thing a mail app never does - nothing below a new message
                  stays put. See .email-arriving in the stylesheet for why the
                  height is a measured custom property and how to redo it. */}
              <div class={styles['email-arriving']}>
                <div class={`${styles['email-row']} ${styles['email-row-unread']}`}>
                  <span class={styles['unread-dot']} aria-hidden="true"></span>
                  <span class={styles.avatar}>{t.blurAvatarFrontDesk}</span>
                  <span class={styles['email-meta']}>
                    <span class={styles['email-line']}>
                      <span class={styles['email-from']}>{t.blurEmailFromUnread}</span>
                      <span class={styles['email-time']}>{t.blurEmailTimeUnread}</span>
                    </span>
                    <span class={styles['email-subject']}>{t.blurEmailSubjectUnread}</span>
                    <span class={styles['email-preview']}
                      >{t.blurEmailPreviewUnread}</span
                    >
                  </span>
                </div>
              </div>
              <div class={styles['email-row-muted']}>
                <span class={styles.avatar}>{t.blurAvatarTeam}</span>
                <span class={styles['email-meta']}>
                  <span class={styles['email-line']}>
                    <span class={styles['email-from']}>{t.blurEmailFromMuted}</span>
                    <span class={styles['email-time']}>{t.blurEmailTimeMuted}</span>
                  </span>
                  <span class={styles['email-subject']}>{t.blurEmailSubjectMuted}</span>
                </span>
              </div>
            </div>

            <div class={`${styles.layer} ${styles['bill-layer']}`}>
              <div class={styles['panel-head']}><bdi dir={fileNameDir}>{t.blurBillFileName}</bdi></div>
              <div class={styles['tool-chips']} aria-hidden="true">
                <span class={`${styles['tool-chip']} ${styles['tool-chip-blur']}`}>{t.blurToolChipBlur}</span>
                <span class={`${styles['tool-chip']} ${styles['tool-chip-blackout']}`}>{t.blurToolChipBlackout}</span>
                <span class={`${styles['tool-chip']} ${styles['tool-chip-whiteout']}`}>{t.blurToolChipWhiteout}</span>
                <span class={`${styles['tool-chip']} ${styles['tool-chip-delete']}`}>{t.blurToolChipDelete}</span>
              </div>
              <div class={styles['doc-body']}>
                <div class={styles['doc-line']}><span>{t.blurBillAccountHolderLabel}</span><span>{t.blurBillAccountHolderValue}</span></div>
                <div class={styles['doc-line']}><span>{t.blurBillServiceAddressLabel}</span><span>{t.blurBillServiceAddressValue}</span></div>
                <div class={styles['doc-line']}><span>{t.blurBillPeriodLabel}</span><span>{t.blurBillPeriodValue}</span></div>
                <div class={styles['doc-line']}>
                  <span>{t.blurBillCustomerIdLabel}</span>
                  <span class={styles['blur-value']}>{t.blurBillCustomerIdValue}</span>
                </div>
                <div class={styles['doc-line']}>
                  <span>{t.blurBillAccountNoLabel}</span>
                  <span class={styles['redact-wrap']}>
                    <span class={styles['redact-value']}>{t.blurBillAccountNoValue}</span>
                    <span class={styles['blackout-bar']} aria-hidden="true"></span>
                  </span>
                </div>
                <div class={styles['doc-line']}><span>{t.blurBillRatePlanLabel}</span><span>{t.blurBillRatePlanValue}</span></div>
                <div class={styles['doc-line']}>
                  <span>{t.blurBillMeterSerialLabel}</span>
                  <span class={styles['redact-wrap']}>
                    <span class={styles['redact-value']}>{t.blurBillMeterSerialValue}</span>
                    <span class={styles['whiteout-bar']} aria-hidden="true"></span>
                  </span>
                </div>
                <div class={styles['doc-line']}><span>{t.blurBillMeterPriorLabel}</span><span>{t.blurBillMeterPriorValue}</span></div>
                <div class={styles['doc-line']}><span>{t.blurBillMeterCurrentLabel}</span><span>{t.blurBillMeterCurrentValue}</span></div>
                <div class={styles['doc-line']}><span>{t.blurBillUsageLabel}</span><span>{t.blurBillUsageValue}</span></div>
                <div class={styles['doc-line']}>
                  <span class={styles['delete-row-text']}>{t.blurBillLateFeeLabel}</span>
                  <span class={styles['delete-row-text']}>{t.blurBillLateFeeValue}</span>
                </div>
                <div class={styles['doc-line']}><span>{t.blurBillAmountDueLabel}</span><span>{t.blurBillAmountDueValue}</span></div>
                <div class={styles['doc-line']}><span>{t.blurBillDueDateLabel}</span><span>{t.blurBillDueDateValue}</span></div>
              </div>
            </div>

            <div class={`${styles.layer} ${styles['reply-layer']} ${styles['layer-final']}`}>
              <div class={styles['panel-head']}>{t.blurReplyHead}</div>
              <div class={`${styles['reply-body']} ${styles['reply-outgoing']}`}>
                <p class={styles['reply-text']}>{t.blurReplyText}</p>
                <div class={styles['attach-chip']}>
                  <span class={styles['blur-dot']} aria-hidden="true"></span>
                  <span class={styles['attach-name']}><bdi dir={fileNameDir}>{t.blurBillFileName}</bdi></span>
                  <span class={styles['attach-tag']}>{t.blurAttachTag}</span>
                </div>
                <div class={`${styles['send-btn']} ${styles['anim-send']} ${styles['send-press']}`}>{t.blurSendButton}</div>
              </div>
              {/* The reply is sent rather than relabelled: the button presses,
                  the composed message flies up and out, and the confirmation
                  lands after it has gone. See .send-press / .reply-outgoing /
                  .sent-confirm for the ordering. */}
              <div class={styles['sent-confirm']} data-hero-sent>
                <svg class={styles['sent-check']} viewBox="0 0 16 16" aria-hidden="true">
                  <path d="M2.5 8.5l3.5 3.5 7.5-8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {t.blurSentLabel}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>
