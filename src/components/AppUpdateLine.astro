---
// MEM-10: the quiet "a new version is ready" line, in the markup of every page
// and hidden until the coordinator in src/site-lib/appUpdate.ts shows it. Fixed
// at the top so it never takes layout space (no CLS, nothing inserted into the
// home first screen) and never a modal. Strings live here, not in the script.
import { getAppUpdateMessages } from '../i18n/appUpdateMessages';

interface Props {
  lang?: string;
}
const { lang = 'en' } = Astro.props;
const messages = getAppUpdateMessages(lang);
---

<p class="app-update" data-app-update data-app-update-state="ready" role="status" hidden>
  <span class="app-update-ready">{messages.ready}</span>
  <span class="app-update-blocked">{messages.blocked}</span>
  <span class="app-update-waiting">{messages.waiting}</span>
  <span class="app-update-action"><span aria-hidden="true">·</span><button type="button" data-app-update-reload>{messages.reload}</button></span>
</p>

<style>
  /* Just under AppBar (sticky, h-14), never on it: end-aligned with the bar's
     chips, whose padding (px-6, px-8 in a 1280px column) it mirrors, where the
     page below is empty; centred on a phone, where nothing is beside the
     heading. Fixed, so it takes no layout space. */
  .app-update {
    position: fixed;
    inset-block-start: calc(3.5rem + 8px);
    inset-inline-end: 1.5rem;
    max-inline-size: calc(100% - 32px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    column-gap: 0.3rem;
    z-index: 80;
    padding: 0.25rem 0.7rem;
    font-size: 0.8rem;
    line-height: 1.4;
    text-align: center;
    color: var(--color-muted);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
  }
  @media (min-width: 1024px) {
    .app-update {
      inset-inline-end: max(2rem, calc((100% - 1280px) / 2 + 2rem));
    }
  }
  @media (max-width: 560px) {
    .app-update {
      inset-inline: 0;
      margin-inline: auto;
      inline-size: max-content;
    }
  }
  .app-update[hidden] {
    display: none;
  }
  /* One sentence per state; the Reload action in every state but 'waiting'. */
  .app-update:not([data-app-update-state='ready']) .app-update-ready,
  .app-update:not([data-app-update-state='blocked']) .app-update-blocked,
  .app-update:not([data-app-update-state='waiting']) .app-update-waiting,
  .app-update[data-app-update-state='waiting'] .app-update-action {
    display: none;
  }
  .app-update-action {
    display: inline-flex;
    align-items: center;
    column-gap: 0.3rem;
  }
  .app-update button {
    position: relative;
    display: inline-flex;
    align-items: center;
    min-block-size: 28px;
    padding: 0.1rem 0.5rem;
    font: inherit;
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--color-text);
    background: none;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    cursor: pointer;
    text-decoration: none;
  }
  .app-update button::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 50%;
    block-size: 44px;
    transform: translateY(-50%);
  }
  .app-update button:hover {
    background: var(--color-primary-soft);
    border-color: var(--color-primary);
  }
  .app-update button:focus-visible {
    outline-offset: 0;
    border-color: var(--color-primary);
  }
  .app-update button:disabled {
    cursor: default;
    opacity: 0.6;
  }
</style>
