---
/**
 * The same-page language menu: a `<details>` dropdown listing only the
 * editions of THIS page that are published (plus English), each with its flag
 * and native name. It is real anchors inside a native disclosure, so it works
 * with JavaScript off and needs no client bundle; the small bundled script
 * below only closes it on an outside click or Escape, which `<details>` does
 * not do on its own. No IP or Accept-Language redirect anywhere (LOC-02.md).
 *
 * `direction="up"` is for the footer, where the list has to open upward or it
 * would render off the bottom of the page.
 */
import { getDocumentationLocale } from '../i18n/documentationLocales';
import LanguageFlag from './LanguageFlag.astro';

interface Variant {
  locale?: string;
  lang?: string;
  path?: string;
  href?: string;
  label?: string;
  nativeName?: string;
  isCurrent?: boolean;
}
interface Props {
  variants?: Variant[];
  currentLocale?: string;
  label?: string;
  direction?: 'up' | 'down';
  /** QUAL-13: 'inverse' is the closed trigger's look on the footer's teal
   * band. The popover panel itself is unaffected, it keeps its light surface
   * everywhere. */
  tone?: 'default' | 'inverse';
}
const {
  variants = [],
  currentLocale = 'en',
  label = 'Language',
  direction = 'down',
  tone = 'default',
} = Astro.props;
const available = variants
  .filter((variant) => (variant.path ?? variant.href) && (variant.locale ?? variant.lang))
  .map((variant) => {
    const locale = variant.locale ?? variant.lang ?? 'en';
    return {
      locale,
      href: variant.path ?? variant.href ?? '/',
      name: variant.nativeName ?? variant.label ?? getDocumentationLocale(locale)?.nativeName ?? locale,
      current: variant.isCurrent ?? locale === currentLocale,
    };
  });
const current = available.find((variant) => variant.current) ?? available[0];
---

{available.length > 1 && current && (
  <details class="lang-menu relative inline-block text-[0.86rem]" data-direction={direction} data-tone={tone} data-lang-menu>
    <summary class="lang-menu-summary inline-flex cursor-pointer items-center gap-[0.5rem] rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.4rem] font-semibold text-[var(--color-text)]" aria-label={label}>
      <LanguageFlag locale={current.locale} />
      <span lang={current.locale}>{current.name}</span>
      <svg class="lang-menu-chevron text-[var(--color-muted)]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M6 9l6 6 6-6" />
      </svg>
    </summary>
    <ul class="lang-menu-list absolute z-30 m-0 min-w-full list-none rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)] p-1" role="list">
      {available.map((variant) => (
        <li>
          {variant.current ? (
            <span class="flex items-center gap-[0.55rem] whitespace-nowrap rounded-[var(--radius-sm)] px-3 py-2 font-semibold text-[var(--color-muted)]" aria-current="page" lang={variant.locale}>
              <LanguageFlag locale={variant.locale} />
              <span>{variant.name}</span>
            </span>
          ) : (
            <a class="lang-menu-link flex items-center gap-[0.55rem] whitespace-nowrap rounded-[var(--radius-sm)] px-3 py-2 text-[var(--color-text)] no-underline" href={variant.href} lang={variant.locale} hreflang={variant.locale}>
              <LanguageFlag locale={variant.locale} />
              <span>{variant.name}</span>
            </a>
          )}
        </li>
      ))}
    </ul>
  </details>
)}

<script>
  // Close on outside click / Escape. Progressive: without this the menu still
  // opens and closes from its own summary, it just stays open until toggled.
  for (const menu of document.querySelectorAll<HTMLDetailsElement>('[data-lang-menu]')) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    menu.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
  }
</script>

<style>
  /* Only what utilities cannot say. Everything else is utility classes already
     compiled for the app bar, because Astro inlines a component's styles on
     every page that imports it, rendered or not - the six tool pages with no
     second edition would otherwise pay for a menu they never show
     (check-css-duplication.js's dead-bytes ratchet). */
  .lang-menu-summary { list-style: none; }
  .lang-menu-summary::-webkit-details-marker { display: none; }
  .lang-menu-summary:focus-visible { outline: none; border-color: var(--color-primary); box-shadow: var(--shadow-focus); }
  /* QUAL-13: the footer's teal band recolours only the closed trigger. The
     popover panel below keeps its light surface and normal text colours.
     It also sits alone under the credit line with only two editions behind
     it, so it reads as a compact utility control rather than a second CTA. */
  .lang-menu[data-tone='inverse'] .lang-menu-summary {
    background: transparent;
    border-color: color-mix(in srgb, var(--color-surface) 40%, transparent);
    color: var(--color-surface);
    padding: 0.3rem 0.65rem;
    gap: 0.4rem;
    font-size: 0.78rem;
    font-weight: 500;
  }
  .lang-menu[data-tone='inverse'] .lang-menu-summary .lang-menu-chevron { color: var(--color-surface); }
  .lang-menu[data-tone='inverse'] .lang-menu-summary:hover {
    background: color-mix(in srgb, var(--color-surface) 12%, transparent);
  }
  .lang-menu[data-tone='inverse'] .lang-menu-summary:focus-visible {
    border-color: var(--color-surface);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--color-surface) 55%, transparent);
  }
  .lang-menu[open] .lang-menu-chevron { transform: rotate(180deg); }
  .lang-menu-list { inset-inline-start: 0; box-shadow: var(--shadow-lg); }
  .lang-menu[data-direction='down'] .lang-menu-list { top: calc(100% + .35rem); }
  .lang-menu[data-direction='up'] .lang-menu-list { bottom: calc(100% + .35rem); }
  .lang-menu-link:hover { background: var(--color-primary-soft); color: var(--color-primary-text); }
  .lang-menu-link:focus-visible { background: var(--color-primary-soft); }
</style>
