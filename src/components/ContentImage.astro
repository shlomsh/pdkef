---
import { renderInline } from '../lib/contentMarkup';

interface Props {
  src: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
}

const { src, alt, width, height, caption } = Astro.props;
---

<figure>
  <a href={src} aria-label={`Open full-size image: ${alt}`}>
    <img src={src} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
  </a>
  <figcaption set:html={renderInline(caption, 'muted')} />
</figure>

<style>
  figure { margin: 0 0 1.5rem; }
  figure:last-child { margin-bottom: 0; }
  a { display: block; border-radius: var(--radius-md); }
  a:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 4px; }
  img {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: auto;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface);
  }
  figcaption { margin-top: 0.75rem; font-size: 0.9rem; line-height: 1.6; color: var(--color-muted); }
</style>
