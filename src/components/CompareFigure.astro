---
// A static before/after split image (SEO-31), the non-interactive sibling of
// CompareSlider.tsx (src/tools/compress/CompareSlider.module.css): that component
// is a Preact island driven by a drag gesture, which is right for a tool demo
// but wrong for a content page - the SEO surface ships zero JS (CLAUDE.md).
// This renders a fixed 50/50 split with plain CSS: the after image is clipped
// to its right half with a static `clip-path`, no script, no state. With
// `wipe`, a CSS animation sweeps the split across instead (compareFigure.css).
//
// Colours borrow CompareSlider's look (the tag pills, the handle) but read
// only :root tokens from global.css, never its literals - that file's
// rgba()/hex values are fine for a runtime-driven island but would be a
// literal-color regression here.
import { renderInline } from '../site-lib/contentMarkup';
import { compareFigureStyle } from '../site-lib/inlineStyles';
// The figure's CSS is a string, not a stylesheet in the module graph (see
// compareFigure.css): emitted below as <style is:inline>, so only a page that
// renders the figure carries it. Its CSP hash is registered by the route that
// renders the page, not here (site-lib/inlineStyles.ts says why).

interface Props {
  beforeSrc: string;
  afterSrc: string;
  beforeLabel: string;
  afterLabel: string;
  alt: string;
  width: number;
  height: number;
  caption: string;
  wipe?: boolean;
}

const { beforeSrc, afterSrc, beforeLabel, afterLabel, alt, width, height, caption, wipe = false } = Astro.props;
---

<style is:inline set:html={compareFigureStyle}></style>
<figure class:list={['compare-figure', { 'compare-figure-wipe': wipe }]}>
  <div class="compare-figure-box">
    <img class="compare-figure-image" src={beforeSrc} alt={alt} width={width} height={height} loading="lazy" decoding="async" />
    <img class="compare-figure-image compare-figure-after" src={afterSrc} alt="" aria-hidden="true" width={width} height={height} loading="lazy" decoding="async" />
    <div class="compare-figure-rule" aria-hidden="true"></div>
    <span class="compare-figure-tag compare-figure-tag-before">{beforeLabel}</span>
    <span class="compare-figure-tag compare-figure-tag-after">{afterLabel}</span>
  </div>
  <figcaption class="compare-figure-caption" set:html={renderInline(caption, 'muted')} />
</figure>

