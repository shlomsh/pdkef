---
// Cross-tool links, rendered on every tool page from the shared registry
// (src/data/tools.js) with the current tool filtered out. Build-time rendered
// like the rest of the SEO surface, so crawlers see real <a href> links
// without executing any JS.
//
// Why this exists: before it, AppBar linked only to "/" and Footer only to
// GitHub + /licenses/, so every tool page carried exactly one inbound internal
// link (the home page grid) and no tool page linked to any other. The newer
// routes had almost no internal signal as a result. Anchor text is the
// registry's gridTitle, so it stays descriptive rather than "click here".
//
// Deliberately not a <FeatureCard>: that lays out at min-h-[calc(100vh-6rem)]
// on desktop, and a third near-full-viewport panel below the how-it-works and
// FAQ cards would bury the footer. This is a compact strip.
import { tools } from '../data/tools.js';
import type { CrossLinksMessages } from '../i18n/documentationMessages';
import { getToolCardCopy } from '../i18n/cardMessages';
import { documentationPath } from '../i18n/documentationLocales';

interface Props {
  currentSlug: string;
  labels?: CrossLinksMessages & { inEnglish?: string };
  /** The page's locale, and the site paths of every page published in it
   * (src/i18n/localizedTools.ts getPublishedEditionPaths). A card links to
   * the localized edition when there is one, otherwise to the English page
   * with `labels.inEnglish` said out loud - never to a URL that 404s. */
  locale?: string;
  editionPaths?: readonly string[];
}

const { currentSlug, labels, locale = 'en', editionPaths = [] } = Astro.props;
const published = new Set(editionPaths);
const cardFor = (tool: { slug: string; href: string; gridTitle: string; gridDescription: string }) => {
  const copy = getToolCardCopy(locale, tool.slug);
  const localizedHref = locale === 'en' ? tool.href : documentationPath(tool.slug, locale as any);
  const href = published.has(localizedHref) ? localizedHref : tool.href;
  return {
    href,
    title: copy?.title ?? tool.gridTitle,
    description: copy?.description ?? tool.gridDescription,
    english: locale !== 'en' && href === tool.href,
  };
};
const others = tools.filter((tool) => tool.slug !== currentSlug);
---

<section
  class="mx-auto mb-16 w-full max-w-[1080px] px-6 min-[768px]:mb-24"
  aria-labelledby="more-tools-heading"
>
  <div class="space-heading-content text-center">
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary-text)]">{labels?.crossLinksKicker ?? 'Same suite'}</span>
    <h2 id="more-tools-heading" class="type-section m-0 text-[var(--color-text)]">{labels?.crossLinksHeading ?? 'More PDF tools'}</h2>
    <p class="type-body mx-auto mt-3 mb-0 max-w-[46rem] text-[var(--color-muted)]">
      {labels?.crossLinksSubhead ?? "Every one of these runs on your device, free, with nothing uploaded."}
    </p>
  </div>

  <ul class="space-layout-gap m-0 grid list-none grid-cols-3 p-0 max-[768px]:grid-cols-2 max-[560px]:grid-cols-1">
    {others.map((tool) => {
      const card = cardFor(tool);
      return (
      <li class="m-0 p-0">
        <a
          href={card.href}
          hreflang={card.english ? 'en' : undefined}
          class="group flex h-full items-start gap-3 rounded-[var(--radius-lg)] border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-inherit no-underline transition-[transform,border-color,color] duration-150 ease-out hover:-translate-y-px hover:border-[var(--color-border-strong)] focus-visible:-translate-y-px focus-visible:border-[var(--color-border-strong)]"
        >
          <span class="flex size-10 shrink-0 items-center justify-center rounded-[var(--radius-md)] bg-[var(--color-primary-soft)] text-[var(--color-primary-text)] [&_svg]:block [&_svg]:size-[55%]">
            <tool.icon strokeWidth={1.5} />
          </span>
          <span class="min-w-0">
            <span class="type-card block text-[var(--color-text)]">
              {card.title}
              {card.english && labels?.inEnglish && (
                <span class="ms-2 inline-block align-middle text-[0.7rem] font-semibold uppercase text-[var(--color-muted)]" lang="en" title={labels.inEnglish}>EN</span>
              )}
            </span>
            <span class="type-body mt-1 block text-[var(--color-muted)]">{card.description}</span>
          </span>
        </a>
      </li>
      );
    })}
  </ul>
</section>
