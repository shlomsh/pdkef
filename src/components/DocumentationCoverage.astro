---
import { documentationCountries } from '../data/documentationCountries';
import { documentationLocales } from '../data/documentationLocales';
import { getDocumentationVariants } from '../lib/documentation';
import { contentPages } from '../data/contentPages.js';

const variants = await getDocumentationVariants();
const editions = documentationLocales.map((locale) => {
  const articles = variants.filter((variant) => variant.locale === locale.id);
  return {
    ...locale,
    articles,
    status: articles.some((article) => !article.preview)
      ? 'Guides available'
      : articles.length ? 'Translation preview' : 'Planned; use English',
  };
});
const available = editions.filter((edition) => edition.articles.length);
const editionById = new Map(editions.map((edition) => [edition.id, edition]));
---

<section class="documentation-coverage" aria-labelledby="documentation-coverage-heading">
  <h2 id="documentation-coverage-heading">Find help for your device and language</h2>
  <p>
    Read the Android, iPhone, computer, installation, and other guides in an available language.
    The editor controls stay in English. Help language is separate from the PDF text and font
    support explained below.
  </p>
  <p class="documentation-link-note">Guides open in a new tab, keeping this editor open.</p>

  <div class="documentation-editions">
    {available.map((edition) => (
      <details>
        <summary>
          <bdi lang={edition.id}>{edition.nativeName}</bdi>
          <span>{edition.status}</span>
        </summary>
        <ul>
          {edition.articles.map((article) => {
            const page = contentPages.find((entry) => entry.href === `/${article.pageId}/`);
            return (
              <li>
                <a href={article.path} target="_blank" rel="noopener noreferrer" hreflang={edition.id}>
                  {page?.label ?? article.pageId}
                  {article.preview && <span> (preview)</span>}
                </a>
              </li>
            );
          })}
        </ul>
      </details>
    ))}
  </div>

  <details class="documentation-countries">
    <summary>Countries and documentation languages</summary>
    <p>
      These are the countries represented in our audience and the help languages planned for them.
      You can choose any available language wherever you live. This is not a complete list of the
      languages spoken in each country, or a statement about legal acceptance of signatures.
      English is the fallback while a translation is being prepared.
    </p>
    <div class="documentation-table-scroll" role="region" aria-label="Country and language reference" tabindex="0">
      <table>
        <caption>Documentation availability, separate from PDF language support</caption>
        <thead><tr><th scope="col">Country</th><th scope="col">Help languages</th></tr></thead>
        <tbody>
          {documentationCountries.map((country) => (
            <tr data-country={country.code}>
              <th scope="row">{country.name}</th>
              <td>
                <ul>
                  {country.locales.map((id) => {
                    const edition = editionById.get(id)!;
                    return <li><bdi lang={id}>{edition.nativeName}</bdi>: {edition.status}</li>;
                  })}
                </ul>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>
</section>

<style>
  .documentation-coverage {
    width: calc(100% - 2rem);
    max-width: 1080px;
    margin: 2rem auto;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
    color: var(--color-text);
  }
  h2 { margin: 0 0 0.75rem; font-size: 1.4rem; }
  p { max-width: 75ch; line-height: 1.65; }
  .documentation-link-note { color: var(--color-muted); font-size: 0.9rem; }
  .documentation-editions { display: flex; flex-wrap: wrap; align-items: start; gap: 0.75rem; }
  .documentation-editions details { flex: 1 1 18rem; border: 1px solid var(--color-border); border-radius: var(--radius-md); }
  summary { cursor: pointer; padding: 0.8rem; min-height: 44px; font-weight: 600; }
  summary span { margin-inline-start: 0.75rem; color: var(--color-muted); font-size: 0.85rem; font-weight: 400; }
  ul { padding-inline-start: 1.5rem; padding-inline-end: 0.75rem; line-height: 1.8; }
  a { color: var(--color-primary); text-underline-offset: 0.18em; }
  a:hover { text-decoration-thickness: 2px; }
  .documentation-countries { margin-block-start: 1rem; }
  .documentation-countries > summary { padding-inline: 0; }
  .documentation-table-scroll { overflow-x: auto; }
  table { width: 100%; border-collapse: collapse; font-size: 0.95rem; }
  caption { text-align: start; color: var(--color-muted); padding-block: 0.5rem; }
  th, td { text-align: start; vertical-align: top; padding: 0.75rem; border-bottom: 1px solid var(--color-border); }
  td ul { margin: 0; }
  :is(a, summary, .documentation-table-scroll):focus-visible { outline: 2px solid var(--color-primary); outline-offset: 3px; }
  @media (max-width: 560px) {
    .documentation-coverage { padding: 1rem; }
    th, td { padding: 0.5rem; }
    summary span { display: block; margin-inline-start: 0; }
  }
</style>
