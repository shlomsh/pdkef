---
// Reusable FAQ content card for tool pages. Takes the same `faq` array a
// page already passes to <SeoSchema faq={...} />, so the visible FAQ and the
// FAQPage JSON-LD are always the same source - no separate copy to drift.
import FeatureCard from './FeatureCard.astro';
import CardDecor from './CardDecor.astro';
import { HelpCircle } from 'lucide-preact';

interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faq: FaqItem[];
  icon?: any;
  tag?: string;
  heading?: string;
  sketch?: 'arcs' | 'waves' | 'rings' | 'grid';
  iconPos?: 'tr' | 'tl' | 'br' | 'bl' | 'cr' | 'cl';
  labels?: { tag?: string; heading?: string };
}

const {
  faq,
  icon = HelpCircle,
  tag,
  heading,
  sketch = 'rings',
  iconPos = 'br',
} = Astro.props;
const faqTag = tag ?? Astro.props.labels?.tag ?? 'Got questions?';
const faqHeading = heading ?? Astro.props.labels?.heading ?? 'Frequently asked questions';
---

<FeatureCard class="relative isolate mb-16 overflow-hidden min-[768px]:mb-24">
  <CardDecor sketch={sketch} icon={icon} iconPos={iconPos} iconSize={240} />
  <div class="space-heading-content text-center">
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">{faqTag}</span>
    <h2 class="type-section m-0 text-[var(--color-text)]">{faqHeading}</h2>
  </div>
  <div class="space-layout-gap grid grid-cols-2 gap-x-12 max-[768px]:grid-cols-1">
    {faq.map((item) => (
      <div class="faq-item">
        <h3 class="type-card mb-2 mt-0 text-[var(--color-text)]">{item.question}</h3>
        <p class="type-body m-0 text-[var(--color-muted)]">{item.answer}</p>
      </div>
    ))}
  </div>
</FeatureCard>
