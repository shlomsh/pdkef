---
// Shared app bar for every page, home and tool alike - one toolbar, one
// geometry. On tool pages the brand link doubles as a back-to-home link and
// reveals a back arrow on hover; the optional breadcrumb next to it is a nav
// label, NOT the page <h1>. Right side carries a quiet "on-device" privacy
// badge. Pure inline SVG, no script, so it adds no CSP surface. Uses a logo
// square + wordmark for the brand pill.
//
// The logo goes through astro:assets rather than a public/ path. It used to be
// <img src="/favicon.png">, which shipped the 512x512, 150KB master to every
// page in the site in order to paint a 24px square. Astro resizes it at build
// time and `densities` emits the 2x variant for retina, so the pill costs ~2KB
// instead. eager + sync decoding because this sits in the sticky bar at the top
// of every page: astro:assets defaults to loading="lazy", which would defer the
// one image that is always above the fold.
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';
import type { AppBarMessages } from '../i18n/documentationMessages';

interface Props {
  toolName?: string;
  isHome?: boolean;
  labels?: AppBarMessages;
}
const { toolName, isHome = false, labels = {} as AppBarMessages } = Astro.props;

// One toolbar geometry and one brand-pill style for every page - home and
// tool alike - so the only thing that differs page-to-page is the
// breadcrumb slotted in below. Previously tool pages ran a narrower 1400px
// bar with a bordered "back" pill and a smaller logo/wordmark than home's
// plain 1280px one; that made the trust chips sit visibly closer to the
// viewport edge than on home (measured ~80px vs ~148px of right-side margin
// at a 1512px viewport) and gave every tool page a second, slightly
// different-looking header instead of the same one. The hover-reveal back
// arrow stays tool-pages-only (home has nowhere to "go back" to) but is
// invisible at rest, so it doesn't change the at-rest look this unifies.
// (Dropping the pill also drops its ps-/pe- logical padding - there's no
// longer a bordered box to pad, so nothing here is RTL-direction-sensitive.)
const brandClasses = 'group inline-flex items-center gap-[0.55rem] text-[var(--color-text)] no-underline';
---

<div data-home-bar={isHome || undefined} class="sticky top-0 z-20 border-b-[0.5px] border-[var(--color-border)] bg-[color-mix(in_srgb,var(--color-surface)_86%,transparent)] backdrop-blur-[10px] backdrop-saturate-[1.2]">
  <div class="mx-auto flex h-14 max-w-[1280px] items-center gap-[0.85rem] px-6 max-[560px]:gap-[0.55rem] max-[560px]:px-4 min-[1024px]:px-8">
    <a href="/" class={brandClasses} aria-label={isHome ? 'PDkef homepage' : (labels.homeAriaLabel ?? 'PDkef home, all tools')}>
      {!isHome && (
        <span class="inline-flex w-0 items-center overflow-hidden text-[var(--color-muted-light)] opacity-0 transition-[width,opacity] duration-[180ms] ease-out group-hover:w-4 group-hover:opacity-100" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 12H5" /><path d="M12 19l-7-7 7-7" />
          </svg>
        </span>
      )}
      <Image src={logo} width={32} height={32} densities={[1, 2]} loading="eager" decoding="sync" alt="" aria-hidden="true" class="block shrink-0 rounded-md" />
      <span class="text-[1.1rem] font-bold">PDkef</span>
    </a>

    {toolName && (
      <span class="inline-flex min-w-0 items-center gap-[0.35rem] text-[0.85rem] font-semibold text-[var(--color-muted)]">
        <svg class="shrink-0 text-[var(--color-muted-light)]" width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M9 18l6-6-6-6" />
        </svg>
        <span class="overflow-hidden text-ellipsis whitespace-nowrap">{toolName}</span>
      </span>
    )}

    <span data-on-device class="ms-auto inline-flex shrink-0 items-center gap-[0.35rem] rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[0.7rem] py-[0.3rem] text-[0.75rem] font-semibold text-[var(--color-muted)] max-[560px]:gap-0 max-[560px]:p-[0.4rem] max-[560px]:text-[0]">
      <svg class="max-[560px]:size-4" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 3l7 3v6c0 4.5-3 8-7 9-4-1-7-4.5-7-9V6l7-3z" />
        <path d="M9 12.5l2 2 4-4.5" />
      </svg>
      {labels.onDevice ?? 'On-device'}
    </span>
    {/* Same slot on every page, home or tool: one trust-chip pill style
        (below), instead of home carrying its own chips inline in the bar and
        every tool page repeating a second, plainer white-pill row inside
        ToolHero. Tool pages pass their chips from ToolPageLayout.astro; home
        passes its own from index.astro. Two different wrapper classes on
        purpose: index.astro's own scoped CSS targets `.home-header
        .home-trust` for home's sticky-pin layout and its own responsive
        rules (icon-only chips, not a full hide, at small widths) - left
        completely alone here. `.tool-trust` gets its own, simpler responsive
        rules below, scoped so they can never reach home's markup. */}
    <div class={isHome ? 'home-trust' : 'tool-trust'}><slot /></div>
  </div>
</div>

<style>
  /* Base trust-chip look, shared by every page that renders one: the sea-glass
     tint home already used, now the one definition instead of a second, plainer
     white-pill version living in ToolHero.astro. `:global` because chips are
     slotted content, authored by the parent (index.astro / ToolPageLayout.astro),
     not part of this component's own template - Astro's scoped CSS does not
     reach into a `<slot/>`'s children otherwise. Home's own
     `.home-header :global(.home-trust .trust-chip)` rule in index.astro is more
     specific (ancestor-qualified) and keeps winning there unchanged; this is
     what tool pages, which have no `.home-header` ancestor, actually get. */
  :global(.trust-chip) {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    min-height: 1.8rem;
    box-sizing: border-box;
    border: 0.5px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-primary-tint);
    padding: 0.3rem 0.7rem;
    color: var(--color-text);
    font-size: 0.78rem;
    font-weight: 600;
    white-space: nowrap;
    text-decoration: none;
    transition: color 150ms ease-out, border-color 150ms ease-out, background-color 150ms ease-out, box-shadow 150ms ease-out;
  }

  :global(a.trust-chip:hover) {
    border-color: var(--color-border-strong);
    background: var(--color-primary-soft);
    color: var(--color-primary-text);
  }

  :global(a.trust-chip:focus-visible) {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: var(--shadow-focus);
    color: var(--color-primary-text);
  }

  :global(.trust-chip-icon) {
    flex: none;
    width: 14px;
    height: 14px;
    display: block;
  }

  /* Tool pages only (home keeps its own rules in index.astro, untouched).
     Below 1024px the bar has a breadcrumb and three chips plus the on-device
     badge competing for one fixed-height row - drop each chip's label and
     keep the icon, same pattern `[data-on-device]` already uses under 560px. */
  @media (max-width: 1023px) {
    :global(.tool-trust) {
      gap: 0.35rem;
    }
    :global(.tool-trust .trust-chip) {
      gap: 0;
      padding: 0.3rem;
      font-size: 0;
    }
  }

  @media (max-width: 560px) {
    :global(.tool-trust) {
      display: none;
    }
  }
</style>
