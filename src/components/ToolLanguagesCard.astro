---
// The "which languages actually survive the download" card, rendered directly
// below the tool (see ToolPageLayout.astro) for any tool whose registry entry
// declares `languages`. Today that is Sign alone, because it is the only tool
// where the user types their own text into the file.
//
// It sits above the "How it works" card on purpose. Someone who arrives
// wanting to fill a form in Hebrew, Hindi, Thai or Russian is asking one
// question before any other, and until now the only place that answered it was
// an FAQ entry most of the way down the page. Half the card is spent saying
// where the tool stops, which is the half that earns the other half.
//
// Content-only, static, zero JS: this is SEO surface (CLAUDE.md Part II 1.1),
// so it is authored in the registry and rendered at build time. The native
// names deliberately render in the visitor's own system font rather than the
// bundled TTF for that script - Kalam alone is 427KB, and downloading half a
// megabyte of webfont so a card can show one word would tax every visitor to
// prove a point to a few.
import FeatureCard from './FeatureCard.astro';
import CardDecor from './CardDecor.astro';
import { Languages, MessageSquarePlus } from 'lucide-preact';

interface Language {
  native: string;
  name: string;
  note: string;
}

interface Props {
  languages: {
    tag?: string;
    heading: string;
    lead: string;
    supportedHeading: string;
    supported: Language[];
    notYetHeading: string;
    notYet: string;
    languageRequestUrl?: string;
    contributeUrl?: string;
  };
  sketch?: 'arcs' | 'waves' | 'rings' | 'grid' | 'meridian';
  iconPos?: 'tr' | 'tl' | 'br' | 'bl' | 'cr' | 'cl';
}

// 'meridian' (longitude lines fanning from a corner, plus a scatter of native
// script glyphs) reads as both halves of what this card is actually about -
// worldwide reach and many scripts - where the earlier 'rings' (plain
// concentric circles) only carried the globe half. 'grid' was rejected before
// that: its straight lines fought the two-column text list for the reader's
// eye, since both are made of horizontal/vertical lines at a similar weight.
const { languages, sketch = 'meridian', iconPos = 'cr' } = Astro.props;
const {
  tag = 'Languages', heading, lead, supportedHeading, supported, notYetHeading, notYet,
  languageRequestUrl, contributeUrl,
} = languages;
---

<FeatureCard variant="highlight" class="relative isolate overflow-hidden">
  <CardDecor sketch={sketch} icon={Languages} iconPos={iconPos} iconSize={280} />
  <div>
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">{tag}</span>
    <h2 class="mb-4 mt-0 text-[1.6rem] font-bold text-[var(--color-text)]">{heading}</h2>
    <p class="mb-6 mt-0 max-w-[68ch] text-[1.05rem] leading-[1.6] text-[var(--color-text)]">{lead}</p>

    <h3 class="mb-1 mt-0 text-[1.05rem] font-bold text-[var(--color-text)]">{supportedHeading}</h3>
    <p class="m-0 mb-4 text-[0.9rem] text-[var(--color-muted)]">Tap a language to read the detail.</p>
    {/* Each row is a native, JS-free <details>/<summary> disclosure: the note
        is real static HTML from the first render, present for a crawler and a
        screen reader whether or not it is visually open, exactly like the
        FAQ disclosure below. The closed row (native name, flags, script name)
        is held to one fixed height via min-h so the list reads as a single
        scannable grid rather than a page of paragraphs - open one and only
        that row grows; its neighbours hold their place. */}
    <ul class="m-0 grid list-none grid-cols-2 gap-x-12 gap-y-8 p-0 max-[768px]:grid-cols-1 max-[768px]:gap-6">
      {supported.map((language) => (
        <li class="self-start overflow-hidden rounded-[var(--radius-md)] border border-[var(--color-border)] bg-[var(--color-surface)]">
          <details class="group">
            <summary
              class="flex min-h-[4.75rem] cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden"
            >
              {/* lang="" is unset on purpose: these are language *names*, and
                  the surrounding page is English. Marking each one up as its
                  own language would have a screen reader switch voice
                  mid-list. */}
              <span class="min-w-0">
                <p class="mb-1 mt-0 text-[1.15rem] font-bold text-[var(--color-text)]">{language.native}</p>
                <p class="m-0 text-[0.78rem] font-semibold uppercase text-[var(--color-primary)]">{language.name}</p>
              </span>
              <span
                aria-hidden="true"
                class="size-2 shrink-0 rotate-45 border-b-2 border-r-2 border-[var(--color-muted)] transition-transform duration-200 group-open:-rotate-[135deg]"
              ></span>
            </summary>
            <p class="m-0 border-t border-[var(--color-border)] px-4 py-3 text-[0.95rem] leading-[1.55] text-[var(--color-muted)]">{language.note}</p>
          </details>
        </li>
      ))}
    </ul>

    <section class="mt-7 border-t border-[var(--color-border)] pt-7">
      <h3 class="mb-3 mt-0 text-[1.05rem] font-bold text-[var(--color-text)]">{notYetHeading}</h3>
      <p class="m-0 max-w-[68ch] text-base leading-[1.7] text-[var(--color-muted)]">{notYet}</p>
      {(languageRequestUrl || contributeUrl) && (
        <div class="mt-4 flex flex-wrap gap-3">
          {languageRequestUrl && (
            <a
              class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] bg-[var(--color-primary)] px-5 py-2.5 text-[0.875rem] font-semibold text-[var(--color-surface)] no-underline shadow-sm transition-[transform,background-color,box-shadow] duration-200 ease-out hover:-translate-y-0.5 hover:bg-[var(--color-primary-hover)] hover:shadow-md"
              href={languageRequestUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <MessageSquarePlus class="shrink-0" size={16} strokeWidth={2} aria-hidden="true" />
              Request a language
            </a>
          )}
          {contributeUrl && (
            <a
              class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-border-strong)] bg-[var(--color-surface)] px-5 py-2.5 text-[0.875rem] font-semibold text-[var(--color-text)] no-underline transition-[transform,border-color,background-color,color] duration-200 ease-out hover:-translate-y-0.5 hover:border-[var(--color-primary)] hover:bg-[var(--color-primary-soft)] hover:text-[var(--color-primary)]"
              href={contributeUrl}
              target="_blank"
              rel="noopener noreferrer"
            >
              <svg class="shrink-0" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.79.62-3.38-1.37-3.38-1.37-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.34 9.34 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
              </svg>
              Contribute on GitHub
            </a>
          )}
        </div>
      )}
    </section>
  </div>
</FeatureCard>
