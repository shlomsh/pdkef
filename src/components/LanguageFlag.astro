---
/**
 * A small inline-SVG flag for the language menu. Inline SVG, not emoji: Windows
 * ships no flag emoji at all and renders them as two regional-indicator letters
 * ("IL", "US"), which is the one platform where a flag would then look broken.
 *
 * A flag stands for a country, not a language, so this is only a visual cue
 * beside the native language name, never the control itself; a locale without
 * an obvious flag falls back to a globe.
 */
interface Props {
  locale: string;
  class?: string;
}
const { locale, class: className = '' } = Astro.props;
---

{locale === 'he' ? (
  <svg class={className} width="20" height="14" viewBox="0 0 22 16" aria-hidden="true" focusable="false">
    <rect width="22" height="16" rx="2" fill="#fff" />
    <rect y="2" width="22" height="2.2" fill="#0038b8" />
    <rect y="11.8" width="22" height="2.2" fill="#0038b8" />
    <path d="M11 4.9 8.3 9.6h5.4Z M11 11.1 8.3 6.4h5.4Z" fill="none" stroke="#0038b8" stroke-width="0.7" stroke-linejoin="round" />
    <rect width="22" height="16" rx="2" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="0.5" />
  </svg>
) : locale === 'en' ? (
  <svg class={className} width="20" height="14" viewBox="0 0 22 16" aria-hidden="true" focusable="false">
    <rect width="22" height="16" rx="2" fill="#fff" />
    <path d="M0 1.2h22M0 3.7h22M0 6.2h22M0 8.7h22M0 11.2h22M0 13.7h22" stroke="#b22234" stroke-width="1.25" />
    <path d="M0 2a2 2 0 0 1 2-2h7.5v8.7H0Z" fill="#3c3b6e" />
    <path d="M1.8 1.6h.9M4 1.6h.9M6.2 1.6h.9M2.9 3.3h.9M5.1 3.3h.9M1.8 5h.9M4 5h.9M6.2 5h.9M2.9 6.7h.9M5.1 6.7h.9" stroke="#fff" stroke-width="0.9" stroke-linecap="round" />
    <rect width="22" height="16" rx="2" fill="none" stroke="rgba(0,0,0,.12)" stroke-width="0.5" />
  </svg>
) : (
  <svg class={className} width="20" height="14" viewBox="0 0 24 24" aria-hidden="true" focusable="false" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="12" cy="12" r="9" /><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18" />
  </svg>
)}
