---
// Per-page structured data. Only emit FAQPage when the page actually renders
// that content visibly - Google treats FAQ JSON-LD that doesn't match
// on-page content as a structured-data violation. Pass `faq` from a page
// only when its visible markup mirrors it.
interface FaqItem {
  question: string;
  answer: string;
}
interface Props {
  name?: string;
  description: string;
  faq?: FaqItem[];
  /** SEO-46: real, at-least-minimum-votes rating; omitted means no markup at all. */
  rating?: { average: number; count: number } | null;
}

const {
  name = 'PDkef',
  description,
  faq,
  rating,
} = Astro.props as Props;

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const author = {
  '@type': 'Person',
  name: 'Shlomi Shemesh',
  url: 'https://github.com/shlomsh',
};

const softwareApp = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name,
  applicationCategory: 'Utility',
  operatingSystem: 'Any (runs in browser)',
  browserRequirements: 'Requires JavaScript. Requires a modern browser with HTML5 Canvas and WebAssembly.',
  url: pageUrl,
  description,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author,
  creator: author,
  ...(rating && {
    aggregateRating: {
      '@type': 'AggregateRating',
      ratingValue: rating.average,
      ratingCount: rating.count,
      bestRating: 5,
      worstRating: 1,
    },
  }),
};

const faqSchema = faq && {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(softwareApp)} />
{faqSchema && <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />}
