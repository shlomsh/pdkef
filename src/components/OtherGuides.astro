---
// Links each OS how-to guide to the other three, so a visitor who landed on
// the Windows guide but is actually on a Mac isn't stuck, and back up to the
// tool itself. The hub link is structural rather than decorative: the four
// guides used to link only to each other, a closed ring with no way out to the
// rest of the site, which left the whole cluster orphaned (see
// RelatedGuides.astro for the other half of that fix).
// Compact strip, same reasoning as ToolCrossLinks.astro for not using a
// full-height FeatureCard.
import { FileSignature } from 'lucide-preact';
import { guides } from '../data/contentPages.js';
import type { OtherGuidesMessages } from '../i18n/documentationMessages';

interface Props {
  currentHref: string;
  locale?: string;
  labels: OtherGuidesMessages;
  resolveLink?: (pageId: string, locale: string) => { href: string; fallback?: boolean };
}

const { currentHref, locale = 'en', labels, resolveLink } = Astro.props;
const others = guides.filter((guide) => guide.href !== currentHref);
---

<section class="mx-auto mb-16 w-full max-w-[1080px] px-6 min-[768px]:mb-24" aria-labelledby="other-guides-heading">
  <div class="mb-6 text-center">
    <h2 id="other-guides-heading" class="m-0 text-[1.15rem] font-bold text-[var(--color-text)]">{labels.otherDevices}</h2>
  </div>
  <ul class="m-0 flex list-none flex-wrap justify-center gap-3 p-0">
    {others.map((guide) => {
      const pageId = guide.href.replace(/^\//, '').replace(/\/$/, '');
      const link = resolveLink?.(pageId, locale);
      return <li class="m-0 p-0">
        <a
          href={link?.href ?? guide.href}
          class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-4 py-2 text-[0.9rem] font-medium text-[var(--color-text)] no-underline transition-[transform,border-color,color] duration-150 ease-out hover:-translate-y-px hover:border-[var(--color-border-strong)]"
        >
          <guide.icon size={16} strokeWidth={1.75} class="text-[var(--color-primary)]" />
          {guide.label}
        </a>
      </li>;
    })}
    <li class="m-0 p-0">
      <a
        href="/sign/"
        class="inline-flex items-center gap-2 rounded-[var(--radius-pill)] border border-[var(--color-primary-tint)] bg-[var(--color-primary-soft)] px-4 py-2 text-[0.9rem] font-medium text-[var(--color-primary)] no-underline transition-[transform,border-color,color] duration-150 ease-out hover:-translate-y-px hover:border-[var(--color-border-strong)]"
      >
        <FileSignature size={16} strokeWidth={1.75} />
        {labels.openSignTool}
      </a>
    </li>
  </ul>
</section>
