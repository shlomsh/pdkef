---
/**
 * ToolDoodle: one small hand-drawn picture per tool, for the "related tools"
 * stickers. Static inline SVG, no JS.
 *
 * One figure per branch below, keyed by the tool's slug (src/data/tools.js).
 * An unknown slug renders nothing. Adding a figure is one more
 * `{tool === '...' && (...)}` block plus any new motion rule in the <style>.
 *
 * Shared stroke rules (pencil): round caps and joins, currentColor strokes
 * about 2.4 wide, clay sparkles, no glow, no filters. Colours come from the
 * :root tokens only. Size comes from the consumer (default: full width).
 *
 * The figure moves when an ancestor link is hovered or keyboard-focused, and
 * only when motion is allowed (prefers-reduced-motion: no-preference).
 * Otherwise it is a still drawing.
 *
 * The picture is decorative and aria-hidden, so the text beside it carries
 * the meaning.
 */
interface Props {
  tool: string;
  class?: string;
}
const { tool, class: className } = Astro.props;
const KNOWN = [
  'sign', 'highlight-pdf', 'redact', 'merge', 'split', 'organize-pdf', 'unlock',
  'pdf-to-image', 'image-to-pdf', 'scan-to-pdf', 'compress-image', 'compress',
];
---

{KNOWN.includes(tool) && (
  <svg class:list={['tool-doodle', className]} viewBox="0 0 80 64" fill="none" aria-hidden="true" focusable="false">
    {tool === 'sign' && (
      <>
        <path class="dd" d="M18 6h24l8 8v38H18z" fill="var(--color-paper)" /><path class="dd" d="M42 6v8h8" />
        <path class="dd" d="M24 20h18M24 26h12" />
        <path class="sig" d="M22 42c3-8 7-9 6-2s3 4 6-2 5-3 4 1 4 1 10-4" />
        <g class="move"><path class="dd" d="M52 52l14-20 5 4-14 20-7 2z" fill="var(--color-citron)" /><path class="dd" d="M62 38l5 4" /></g>
        <path class="spark" d="M70 14v8M66 18h8" />
      </>
    )}
    {tool === 'highlight-pdf' && (
      <>
        <path class="dd" d="M16 6h26l8 8v42H16z" fill="var(--color-paper)" /><path class="dd" d="M42 6v8h8" />
        <path class="swipe" d="M21 29h24" stroke="var(--color-highlighter)" stroke-width="8" stroke-linecap="round" />
        <path class="dd" d="M22 20h20M22 29h22M22 38h14M22 46h18" />
        <g class="move"><path class="dd" d="M54 56l12-17 6 4-12 17-8 2z" fill="var(--color-highlighter)" /><path class="dd" d="M63 43l6 4" /></g>
      </>
    )}
    {tool === 'redact' && (
      <>
        <path class="dd" d="M16 6h26l8 8v42H16z" fill="var(--color-paper)" /><path class="dd" d="M42 6v8h8" />
        <path class="dd" d="M22 20h22M22 44h14M22 50h10" />
        <rect class="bar" x="21" y="27" width="24" height="9" rx="2" fill="var(--color-text)" />
        <g class="spark"><path d="M60 22v8M56 26h8" /><path d="M66 42v6M63 45h6" /></g>
      </>
    )}
    {tool === 'merge' && (
      <>
        <g class="move"><path class="dd" d="M4 4h14l8 8v22H4z" fill="var(--color-paper)" /><path class="dd" d="M18 4v8h8" /></g>
        <g class="move"><path class="dd" d="M4 34h14l8 8v22H4z" fill="var(--color-paper)" /><path class="dd" d="M18 34v8h8" /></g>
        <path class="trail" d="M30 17c8 1 12 7 14 13M30 47c8-1 12-7 14-13" />
        <path class="dd" d="M40 27l5 5-5 5" />
        <path class="dd" d="M50 14h18l8 8v28H50z" fill="var(--color-citron)" /><path class="dd" d="M68 14v8h8" />
        <path class="dd" d="M57 9v11c0 4 6 4 6 0v-9" />
      </>
    )}
    {tool === 'split' && (
      <>
        <path class="dd" d="M20 4h26l8 8v48H20z" fill="var(--color-paper)" /><path class="dd" d="M46 4v8h8" />
        <path class="dd" d="M26 16h20M26 22h14M26 42h20M26 48h12" />
        <path class="ghost" d="M10 32h52" />
        <g class="snip"><circle class="dd" cx="71" cy="25" r="5" fill="var(--color-citron)" /><path class="dd" d="M66 27L54 32" /></g>
        <g><circle class="dd" cx="71" cy="39" r="5" fill="var(--color-citron)" /><path class="dd" d="M66 37L54 32" /></g>
      </>
    )}
    {tool === 'organize-pdf' && (
      <>
        <g class="fanL"><g transform="rotate(-12 18 34)">
          <path class="dd" d="M8 12h14l8 8v22H8z" fill="var(--color-paper)" /><path class="dd" d="M22 12v8h8" />
        </g></g>
        <g transform="rotate(10 62 34)" class="fanR">
          <path class="dd" d="M50 12h14l8 8v22H50z" fill="var(--color-paper)" /><path class="dd" d="M64 12v8h8" />
        </g>
        <path class="dd" d="M29 8h14l8 8v22H29z" fill="var(--color-citron)" /><path class="dd" d="M43 8v8h8" />
        <path class="dd" transform="rotate(-12 18 34)" d="M15 26l3-2.500V34" />
        <path class="dd" d="M36 22c1-3.500 7-3.500 7 0s-3 4-7 8h8" />
        <path class="dd" transform="rotate(10 62 34)" d="M57 25c2-2.500 6-2 6 1s-3 3-3 3 4 0 4 3-5 4-8 1" />
        <path class="trail" d="M14 52c14 8 38 8 52 0" /><path class="dd" d="M60 49l6 3-4 6" />
      </>
    )}
    {tool === 'unlock' && (
      <>
        <path class="dd" d="M16 4h26l8 8v44H16z" fill="var(--color-paper)" /><path class="dd" d="M42 4v8h8" />
        <path class="dd" d="M22 16h22M22 22h14" />
        <path class="dd shack" d="M38 34v-6a7 7 0 0 1 14 0v6" />
        <rect class="dd" x="33" y="33" width="24" height="20" rx="4" fill="var(--color-citron)" /><path class="dd" d="M45 41v5" />
        <path class="spark" d="M66 14v8M62 18h8" />
      </>
    )}
    {tool === 'pdf-to-image' && (
      <>
        <path class="dd" d="M4 12h16l8 8v26H4z" fill="var(--color-paper)" /><path class="dd" d="M20 12v8h8" />
        <path class="dd" d="M9 26h12M9 32h8" />
        <path class="trail" d="M32 29h14" /><path class="dd" d="M43 24l5 5-5 5" />
        <g class="moveR">
          <rect class="dd" x="52" y="12" width="24" height="34" rx="3" fill="var(--color-primary-tint)" />
          <path class="dd" d="M55 41l6.720-10.880 4.800 6.800 2.880-3.400 6.720 7.480" />
          <circle class="dd" cx="68.800" cy="21.180" r="2.500" fill="var(--color-highlighter)" />
        </g>
      </>
    )}
    {tool === 'image-to-pdf' && (
      <>
        <g class="move">
          <rect class="dd" x="4" y="12" width="24" height="34" rx="3" fill="var(--color-primary-tint)" />
          <path class="dd" d="M7 41l6.720-10.880 4.800 6.800 2.880-3.400 6.720 7.480" />
          <circle class="dd" cx="20.800" cy="21.180" r="2.500" fill="var(--color-highlighter)" />
        </g>
        <path class="trail" d="M32 29h14" /><path class="dd" d="M43 24l5 5-5 5" />
        <path class="dd" d="M52 12h16l8 8v26H52z" fill="var(--color-citron)" /><path class="dd" d="M68 12v8h8" />
        <path class="dd" d="M57 28h12M57 34h8" />
      </>
    )}
    {tool === 'scan-to-pdf' && (
      <>
        <rect class="dd" x="24" y="2" width="32" height="60" rx="7" fill="var(--color-surface)" />
        <g transform="rotate(-7 40 30)">
          <path class="dd" d="M31 16h10l8 8v16H31z" fill="var(--color-paper)" /><path class="dd" d="M41 16v8h8" />
        </g>
        <path class="dd flash" d="M30 16v-4h4M46 12h4v4M50 40v4h-4M34 44h-4v-4" stroke="var(--color-primary)" />
        <circle class="dd" cx="40" cy="53" r="3" />
        <g class="spark"><path d="M12 14v8M8 18h8" /><path d="M68 44v6M65 47h6" /></g>
      </>
    )}
    {tool === 'compress-image' && (
      <>
        <g class="squash">
          <rect class="dd" x="26" y="14" width="28" height="34" rx="3" fill="var(--color-primary-tint)" />
          <path class="dd" d="M29 43l7.840-10.880 5.600 6.800 3.360-3.400 7.840 7.480" />
          <circle class="dd" cx="45.600" cy="23.180" r="2.800" fill="var(--color-highlighter)" />
        </g>
        <g class="move"><path class="dd" d="M4 31h14" /><path class="dd" d="M13 26l6 5-6 5" /></g>
        <g class="moveR"><path class="dd" d="M76 31H62" /><path class="dd" d="M67 26l-6 5 6 5" /></g>
        <path class="spark" d="M40 4v6M37 7h6" />
      </>
    )}
    {tool === 'compress' && (
      <>
        <g class="squash">
          <path class="dd" d="M26 10h20l8 8v36H26z" fill="var(--color-paper)" /><path class="dd" d="M46 10v8h8" />
          <path class="dd" d="M32 28h16M32 35h10" />
        </g>
        <g class="move"><path class="dd" d="M4 32h14" /><path class="dd" d="M13 27l6 5-6 5" /></g>
        <g class="moveR"><path class="dd" d="M76 32H62" /><path class="dd" d="M67 27l-6 5 6 5" /></g>
        <path class="spark" d="M40 3v6M37 6h6" />
      </>
    )}
  </svg>
)}

<style>
  .tool-doodle { display: block; width: 100%; height: auto; overflow: visible; color: var(--color-text); }
  .tool-doodle .dd { stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .tool-doodle .spark { stroke: var(--color-clay); stroke-width: 2.2; stroke-linecap: round; }
  .tool-doodle .ghost { stroke: var(--color-border-strong); stroke-width: 2.2; stroke-linecap: round; stroke-dasharray: 2 6; }
  .tool-doodle .trail { stroke: var(--color-primary); stroke-width: 2.4; stroke-linecap: round; stroke-dasharray: 3 7; }
  .tool-doodle .sig { stroke: var(--color-text); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; stroke-dasharray: 90; }
  .tool-doodle .swipe, .tool-doodle .bar, .tool-doodle .move, .tool-doodle .moveR, .tool-doodle .snip,
  .tool-doodle .shack, .tool-doodle .squash, .tool-doodle .fanL, .tool-doodle .fanR, .tool-doodle .flash { transform-box: fill-box; }
  .tool-doodle .swipe, .tool-doodle .bar { transform-origin: left center; }
  .tool-doodle .squash { transform-origin: center; }
  .tool-doodle .snip { transform-origin: right center; }
  .tool-doodle .fanL { transform-origin: bottom right; }
  .tool-doodle .fanR { transform-origin: bottom left; }

  @media (prefers-reduced-motion: no-preference) {
    :global(a:hover) .tool-doodle .sig, :global(a:focus-visible) .tool-doodle .sig { animation: tool-draw .9s ease-out; }
    :global(a:hover) .tool-doodle .swipe, :global(a:focus-visible) .tool-doodle .swipe,
    :global(a:hover) .tool-doodle .bar, :global(a:focus-visible) .tool-doodle .bar { animation: tool-grow .6s ease-out; }
    :global(a:hover) .tool-doodle .trail, :global(a:focus-visible) .tool-doodle .trail { animation: tool-march .8s linear infinite; }
    :global(a:hover) .tool-doodle .move, :global(a:focus-visible) .tool-doodle .move { animation: tool-nudge .7s ease-in-out; }
    :global(a:hover) .tool-doodle .moveR, :global(a:focus-visible) .tool-doodle .moveR { animation: tool-nudge-r .7s ease-in-out; }
    :global(a:hover) .tool-doodle .snip, :global(a:focus-visible) .tool-doodle .snip { animation: tool-snip .5s ease-in-out 2; }
    :global(a:hover) .tool-doodle .shack, :global(a:focus-visible) .tool-doodle .shack { animation: tool-lift .7s ease-in-out; }
    :global(a:hover) .tool-doodle .squash, :global(a:focus-visible) .tool-doodle .squash { animation: tool-squash .7s ease-in-out; }
    :global(a:hover) .tool-doodle .fanL, :global(a:focus-visible) .tool-doodle .fanL { animation: tool-fan-l .7s ease-in-out; }
    :global(a:hover) .tool-doodle .fanR, :global(a:focus-visible) .tool-doodle .fanR { animation: tool-fan-r .7s ease-in-out; }
    :global(a:hover) .tool-doodle .flash, :global(a:focus-visible) .tool-doodle .flash { animation: tool-flash .6s ease-out; }
  }
  @keyframes tool-draw { from { stroke-dashoffset: 90; } to { stroke-dashoffset: 0; } }
  @keyframes tool-grow { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes tool-march { to { stroke-dashoffset: -20; } }
  @keyframes tool-nudge { 50% { transform: translateX(4px); } }
  @keyframes tool-nudge-r { 50% { transform: translateX(-4px); } }
  @keyframes tool-snip { 50% { transform: rotate(-14deg); } }
  @keyframes tool-lift { 50% { transform: translateY(-4px); } }
  @keyframes tool-squash { 50% { transform: scaleX(.78); } }
  @keyframes tool-fan-l { 50% { transform: rotate(-8deg); } }
  @keyframes tool-fan-r { 50% { transform: rotate(8deg); } }
  @keyframes tool-flash { 0% { opacity: 1; } 40% { opacity: .2; } 100% { opacity: 1; } }
</style>
