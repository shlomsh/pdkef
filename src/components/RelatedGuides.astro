---
// Inbound links from a tool page to the content pages that hang off it, read
// from src/data/contentPages.js's `hub` field.
//
// Why this exists, and it is not a nice-to-have: before it, all eight content
// pages were orphans. Every link they had came from inside the cluster itself,
// so no sequence of clicks from the home page reached any of them, and their
// only route to a crawler was sitemap.xml - which gets a URL fetched but says
// nothing about whether it matters. Worse, the cluster linked *out* to the
// tools, so it leaked internal signal and received none. This is the same
// diagnosis, and the same fix, as ToolCrossLinks.astro for tool-to-tool links.
//
// Card grid, matching ToolCrossLinks.astro's visual language (icon square,
// title, one-line description) rather than OtherGuides.astro's bare pills,
// because this section renders directly above ToolCrossLinks' own grid on the
// same page - a plain pill row next to it read as an afterthought, and with
// only one or two related pages on some tools (redact, edit-pdf) a lone pill
// in a wide centered container looked broken rather than compact.
//
// The card and section chrome are ToolCrossLinks' own (LinkCard.astro and the
// same utilities), so a tool page with no guides pays for only the few column
// rules below. Rows start at the left like the tool cards' grid, so a short
// last row sits on the same columns; a lone card (/merge/) centres on its own.
import LinkCard from './LinkCard.astro';
import { contentPagesForTool } from '../data/contentPages.js';
import type { RelatedGuidesMessages } from '../i18n/documentationMessages';
import { getGuideCardCopy } from '../i18n/cardMessages';
import { documentationPath } from '../i18n/documentationLocales';

interface Props {
  currentSlug: string;
  heading?: string;
  locale?: string;
  labels?: RelatedGuidesMessages & { inEnglish?: string };
  resolveLink?: (pageId: string, locale: string) => { href: string; fallback?: boolean };
  /** Site paths of every page published in `locale`; a card links to the
   * localized guide when there is one, else to English with an EN mark. */
  editionPaths?: readonly string[];
}

const { currentSlug, heading, locale = 'en', labels = {} as Props['labels'], resolveLink, editionPaths = [] } = Astro.props as Props;
const published = new Set(editionPaths);
const resolvedHeading = heading ?? labels?.relatedHeading ?? 'Step-by-step guides for this tool';
const related = contentPagesForTool(currentSlug);
---

{related.length > 0 && (
  <section class="mx-auto mb-16 w-full max-w-[1080px] px-6 min-[768px]:mb-24" aria-labelledby="related-guides-heading">
    <div class="space-heading-content text-center">
      <h2 id="related-guides-heading" class="type-section m-0 text-balance text-[var(--color-text)]">{resolvedHeading}</h2>
    </div>

    <ul class="related-guides-grid space-layout-gap m-0 flex list-none flex-wrap p-0">
      {related.map((page) => {
        const pageId = page.href.replace(/^\//, '').replace(/\/$/, '');
        const localizedHref = locale === 'en' ? page.href : documentationPath(pageId, locale as any);
        const link = resolveLink?.(pageId, locale) ?? { href: published.has(localizedHref) ? localizedHref : page.href };
        const copy = getGuideCardCopy(locale, pageId);
        const english = locale !== 'en' && link.href === page.href;
        return <li class="m-0 p-0">
          <LinkCard
            href={link.href}
            hreflang={english ? 'en' : undefined}
            icon={page.icon}
            title={copy?.title ?? page.label}
            description={copy?.description ?? page.blurb}
            englishLabel={english ? labels?.inEnglish : undefined}
          />
        </li>;
      })}
    </ul>
  </section>
)}

<style>
  /* The widths are ToolCrossLinks' columns and every row starts at the left, so
     each card sits on a column of the grid directly below. */
  .related-guides-grid > li {
    flex: 0 0 calc((100% - 2 * var(--space-layout-gap)) / 3);
  }

  .related-guides-grid > li:only-child {
    margin-inline: auto;
  }

  @media (max-width: 768px) {
    .related-guides-grid > li {
      flex-basis: calc((100% - var(--space-layout-gap)) / 2);
    }
  }

  @media (max-width: 560px) {
    .related-guides-grid > li {
      flex-basis: 100%;
    }
  }
</style>
