---
// Site-wide Organization + WebSite JSON-LD, rendered once by BaseLayout on
// every page (unlike SeoSchema.astro's SoftwareApplication/FAQPage, which
// describe a specific tool page). The data lives in
// src/data/organizationSchema.js so it can be tested and cross-checked.
import { organization, website } from '../data/organizationSchema.js';
---

<script is:inline type="application/ld+json" set:html={JSON.stringify(organization)} />
<script is:inline type="application/ld+json" set:html={JSON.stringify(website)} />
