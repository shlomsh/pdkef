---
// SEO-58: PDkef's rating as a board, on the home page and Redact. The stars are baked in at build time; beside them
// pin up approved notes and recent votes, which mostly carry no words.
import PinnedNotes from '../site-lib/PinnedNotes.tsx';
import { ratingText } from '../site-lib/ratingAggregate';
import { notesFromEnv } from '../site-lib/notesAtBuild';
import { notesToShow } from '../site-lib/pinnedNote';
import { flagSpriteFor } from '../site-lib/flagFiles';

interface Props {
  rating: { average: number; count: number; countries: number } | null;
  messages: any;
  tool?: 'redact';
  locale?: string;
  /** A card of the home stack: opaque and pinned like its neighbours, so nothing shows around it. */
  card?: boolean;
}
const { rating, messages, tool, locale, card } = Astro.props;
const allNotes = await notesFromEnv();
const notes = notesToShow(allNotes, tool);
// MEM-42: the sprite is made from every note, not from this board's pick, so every board names the
// one file the build writes (src/pages/flags/[sprite].svg.ts) and a browser fetches it once.
const sprite = flagSpriteFor(allNotes);
const STAR = 'M12 3.2l2.7 5.6 6.1.8-4.5 4.2 1.1 6-5.4-3-5.4 3 1.1-6L3.2 9.6l6.1-.8z';
const FIVE = [0, 1, 2, 3, 4];
---
<section class:list={['board', { card, 'card-reveal': card }]} aria-labelledby="rating-board-heading">
  <div class="panel">
    <h2 id="rating-board-heading" class="type-section">{messages.notesHeading}</h2>
    <p class="intro">{messages.notesIntro}</p>
    {rating && (
      <div data-rating>
        <div class="row">
          <span class="average">{rating.average}</span>
          <svg class="stars" viewBox="0 0 120 24" role="img" aria-label={`${rating.average} / 5`}>
            <defs><clipPath id="rating-board-fill"><rect width={(rating.average / 5) * 120} height="24" /></clipPath></defs>
            <g class="empty">{FIVE.map((s) => <path d={STAR} transform={`translate(${s * 24} 0)`} />)}</g>
            <g class="full" clip-path="url(#rating-board-fill)">{FIVE.map((s) => <path d={STAR} transform={`translate(${s * 24} 0)`} />)}</g>
          </svg>
        </div>
        <p class="count">{ratingText(messages.ratingBoardCount, rating)}</p>
      </div>
    )}
    <p class="invite">{messages.ratingBoardInvite}</p>
  </div>
  <PinnedNotes client:load notes={notes} flags={sprite?.codes ?? []} spriteUrl={sprite?.url} locale={locale} byLine={messages.notesBy} more={messages.notesMore} less={messages.notesLess} />
</section>

<style>
  .board {
    box-sizing: border-box;
    width: min(1080px, 100% - 2rem);
    margin: 0 auto;
    padding-block: clamp(4rem, 8vw, 6.5rem);
  }
  .card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: min(1080px, 100%);
    padding-inline: 2.5rem;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
  }
  @media (max-width: 1080px) { .card { width: auto; margin-inline: 1.5rem; } }
  @media (max-width: 640px) { .card { padding-inline: 1.5rem; } }

  .panel { max-width: 34rem; margin-inline: auto; text-align: center; }
  .panel h2 { margin: 0 0 1rem; color: var(--color-text); text-wrap: balance; }
  .intro { margin: 0 0 2rem; color: var(--color-muted); }
  .row { display: flex; align-items: center; justify-content: center; gap: 0.75rem; }
  .average { font-size: 2.5rem; font-weight: 700; line-height: 1; color: var(--color-text); }
  .stars { width: 10.5rem; height: 2.1rem; }
  .stars .empty { fill: none; stroke: var(--color-clay); stroke-width: 1.2; stroke-linejoin: round; }
  .stars .full { fill: var(--color-comment-anchor); stroke: var(--color-clay); stroke-width: 1.2; stroke-linejoin: round; }
  .count { margin: 0.75rem 0 0; font-weight: 600; color: var(--color-text); }
  .invite { margin: 1.25rem 0 0; font-size: 0.95rem; color: var(--color-muted); }

  /* With notes: the stars head the board on a phone; on a wide screen they sit beside the three by three papers. */
  .board:has(ul) .panel { margin-block-end: 2rem; }
  @media (min-width: 60rem) {
    .board:has(ul) {
      display: grid;
      grid-template-columns: minmax(0, 17rem) minmax(0, 1fr);
      gap: 3rem;
      align-items: center;
      align-content: center;
    }
    .board:has(ul) .panel { margin: 0; text-align: start; }
    .board:has(ul) .row { justify-content: flex-start; }
  }
  /* A card of the home stack is one screen tall on a wide screen, like its neighbours. */
  @media (min-width: 768px) {
    .card { min-height: calc(100vh - 6rem); padding-block: 2.5rem; }
  }
</style>
