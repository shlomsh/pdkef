---
// The tool's short video, directly below the tool: its poster, linking to YouTube
// in a new tab so the tool keeps its work. A link and not a player, because the CSP
// allows only our own origin and no tool page may connect to Google.
interface Props {
  video: { heading: string; label: string; url: string; poster: string };
}

const { video } = Astro.props;
---

<section class="mx-auto mb-2 mt-8 w-full max-w-[860px] px-6" data-tool-video>
  <h2 class="type-section mb-4 text-center text-[var(--color-text)]">{video.heading}</h2>
  <a class="block text-center text-[var(--color-text)]" href={video.url} target="_blank" rel="noopener">
    <span class="relative block">
      <img
        class="block h-auto w-full rounded-2xl"
        src={video.poster}
        alt={video.label}
        width="1280"
        height="720"
        loading="lazy"
        decoding="async"
      />
      <span
        class="absolute inset-0 m-auto flex h-16 w-16 items-center justify-center rounded-full bg-[var(--color-text)] text-[var(--color-bg)]"
        aria-hidden="true"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"></path></svg>
      </span>
    </span>
    <span class="mt-3 block underline">Watch on YouTube</span>
  </a>
</section>
