---
// The tool's short video, directly below the tool, on the page's 1032px column. The gaps
// keep the page's rhythm of 64px, 96px from 768px up: the board below brings 56px of its
// own padding, so the bottom margin is the rest.
import VideoPoster from '../VideoPoster.astro';

interface Props {
  video: { label: string; embed: string; poster: string };
}

const { video } = Astro.props;
---

<section class="mx-auto mb-2 mt-16 w-full max-w-[1080px] px-6 min-[768px]:mb-10 min-[768px]:mt-24" data-tool-video>
  <VideoPoster video={video} />
</section>
