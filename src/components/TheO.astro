---
// The O (DEMO-10, docs/home-the-o.md): the home page's scroll story. One ring
// is the zero in "0 accounts", "0 uploads" and "0 paywalls", the O of "Open
// source" and a plane window; then the airplane in that beat takes off, turns
// into a paper plane and lands at the end of the founder's sentence.
//
// How it is built (theO.css):
// - Six beats share one geometry. Every length comes from the stage's own size
//   (container units) and from --R, the ring's height, so the ring, the words
//   and every wipe centre agree at any viewport.
// - The ring's shapes are measured from the system font's bold glyphs (SF Pro:
//   a zero is 0.788 as wide as it is tall; the O is 0.729em tall and 0.68em
//   wide; both have 0.15em sides). The words sit on the zero's baseline, and
//   "Open source" is sized so the O lands on its cap height and baseline
//   exactly. Length ratios use tan(atan2(a, b)), which is a / b as a plain number.
// - The finale: once airplane mode is on, the toggle's own plane takes off
//   (its flight starts as the same glyph, size and place), climbs over the
//   heading, rolls over and comes out a paper plane, the plane that shares.
//   The last card opens from there, and the paper plane glides over the top
//   and comes down the clear lane at the end of the staggered last sentence
//   (end-aligned and trimmed to its baseline with text-box), touching down on
//   its baseline after "them". The flight is its own layer above the beats.
// - Motion: the stage pins for 1200svh, about two screens of scrolling per
//   card: the change into it, its words, then a rest of a screen or more, so
//   every card pauses before the next change starts.
//   The ring and the colour changes are scrubbed by scroll position: every
//   beat's copy of the ring runs the same path keyframes over the whole pin, so
//   the ring is one continuous shape, and each beat is a full layer in its own
//   colours, revealed by a circle opening from the ring. The words are not
//   scrubbed: once the ring has settled, they fade in as in the original
//   sketch. The scroll position sets the cue (--o-lit, the beat whose words
//   are lit) and the fade runs in time, so it always completes. (Moving the
//   ring itself on timed cues was tried and dropped: a fast scroll stacked the
//   moves up and skipped the window and the landing.)
// - The window beat enacts its own line: flat vector clouds drift across the
//   visitor's own sky (day, golden or night by their clock, theOSky.ts), and
//   the airplane-mode toggle beside the line switches on, drawn the way a
//   phone draws it: a white plane (Lucide's, filled and turned level) on a
//   grey disc that fills orange. Its line is a call to action, and while the
//   visitor really is offline the page celebrates it coming true: the toggle
//   stays on and becomes a badge, with a burst, and "It still works." pops up.
//   That is why the English home page does not also render OfflineProof.
// - Still version (reduced motion, or no scroll timelines): the six beats stack
//   as posters, each ring in its finished shape, every word shown and the
//   paper plane already landed.
//
// The CSS ships inline on the one page that renders this (the CompareFigure
// pattern), with its hash registered for the CSP, so the Hebrew home page,
// which shares HomePageLayout but not this section yet, carries none of it.
// The script is bundled (no is:inline), so the CSP covers it the same way.
import { Plane } from 'lucide-preact';
import { cspSha256 } from '../site-lib/cspHash.js';
import theOCss from './theO.css?raw';

interface Line {
  word: string;
  line: string;
}

interface Props {
  story: {
    heading: string;
    zeros: Line[];
    openSource: Line;
    offline: Line & { stress?: string; live: string; liveStress?: string };
    lead: string;
    last: [string, string];
  };
}

const { story } = Astro.props;
Astro.csp?.insertStyleHash(cspSha256(theOCss));

// The ring draws the O of "Open source", and the paper plane lands where the
// sentence's full stop would be, so the visible text leaves them out; screen
// readers get the whole words.
const openSourceTail = story.openSource.word.slice(1);
const [lastLineOne, lastLineTwo] = story.last;
const lastLineTwoWithoutStop = lastLineTwo.replace(/\.$/, '');
// Each sentence of a small line starts on its own line ("Free." / "No caps, no
// watermark, no catch."), so no line breaks mid-thought at any width.
const sentences = (text: string) => text.split(/(?<=[.!?])\s+/);
// The window beat sets one phrase of each line apart (the call to action, and
// the payoff when it comes true); a phrase splits out of its sentence only
// when it occurs there exactly once, so the text always reads as written.
const stressed = (line: string, phrase?: string) =>
  sentences(line).map((sentence) => {
    const at = phrase ? sentence.indexOf(phrase) : -1;
    return at !== -1 && at === sentence.lastIndexOf(phrase!)
      ? { before: sentence.slice(0, at), phrase, after: sentence.slice(at + phrase!.length) }
      : { before: sentence, phrase: undefined, after: '' };
  });
// A few stars for the night sky, in the pane's own units (the pane is 1.12 by
// 1.216 ring heights), kept inside the window's rounded opening.
// The paper plane, nose to the right: its wing, and the fold under it.
const paperPlane = '<path class="o-paper-wing" d="M0 9 32 1 12.5 12.5Z"></path><path class="o-paper-fold" d="M12.5 12.5 32 1 17 19Z"></path>';
const stars = [
  [37, 32, 0.6], [48, 25, 0.4], [60, 50, 0.45], [40, 52, 0.5], [78, 60, 0.6], [30, 74, 0.45],
  [52, 88, 0.55], [70, 96, 0.4], [80, 82, 0.5], [58, 70, 0.4], [46, 97, 0.45],
];
---

<style is:inline set:html={theOCss}></style>
<section class="the-o" aria-labelledby="the-o-heading">
  <h2 id="the-o-heading" class="sr-only">{story.heading}</h2>
  <div class="o-track">
    <div class="o-stage">
      {story.zeros.map((zero, index) => (
        <div class={`o-beat b${index + 1}`}>
          <div class="o-art">
            <span class="o-ring" aria-hidden="true"></span>
            <div class="o-text">
              <p class="o-word"><span class="o-rise"><span class="sr-only">0 </span>{zero.word}</span></p>
              <p class="o-sub"><span class="o-rise">{sentences(zero.line).map((sentence, i) => <>{i > 0 && ' '}<span class="o-s">{sentence}</span></>)}</span></p>
            </div>
          </div>
        </div>
      ))}
      <div class="o-beat b4">
        <div class="o-art">
          <span class="o-ring" aria-hidden="true"></span>
          <div class="o-text">
            <p class="o-word"><span class="o-rise"><span class="sr-only">{story.openSource.word}</span><span aria-hidden="true">{openSourceTail}</span></span></p>
            <p class="o-sub"><span class="o-rise">{sentences(story.openSource.line).map((sentence, i) => <>{i > 0 && ' '}<span class="o-s">{sentence}</span></>)}</span></p>
          </div>
        </div>
      </div>
      <div class="o-beat b5">
        <div class="o-art">
          <span class="o-ring" aria-hidden="true">
            <span class="o-pane">
              <svg class="o-sky" viewBox="0 0 112 121.6" focusable="false">
                <circle class="o-sun-halo" cx="56" cy="90" r="15"></circle>
                <circle class="o-sun" cx="56" cy="90" r="9.5"></circle>
                <g class="o-stars">{stars.map(([cx, cy, r]) => <circle cx={cx} cy={cy} r={r}></circle>)}</g>
                <path class="o-moon" d="M71.6 31.2A6 6 0 1 0 71.6 40.8A4.8 4.8 0 0 1 71.6 31.2Z" transform="rotate(-20 68 36)"></path>
              </svg>
              <svg class="o-cloud c1" viewBox="0 0 64 28" focusable="false"><circle cx="18" cy="17" r="9"></circle><circle cx="33" cy="12" r="12"></circle><circle cx="48" cy="17" r="8"></circle><rect x="4" y="16" width="56" height="12" rx="6"></rect></svg>
              <svg class="o-cloud c2" viewBox="0 0 64 28" focusable="false"><circle cx="18" cy="17" r="9"></circle><circle cx="33" cy="12" r="12"></circle><circle cx="48" cy="17" r="8"></circle><rect x="4" y="16" width="56" height="12" rx="6"></rect></svg>
            </span>
          </span>
          <div class="o-text">
            <p class="o-word"><span class="o-rise">{story.offline.word}</span></p>
            <p class="o-sub o-sub-mode" aria-live="polite">
              <span class="o-rise">
                <span class="o-mode" aria-hidden="true">
                  <span class="o-mode-on"></span>
                  <Plane class="o-plane" fill="currentColor" strokeWidth={1.25} />
                  <span class="o-burst">{Array.from({ length: 10 }, () => <span></span>)}</span>
                  <span class="o-sparks"><span></span><span></span><span></span></span>
                </span>
                <span class="o-when-online">{stressed(story.offline.line, story.offline.stress).map((part, i) => <>{i > 0 && ' '}<span class="o-s">{part.before}{part.phrase && <strong class="o-cta">{part.phrase}</strong>}{part.after}</span></>)}</span>
                <span class="o-when-offline">{stressed(story.offline.live, story.offline.liveStress).map((part, i) => <>{i > 0 && ' '}<span class="o-s">{part.before}{part.phrase && <strong class="o-win">{part.phrase}</strong>}{part.after}</span></>)}</span>
              </span>
            </p>
          </div>
        </div>
      </div>
      <div class="o-beat b6">
        <div class="o-art">
          <svg class="o-paper-rest" viewBox="0 0 32 20" aria-hidden="true" focusable="false" set:html={paperPlane}></svg>
          <div class="o-fin">
            <p class="o-lead"><span class="o-rise">{sentences(story.lead).map((sentence, i) => <>{i > 0 && ' '}<span class="o-s">{sentence}</span></>)}</span></p>
            <p class="o-last"><span class="o-rise"><span class="o-l1">{lastLineOne}</span> <span class="o-l2">{lastLineTwoWithoutStop}<span class="sr-only">.</span></span></span></p>
          </div>
        </div>
      </div>
      <div class="o-beat bf" aria-hidden="true">
        <div class="o-art">
          <span class="o-flight">
            <span class="o-touch">
              <span class="o-roll">
                <span class="o-face o-face-plane"><Plane fill="currentColor" strokeWidth={1.25} /></span>
                <span class="o-face o-face-paper"><svg viewBox="0 0 32 20" focusable="false" set:html={paperPlane}></svg></span>
              </span>
            </span>
          </span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { skyAt } from '../site-lib/theOSky';

  // The window beat's two live details, both progressive enhancement: the sky
  // follows the visitor's clock, and while they really are offline the
  // airplane-mode toggle is on and the line celebrates it. data-offline is
  // "now" for a few seconds when it happens while that line is on screen, so
  // the celebration plays at once instead of waiting for the line's fade-in,
  // which has already happened.
  const theO = document.querySelector<HTMLElement>('.the-o');
  const line = theO?.querySelector('.o-sub-mode');
  if (theO && line) {
    theO.dataset.sky = skyAt(new Date());
    const renderNetwork = (event?: Event) => {
      if (navigator.onLine) return theO.removeAttribute('data-offline');
      const watching = event !== undefined && getComputedStyle(line).opacity === '1';
      theO.setAttribute('data-offline', watching ? 'now' : '');
      if (watching) setTimeout(() => theO.dataset.offline === 'now' && theO.setAttribute('data-offline', ''), 3000);
    };
    window.addEventListener('online', renderNetwork);
    window.addEventListener('offline', renderNetwork);
    renderNetwork();
  }
</script>
