---
// Renders a complete tool page from a single registry entry (see
// src/data/tools.js). The interactive island is passed in via the default slot
// so each page keeps its own explicit `client:load` import (and any per-tool
// props, e.g. unlock's intent). Everything else - SEO head, hero, content
// cards, footer - is driven by the `tool` object, so a page file is just:
//   const tool = toolsBySlug['merge'];
//   <ToolPageLayout tool={tool}><PdfMergeTool client:load /></ToolPageLayout>
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import ToolHero from '../components/ToolHero.astro';
import AppBar from '../components/AppBar.astro';
import TrustChips from '../components/TrustChips.astro';
import ToolLanguagesCard from '../components/ToolLanguagesCard.astro';
import ToolAboutCard from '../components/ToolAboutCard.astro';
import ToolExamplesCard from '../components/ToolExamplesCard.astro';
import ToolFaqCard from '../components/ToolFaqCard.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import Footer from '../components/Footer.astro';
import OfflineProof from '../components/OfflineProof.astro';
import LocalePackRequest from '../components/LocalePackRequest.astro';
import { documentationShellMessages, type DocumentationShellMessages } from '../i18n/documentationMessages';
import { getLocalizedToolContext, getPublishedEditionPaths } from '../i18n/localizedTools';
import { registerToolPageStyles } from '../site-lib/inlineStyles';
import { ratingForPage, ratingText } from '../site-lib/ratingAggregate';
import '../styles/toolPage.css';

interface Variant {
  locale?: string;
  lang?: string;
  path?: string;
  href?: string;
  label?: string;
  nativeName?: string;
  isCurrent?: boolean;
}

interface Props {
  tool: any;
  // LOC-02: every prop below defaults so the nine existing English tool pages
  // (<ToolPageLayout tool={tool}><Island client:load /></ToolPageLayout>, no
  // other props) render byte-identical to before this ticket.
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  noindex?: boolean;
  locale?: string;
  variants?: Variant[];
  preview?: boolean;
  messages?: DocumentationShellMessages;
  previewNotice?: string;
  /** True when this locale's edition has no reviewed island message
   * catalogue yet (see LOCALIZED_TOOL_ISLANDS in src/i18n/localizedTools.ts) -
   * the Sign/Redact "editor stays English" pilot decision, generalized. */
  toolControlsEnglish?: boolean;
}

const {
  tool,
  lang = 'en',
  dir = 'ltr',
  canonical,
  noindex = false,
  locale = 'en',
  preview = false,
  messages = documentationShellMessages.en!,
  previewNotice,
  toolControlsEnglish = false,
}: Props = Astro.props;

// The nine English pages pass neither `alternates` nor `variants`, and they
// still have to carry the reciprocal hreflang set and the footer switcher
// once a localized edition is published (LOC-02 guard 1: every hreflang
// group is reciprocal). Resolve both from the registry here rather than
// making each page file know about localization. The localized route passes
// its own, computed from the same function.
const resolved = await getLocalizedToolContext(tool.slug, locale);
const alternates = Astro.props.alternates ?? resolved.alternates;
const variants = Astro.props.variants ?? resolved.variants;
// Sign and Redact are the editors. They share the desktop first screen of the page-grid tools (HERO-05),
// but only on an empty desktop stage (see `data-editor` below).
// SEO-46: a real aggregate from the build-time read, or null (offline build, store down, under the minimum).
const rating = await ratingForPage(tool.slug);
// English-only like the languages card: the figures' captions are English.
const showExamples = Boolean(tool.examples) && locale === 'en';
if (showExamples) registerToolPageStyles(Astro.csp, tool);
const isEditor = tool.slug === 'sign' || tool.slug === 'redact';
// Which other pages exist in this edition, so the two card grids below can
// link to the localized page where there is one and mark the rest EN.
const editionPaths = locale === 'en' ? [] : await getPublishedEditionPaths(locale as any);
---

<BaseLayout
  title={tool.seoTitle}
  description={tool.seoDescription}
  lang={lang}
  dir={dir}
  canonical={canonical}
  alternates={alternates}
  noindex={noindex}
  socialImageAlt={messages.socialImageAlt}
>
  <Fragment slot="head">
    <SeoSchema name={tool.schemaName} description={tool.seoDescription} faq={tool.faq} rating={rating} />

    {/* Pre-collapses the marketing hero (see ToolHero.astro) for a returning
        visitor who has a saved Sign/Redact draft, before the async IndexedDB
        restore and Preact hydration would otherwise do it later and register
        as a real, input-less layout shift. Also applies the persisted view
        density (see useViewDensity.js) before first paint, for the same
        reason: without it, the density-driven collapse would only land once
        the Sign/Redact island hydrates and reads localStorage itself. Must be
        a blocking, unprocessed script — a bundled Astro <script> compiles to
        type="module", which is always deferred and runs after the body has
        already parsed, too late to prevent the flash this exists to avoid.
        That means `is:inline` (CLAUDE.md's CSP section), which Astro does not
        auto-hash: the hash below in astro.config.mjs's
        security.csp.scriptDirective.hashes is computed by hand and WILL
        silently stop matching — breaking every tool page's CSP — if this
        script's text changes by even one byte. If you edit it, rebuild,
        extract the exact text Astro emits, and recompute (the marker must be
        something that appears ONLY inside this script — 'view-density' alone
        also appears in ToolHero.astro's inlined CSS, in the same <head>):
          node -e "const f=require('fs'),c=require('crypto');const h=f.readFileSync('dist/sign/index.html','utf8');const i=h.indexOf(\"getItem('pdf-toolkit:view-density')\");const s=h.lastIndexOf('<script>',i);const e=h.indexOf('</script>',s);console.log('sha256-'+c.createHash('sha256').update(h.slice(s+8,e),'utf8').digest('base64'))"
        then paste the result in astro.config.mjs, and confirm the same hash
        is produced for dist/redact/index.html and dist/merge/index.html.

        No tool.slug interpolation on purpose: every tool page must emit this
        exact same script text so one hash covers all of them. The slug comes
        from location.pathname at runtime instead - the LAST path segment,
        not every slash stripped out, so a locale prefix never leaks into the
        key (LOC-02: `/he/sign/` must read the same draft hint as `/sign/`,
        not look up a key under 'hesign' that nothing ever writes). Tools with
        no draft feature (merge, split, ...) just look up a key that's never
        set — harmless.

        The last check reads the hand-off marker `saveHandoff` leaves in
        sessionStorage (src/lib/handoffPending.ts, HERO-02): a hand-off is in
        IndexedDB, which this script cannot read, so the key is how the page
        knows a file is about to arrive. useHandoffIntake clears it.

        Comments go here, never inside the script: its text ships verbatim to
        every tool page. One that used to live there, on the catch around the
        recent-files read: the entry index is an optimisation, not the source
        of truth. Keep the pre-paint restore guard when it is corrupt; the
        IndexedDB restore will promptly clear a stale pointer before any hidden
        empty state can become visible. */}
    <script is:inline>
      (function () {
        try {
          var segments = location.pathname.split('/').filter(Boolean);
          var slug = segments[segments.length - 1] || '';
          var density = localStorage.getItem('pdf-toolkit:view-density') || 'condensed';
          document.documentElement.setAttribute('data-view-density', density);
          var entryId = localStorage.getItem('pdf-toolkit:workspace:current:' + slug);
          var currentEntryIsKnown = false;
          if (entryId) {
            try {
              var recentFiles = JSON.parse(localStorage.getItem('pdf-toolkit:workspace:recent-files') || '[]');
              currentEntryIsKnown = Array.isArray(recentFiles) && recentFiles.some(function (entry) { return entry && entry.id === entryId; });
            } catch (e) {
              currentEntryIsKnown = true;
            }
          }
          if (currentEntryIsKnown) {
            document.documentElement.setAttribute('data-draft-hint', '1');
            if (slug === 'sign' || slug === 'redact') {
              document.documentElement.setAttribute('data-editor-restore', '1');
            } else if (slug === 'merge') {
              document.documentElement.setAttribute('data-merge-restore', '1');
            }
          }
          if (sessionStorage.getItem('pdkef:handoff-pending:' + slug)) {
            document.documentElement.setAttribute('data-handoff-pending', '1');
          }
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <AppBar toolName={tool.toolName} labels={messages} locale={locale}>
    {/* The same three chips, from the same component, as the home page's bar. */}
    <TrustChips labels={messages} />
  </AppBar>

  {preview && (
    <aside class="mx-auto mt-4 max-w-[720px] rounded-[var(--radius-md)] border border-[var(--color-primary-tint)] bg-[var(--color-primary-soft)] px-4 py-3 text-center text-[0.9rem] text-[var(--color-text)]" role="status">
      {previewNotice ?? messages.previewNotice}
    </aside>
  )}

  {/* The hero and the tool card flow at their own height. This wrapper used
      to carry `min-h-[calc(100svh-3.5rem)]` and #app below used to centre
      its content vertically under 1024px, holding the hero+card area to one
      viewport tall: measured on a production build that put 310 to 460px of
      blank space between the card and "How it works" at 1280x900 (more on a
      taller screen), and on a phone it made a short pre-result card
      (/compress-image/'s Target Size panel, before the full-height sheet) jump ~108px up the moment a
      result made the page tall enough to stop being centred (see
      backlog/tasks/SEO-25.md). Nothing else leaned on that height: ToolHero's
      condensing keys off its own data attributes and OfflineProof renders
      after this wrapper closes. e2e/tool-layout.spec.js guards both. */}
  <div class="tool-stage flex flex-col" data-layout="hero" data-tool-slug={tool.slug} data-editor={isEditor || undefined}>
    <ToolHero icon={tool.icon} title={tool.h1} titleName={tool.h1Name} subhead={tool.subhead} subheadAccent={messages.heroAccent} slug={tool.slug} condensable={tool.condenseOnLoad !== false} phoneCondensed={tool.heroPhoneCondensed === true} condenseOnLoad />

    {/* !max-w-[1280px] overrides global.css's bare `main { max-width: 1400px }`
        (still 1400 for every other page type - content guides, licenses,
        404 - which never asked to match home). Keeps this tool's drop
        zone/card area the same width as the app bar and hero above it, now
        that both moved to home's 1280px. */}
    <main class="!flex !flex-col !max-w-[1280px] !px-4 !pb-4 min-[560px]:!px-6 min-[768px]:!pb-5">
      <section id="app" class="!my-0 !flex !w-full !items-start !justify-center min-[1024px]:!justify-start" aria-label={tool.ariaLabel}>
        {/* LOC-02: the Sign/Redact "editor stays English" pilot decision
            (LOCALIZED_TOOL_ISLANDS in localizedTools.ts) still needs honest
            disclosure, and data-tool-controls-english on this text is what
            scripts/localizedSeoChecks.mjs keys off to exclude #app from the
            page's Hebrew language-purity score - removing this marker
            entirely mis-scores every Sign/Redact localized page as if its
            English UI were an untranslated incumbent. Previously a large
            visible paragraph above the dropzone; that took disproportionate
            space for what it said, so it's sr-only now - still reaches a
            screen reader, costs sighted visitors nothing. */}
        {toolControlsEnglish && (
          <p class="sr-only" data-tool-controls-english>{messages.toolControlsEnglishNotice}</p>
        )}
        <slot />
      </section>
    </main>

    {/* The airplane-mode line sits below the card for every tool, so it moves
        nothing the first screen has already laid out. The desktop empty-state
        grid places it by its `data-airplane-note` marker; the editors also carry
        `data-tool-restore-followup`, which hides it while a restore is pending.
        It stays a bare <p>: e2e/tool-layout.spec.js's `body > div > div` locator
        must keep resolving to the app bar only. */}
    <p data-tool-restore-followup={isEditor ? '' : undefined} data-airplane-note class="type-body mx-auto w-full max-w-[1280px] px-4 pb-1 text-center text-[var(--color-muted)] min-[560px]:px-6">
      {messages.airplaneModeNotice}
    </p>
    <a data-how-link href="#how-it-works" class="text-[var(--color-primary-text)]">
      {messages.howItWorks}
      <svg aria-hidden="true" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"><path d="M8 3v10M3.5 8.5 8 13l4.5-4.5" /></svg>
    </a>
  </div>

  <style>
    /* QUAL-13: the home hero's off-white-to-mint gradient on every tool page's
       stage. Pixel stops, because on the document-tall editor stage (Sign,
       Redact) the fade has to finish around where the tool card begins and
       stay mint below it; 480px sits within a few pixels of the card's top
       edge across the hero states measured. `background-color` is the
       fallback for a browser that cannot parse `color-mix`. */
    .tool-stage {
      background-color: var(--color-primary-tint);
      background-image: linear-gradient(180deg, var(--color-bg) 0, color-mix(in srgb, var(--color-bg) 60%, var(--color-primary-tint)) 260px, var(--color-primary-tint) 480px);
    }

    /* HERO-01: the one-screen page-grid first screen (data-layout='hero') is
       as tall as the stage, so its stops follow the stage's own height: fade in
       from the page colour, hold mint through the middle where the tool sits,
       and fade back to the page colour at the bottom edge, leaving no seam
       against the page below. Sign and Redact (`data-editor`) keep the pixel stops
       above everywhere but their desktop empty state, which takes the same
       height-relative gradient under the first-screen gate further down. */
    .tool-stage[data-layout='hero']:not([data-editor]) {
      --stage-mint: color-mix(in srgb, var(--color-primary-tint) 70%, var(--color-bg));
      background-color: var(--color-bg);
      background-image: linear-gradient(180deg, var(--color-bg) 0, var(--stage-mint) 40%, var(--stage-mint) 70%, var(--color-bg) 100%);
    }

    /* A tool normally flows at its own height: SEO-25 deliberately removed a
       viewport-tall wrapper because it left up to 460px of blank space below
       a short card, and the mobile layout must never vertically centre one.

       Saved work is a different first-paint state. The inline head script
       knows synchronously that a local entry may be restored and sets
       `data-draft-hint` before the browser paints. Sign and Redact then load
       the actual PDF and editor asynchronously. Without the reservation
       below, that loaded editor grows after first paint and pushes every
       server-rendered section below it down the page - a severe CLS event.
       Keep the old viewport/flex geometry only during this hinted restore.
       A stale hint clears itself once IndexedDB says there is no entry, and a
       fresh visitor never receives the attribute, so neither path gains blank
       space. */
    /* The phone first screen reaches the bottom edge: the stage is at least the visible
       screen under the 3.5rem app bar, so the next section's page colour never shows as
       a band under a short tool. Content stays top-aligned; a taller stage (Sign,
       Compress) is untouched. Phones only: e2e/tool-layout.spec.js keeps the editors
       close to the section below at 1000px. */
    @media (max-width: 767.98px) {
      .tool-stage {
        min-height: calc(100svh - 3.5rem);
      }

      /* main grows by default, which took the extra height and pushed the airplane
         line to the screen's foot, a gap under the card; with nothing loaded the
         line stays under the card and the mint fills the rest. */
      .tool-stage:not([data-editor]):not(:has([data-tool-loaded], [data-tool-shell])) > main {
        flex-grow: 0;
      }
    }

    @media (min-width: 1024px) {
      :global(html[data-draft-hint]) .tool-stage {
        min-height: calc(100svh - 3.5rem);
      }

      :global(html[data-draft-hint]) .tool-stage main,
      :global(html[data-draft-hint]) .tool-stage #app,
      :global(html[data-draft-hint]) .tool-stage #app > astro-island {
        display: flex;
        flex: 1 1 auto;
        flex-direction: column;
        min-height: 0;
      }
    }

    /* HERO-01: the desktop first screen. While the island shows its empty
       state, and no saved work is restoring (`data-draft-hint` keeps the
       reserved flex geometry above; `data-merge-restore` keeps Merge's
       restore in the stacked layout it lands in), the stage is one screen tall: the hero
       on the start side, the tool on the other, the airplane line and the
       How it works link as a footer row. Sign and Redact (HERO-05) carry
       `data-layout='hero'` at every width because the static HTML is one
       document, so every `[data-layout='hero']` rule is either gated to this
       desktop empty state or excludes `[data-editor]`: below 1024px, loaded and
       restoring, they look as they did before. The children are placed
       on the grid rather than wrapped, so the app bar stays the only
       `body > div > div` (e2e/tool-layout.spec.js). These rules are
       unlayered, so they beat the utilities on the hero and the airplane
       line (see <main> below for the exception). The link is hidden everywhere else. */
    .tool-stage [data-how-link] {
      display: none;
    }

    /* A file is over the window: the stage turns mint and takes a primary
       border, at every width. The island only sets [data-dragging]. */
    .tool-stage[data-layout='hero']:not([data-editor]):has([data-dragging]) {
      --stage-mint: var(--color-primary-tint);
      box-shadow: inset 0 0 0 3px var(--color-primary);
    }

    @media (min-width: 1024px) {
      .tool-stage {
        --first-screen: clamp(600px, calc(100svh - 3.5rem), 900px);
      }

      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-layout='hero']:not(:has([data-tool-loaded], [data-tool-shell])) {
        display: grid;
        grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
        /* Row 1 is the first screen's own height (block padding 2.5rem, footer 2.5rem),
           so the hero centres in it whatever <main> does. <main> spans rows 1-2: row 2
           is 0 unless the tool column is taller than row 1, then it takes the excess,
           so <main> starts at the top and the footer row follows it. */
        grid-template-rows: calc(var(--first-screen) - 5rem) auto 2.5rem;
        column-gap: 3.5rem;
        min-height: var(--first-screen);
        padding-block: 1.5rem 1rem;
        padding-inline: max(2rem, calc((100% - 1280px) / 2 + 2rem));
      }

      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-layout='hero']:not(:has([data-tool-loaded], [data-tool-shell])) > :global(.tool-hero) {
        grid-column: 1;
        grid-row: 1;
        align-self: center;
        max-width: none;
        margin: 0;
        padding: 0;
      }

      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-layout='hero']:not(:has([data-tool-loaded], [data-tool-shell])) > main {
        grid-column: 2;
        grid-row: 1 / 3;
        /* Top-aligned: <main> is a few px tall until the island's markup is parsed,
           and a centred box moved (0.07 CLS on a slow machine) when the sheet arrived. */
        align-self: start;
        /* <main>'s utilities are `!important` and sit in a layer, and for
           important declarations the layered ones win, so its 1.5rem side and
           1.25rem bottom padding cannot be zeroed here. Negative margins take
           them back, so the island's edge is the column's edge. global.css's
           `main { width: 100% }` would pin the width to the column and leave the
           box 48px short of its end edge, so the width is auto here. */
        margin-inline: -1.5rem;
        margin-bottom: -1.25rem;
        /* Still top-aligned, but pushed down by the gap that centres a 36rem sheet in
           row 1 (Dropzone.module.css: min-height min(36rem, first screen - 9rem); where
           that is shorter, Merge's content is taller, so 36rem is the safe height and the
           margin is 0 whenever row 1 is not taller than that). It reads only the viewport,
           never the content, so nothing moves while <main> parses. */
        margin-top: max(0px, calc((var(--first-screen) - 5rem - 36rem) / 2));
        width: auto;
      }

      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-layout='hero']:not(:has([data-tool-loaded], [data-tool-shell])) > [data-airplane-note] {
        grid-column: 1;
        grid-row: 3;
        align-self: center;
        max-width: none;
        margin: 0;
        padding: 0;
        text-align: start;
      }

      /* The editors' desktop empty state takes the page-grid gradient: the old 480px
         mint stop would show a seam against a stage one screen tall. */
      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-editor]:not(:has([data-tool-loaded], [data-tool-shell])) {
        --stage-mint: color-mix(in srgb, var(--color-primary-tint) 70%, var(--color-bg));
        background-color: var(--color-bg);
        background-image: linear-gradient(180deg, var(--color-bg) 0, var(--stage-mint) 40%, var(--stage-mint) 70%, var(--color-bg) 100%);
      }

      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-editor]:not(:has([data-tool-loaded], [data-tool-shell])):has([data-dragging]) {
        --stage-mint: var(--color-primary-tint);
        box-shadow: inset 0 0 0 3px var(--color-primary);
      }

      :global(html:not([data-draft-hint], [data-merge-restore], [data-handoff-pending])) .tool-stage[data-layout='hero']:not(:has([data-tool-loaded], [data-tool-shell])) > [data-how-link] {
        display: inline-flex;
        grid-column: 2;
        grid-row: 3;
        align-items: center;
        gap: 0.4rem;
        justify-self: end;
      }
    }

    /* A restored editor has an inherently document-sized body: one A4 page
       can be taller than the viewport, and a multi-page PDF taller still.
       A fixed min-height can only move that later shift; it cannot eliminate
       it. Do not paint the temporary empty card or the static content stream
       below it while Sign/Redact reconstruct saved work. The nearby
       airplane-mode note follows the same rule. They remain in layout (so
       their final geometry is already resolved) but are invisible until the
       real editor shell exists. Visibility, rather than display, preserves
       each component's native layout and prevents a card flashing at one
       coordinate then moving to another.

       `data-editor-restore` is deliberately Sign/Redact-only. Merge shares
       `data-draft-hint` but has a different loaded shell. A failed or stale
       restore removes both markers in useDraftPersistence, revealing the
       ordinary empty state. */
    :global(html[data-editor-restore]) .tool-stage [data-tool-restore-followup],
    :global(html[data-editor-restore]) .tool-stage main,
    :global(html[data-editor-restore]) [data-tool-followups] {
      visibility: hidden;
    }

    :global(html[data-editor-restore]:has([data-tool-shell])) .tool-stage [data-tool-restore-followup],
    :global(html[data-editor-restore]:has([data-tool-shell])) .tool-stage main,
    :global(html[data-editor-restore]:has([data-tool-shell])) [data-tool-followups] {
      visibility: visible;
    }

    /* Merge restores a saved *set* of source PDFs. Its file list and page
       grid arrive after the lightweight persistence island, so reserving a
       short dropzone alone still lets that temporary UI be replaced by a
       document-sized workspace. Keep both the temporary card and the static
       stream below it out of paint until the actual grid has mounted. Unlike
       Sign/Redact this is not an editor shell and intentionally has its own
       marker and readiness signal. A stale pointer releases immediately in
       PdfMergeTool once the restore check returns with no files. */
    :global(html[data-merge-restore]) .tool-stage main,
    :global(html[data-merge-restore]) [data-tool-followups],
    :global(html[data-merge-restore]) [data-airplane-note] {
      visibility: hidden;
    }

    :global(html[data-merge-restore]:has([data-merge-workspace-ready])) .tool-stage main,
    :global(html[data-merge-restore]:has([data-merge-workspace-ready])) [data-tool-followups],
    :global(html[data-merge-restore]:has([data-merge-workspace-ready])) [data-airplane-note] {
      visibility: visible;
    }

    /* A hand-off is on its way (HERO-02, src/lib/handoffPending.ts): the page
       behaves like a Merge restore. The desktop grid is off and the hero is
       condensed from first paint (ToolHero.astro), and the empty sheet, the
       static stream and the airplane line stay out of paint until the tool
       shows its file, so nothing is painted that the arriving file replaces.
       useHandoffIntake removes the attribute once the tool has a file, or
       at once when there was nothing to consume (a stale key).

       Safety net with no JS: if the island never loads (an uncached chunk
       offline, a script error) nothing removes the attribute, so the hidden
       parts run an animation that flips them back to visible after 6s. The
       tool's own 8s release cap only starts once a file was read. */
    :global(html[data-handoff-pending]) .tool-stage main,
    :global(html[data-handoff-pending]) [data-tool-followups],
    :global(html[data-handoff-pending]) [data-airplane-note] {
      visibility: hidden;
      animation-name: handoff-pending-reveal;
      animation-duration: 0s;
      animation-delay: 6s;
      animation-timing-function: linear;
      animation-fill-mode: forwards;
    }

    @keyframes handoff-pending-reveal {
      to {
        visibility: visible;
      }
    }

    :global(html[data-handoff-pending]:has([data-tool-loaded], [data-tool-shell])) .tool-stage main,
    :global(html[data-handoff-pending]:has([data-tool-loaded], [data-tool-shell])) [data-tool-followups],
    :global(html[data-handoff-pending]:has([data-tool-loaded], [data-tool-shell])) [data-airplane-note] {
      visibility: visible;
    }

    /* Merge has no ToolShell, so its compact hero cannot use ToolHero's
       generic `[data-tool-shell]` loaded-state selector. Match the
       synchronous restore marker and the restored workspace's stable marker
       here, in the page layout that owns both, so 900px restores do not
       expand the hero after the hint is cleared.

       The whole selector is `:global()`: the hero is ToolHero.astro's
       element and carries that component's scope attribute, so a scoped
       `.tool-hero` written here compiles to a selector nothing matches
       (QUAL-10 measured the hero dropping 32px at 900px for exactly that). */
    @media (max-width: 1023px) {
      :global(html[data-view-density='condensed'][data-merge-restore] .tool-hero[data-hero-condensable]),
      :global(html[data-view-density='condensed']:has([data-merge-restored-workspace]) .tool-hero[data-hero-condensable]) {
        padding-top: 1.5rem;
        padding-bottom: 0.75rem;
      }

      :global(html[data-view-density='condensed'][data-merge-restore] .tool-hero[data-hero-condensable] [data-hero-sub]),
      :global(html[data-view-density='condensed']:has([data-merge-restored-workspace]) .tool-hero[data-hero-condensable] [data-hero-sub]) {
        display: none;
      }
    }

  </style>

  <div data-tool-followups>
  {/* SEO-10: the no-limit fact, stated where a visitor scanning the SERP
      result actually lands, not buried in the FAQ below the tool. Kept to
      one plain sentence, no badge: state the fact, then the one honest
      caveat, no intensifiers, no competitor. HERO-01 moved it here from the
      first screen, which the hero now keeps for the verb; [data-tool-followups]
      is already held hidden while a merge restore runs. English edition only
      (LOC-02): it is hardcoded English, and a localized edition's own
      freeNoteLead already states the no-limit fact in its language. */}
  {tool.slug === 'merge' && locale === 'en' && (
    <p data-merge-note class="mx-auto mb-4 w-full max-w-[1080px] px-6 text-center text-[0.88rem] leading-[1.5] text-[var(--color-muted)]">
      Combine as many files as you like. Nothing is uploaded, so there's nothing to meter, only your device's own memory.
    </p>
  )}

  {/* OfflineProof (DEMO-04): only Sign and Redact, the live status line
      only - see the component's own header comment for why the claim
      sentence is not rendered here anymore. */}
  {isEditor && <OfflineProof />}

  {/* Only Sign declares `languages` today; every other tool renders nothing
      here. It goes above "How it works" because "will my language come out
      right" is the question that decides whether the rest of the page
      matters.

      English edition only (LOC-03): the 20-language deep-dive table is not
      in TOOL_SOURCE_FIELDS (src/i18n/localizedTools.ts) - mergeLocalizedTool
      deliberately leaves `languages` structural, like sketches and icons,
      because translating 20 detailed technical claims about font/script
      coverage accurately needs the same native + technical review this
      whole file requires everywhere else, not a first pass. Rendering the
      English card unchanged on a localized page would be exactly the
      "Hebrew headline over an English tool" pattern the language-purity
      guard (scripts/localizedSeoChecks.mjs) exists to catch, so it is
      hidden rather than shipped untranslated; the RTL/Hebrew-font
      differentiator LOC-03.md asks this page to lead with instead lives in
      the translated subhead, aboutLead and FAQ (see he/sign.yaml). Revisit
      once the card itself has a reviewed translation. */}
  {tool.languages && locale === 'en' && <ToolLanguagesCard languages={tool.languages} />}

  {rating && (
    <p data-rating class="mx-auto mb-4 w-full max-w-[1080px] px-6 text-center text-[0.88rem] leading-[1.5] text-[var(--color-muted)]">
      {ratingText(messages.ratingLine, rating)}
    </p>
  )}

  <ToolAboutCard
    icon={tool.icon}
    heading={tool.aboutHeading}
    lead={tool.aboutLead}
    steps={tool.steps}
    freeNoteLead={tool.freeNoteLead}
    sketch={tool.aboutSketch}
    iconPos={tool.aboutIconPos}
    labels={messages}
  />

  {showExamples && <ToolExamplesCard examples={tool.examples} sketch={tool.aboutSketch} iconPos={tool.aboutIconPos} icon={tool.icon} />}

  <ToolFaqCard faq={tool.faq} sketch={tool.faqSketch} iconPos={tool.faqIconPos} labels={{ tag: messages.faqTag, heading: messages.faqHeading }} />

  <RelatedGuides currentSlug={tool.slug} locale={locale} labels={{ relatedHeading: messages.relatedHeading, inEnglish: messages.inEnglish }} editionPaths={editionPaths} />

  <ToolCrossLinks currentSlug={tool.slug} labels={messages} locale={locale} editionPaths={editionPaths} />

  <Footer variants={variants} locale={locale} labels={messages} />

  {locale !== 'en' && <LocalePackRequest locale={locale as any} />}
  </div>
</BaseLayout>
