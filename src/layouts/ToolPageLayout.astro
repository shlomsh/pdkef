---
// Renders a complete tool page from a single registry entry (see
// src/data/tools.js). The interactive island is passed in via the default slot
// so each page keeps its own explicit `client:load` import (and any per-tool
// props, e.g. unlock's intent). Everything else - SEO head, hero, content
// cards, footer - is driven by the `tool` object, so a page file is just:
//   const tool = toolsBySlug['merge'];
//   <ToolPageLayout tool={tool}><PdfMergeTool client:load /></ToolPageLayout>
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import ToolHero from '../components/ToolHero.astro';
import AppBar from '../components/AppBar.astro';
import TrustChips from '../components/TrustChips.astro';
import ToolLanguagesCard from '../components/ToolLanguagesCard.astro';
import ToolAboutCard from '../components/ToolAboutCard.astro';
import ToolFaqCard from '../components/ToolFaqCard.astro';
import RelatedGuides from '../components/RelatedGuides.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import Footer from '../components/Footer.astro';
import OfflineProof from '../components/OfflineProof.astro';
import LocalePackRequest from '../components/LocalePackRequest.astro';
import { documentationShellMessages, type DocumentationShellMessages } from '../i18n/documentationMessages';
import { getLocalizedToolContext, getPublishedEditionPaths } from '../i18n/localizedTools';
import '../styles/toolPage.css';

interface Variant {
  locale?: string;
  lang?: string;
  path?: string;
  href?: string;
  label?: string;
  nativeName?: string;
  isCurrent?: boolean;
}

interface Props {
  tool: any;
  // LOC-02: every prop below defaults so the nine existing English tool pages
  // (<ToolPageLayout tool={tool}><Island client:load /></ToolPageLayout>, no
  // other props) render byte-identical to before this ticket.
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  noindex?: boolean;
  locale?: string;
  variants?: Variant[];
  preview?: boolean;
  messages?: DocumentationShellMessages;
  previewNotice?: string;
  /** True when this locale's edition has no reviewed island message
   * catalogue yet (see LOCALIZED_TOOL_ISLANDS in src/i18n/localizedTools.ts) -
   * the Sign/Redact "editor stays English" pilot decision, generalized. */
  toolControlsEnglish?: boolean;
}

const {
  tool,
  lang = 'en',
  dir = 'ltr',
  canonical,
  noindex = false,
  locale = 'en',
  preview = false,
  messages = documentationShellMessages.en!,
  previewNotice,
  toolControlsEnglish = false,
}: Props = Astro.props;

// The nine English pages pass neither `alternates` nor `variants`, and they
// still have to carry the reciprocal hreflang set and the footer switcher
// once a localized edition is published (LOC-02 guard 1: every hreflang
// group is reciprocal). Resolve both from the registry here rather than
// making each page file know about localization. The localized route passes
// its own, computed from the same function.
const resolved = await getLocalizedToolContext(tool.slug, locale);
const alternates = Astro.props.alternates ?? resolved.alternates;
const variants = Astro.props.variants ?? resolved.variants;
// Which other pages exist in this edition, so the two card grids below can
// link to the localized page where there is one and mark the rest EN.
const editionPaths = locale === 'en' ? [] : await getPublishedEditionPaths(locale as any);
---

<BaseLayout
  title={tool.seoTitle}
  description={tool.seoDescription}
  lang={lang}
  dir={dir}
  canonical={canonical}
  alternates={alternates}
  noindex={noindex}
  socialImageAlt={messages.socialImageAlt}
>
  <Fragment slot="head">
    <SeoSchema name={tool.schemaName} description={tool.seoDescription} faq={tool.faq} />

    {/* Pre-collapses the marketing hero (see ToolHero.astro) for a returning
        visitor who has a saved Sign/Redact draft, before the async IndexedDB
        restore and Preact hydration would otherwise do it later and register
        as a real, input-less layout shift. Also applies the persisted view
        density (see useViewDensity.js) before first paint, for the same
        reason: without it, the density-driven collapse would only land once
        the Sign/Redact island hydrates and reads localStorage itself. Must be
        a blocking, unprocessed script — a bundled Astro <script> compiles to
        type="module", which is always deferred and runs after the body has
        already parsed, too late to prevent the flash this exists to avoid.
        That means `is:inline` (CLAUDE.md's CSP section), which Astro does not
        auto-hash: the hash below in astro.config.mjs's
        security.csp.scriptDirective.hashes is computed by hand and WILL
        silently stop matching — breaking every tool page's CSP — if this
        script's text changes by even one byte. If you edit it, rebuild,
        extract the exact text Astro emits, and recompute (the marker must be
        something that appears ONLY inside this script — 'view-density' alone
        also appears in ToolHero.astro's inlined CSS, in the same <head>):
          node -e "const f=require('fs'),c=require('crypto');const h=f.readFileSync('dist/sign/index.html','utf8');const i=h.indexOf(\"getItem('pdf-toolkit:view-density')\");const s=h.lastIndexOf('<script>',i);const e=h.indexOf('</script>',s);console.log('sha256-'+c.createHash('sha256').update(h.slice(s+8,e),'utf8').digest('base64'))"
        then paste the result in astro.config.mjs, and confirm the same hash
        is produced for dist/redact/index.html and dist/merge/index.html.

        No tool.slug interpolation on purpose: every tool page must emit this
        exact same script text so one hash covers all of them. The slug comes
        from location.pathname at runtime instead - the LAST path segment,
        not every slash stripped out, so a locale prefix never leaks into the
        key (LOC-02: `/he/sign/` must read the same draft hint as `/sign/`,
        not look up a key under 'hesign' that nothing ever writes). Tools with
        no draft feature (merge, split, ...) just look up a key that's never
        set — harmless. */}
    <script is:inline>
      (function () {
        try {
          var segments = location.pathname.split('/').filter(Boolean);
          var slug = segments[segments.length - 1] || '';
          var density = localStorage.getItem('pdf-toolkit:view-density') || 'condensed';
          document.documentElement.setAttribute('data-view-density', density);
          if (density === 'condensed' && localStorage.getItem('pdf-toolkit:workspace:has-draft:' + slug) === '1') {
            document.documentElement.setAttribute('data-draft-hint', '1');
          }
        } catch (e) {}
      })();
    </script>
  </Fragment>

  <AppBar toolName={tool.toolName} labels={messages} locale={locale}>
    {/* The same three chips, from the same component, as the home page's bar. */}
    <TrustChips labels={messages} />
  </AppBar>

  {preview && (
    <aside class="mx-auto mt-4 max-w-[720px] rounded-[var(--radius-md)] border border-[var(--color-primary-tint)] bg-[var(--color-primary-soft)] px-4 py-3 text-center text-[0.9rem] text-[var(--color-text)]" role="status">
      {previewNotice ?? messages.previewNotice}
    </aside>
  )}

  {/* The hero and the tool card flow at their own height. This wrapper used
      to carry `min-h-[calc(100svh-3.5rem)]` and #app below used to centre
      its content vertically under 1024px, holding the hero+card area to one
      viewport tall: measured on a production build that put 310 to 460px of
      blank space between the card and "How it works" at 1280x900 (more on a
      taller screen), and on a phone it made a short pre-result card
      (/compress-image/'s Target Size panel) jump ~108px up the moment a
      result made the page tall enough to stop being centred (see
      backlog/tasks/SEO-25.md). Nothing else leaned on that height: ToolHero's
      condensing keys off its own data attributes and OfflineProof renders
      after this wrapper closes. e2e/tool-layout.spec.js guards both. */}
  <div class="flex flex-col">
    <ToolHero icon={tool.icon} title={tool.h1} subhead={tool.subhead} slug={tool.slug} condensable={tool.condenseOnLoad !== false} />

    {/* The airplane-mode invitation (DEMO-04): the one idea in that ticket
        that isn't already said elsewhere on this page - the app bar's
        "On-device" badge and the dropzone's own "Private. Files never leave
        your device." already make the privacy claim itself, twice, closer
        to the moment it matters, so restating it a third time here read as
        a pitch and was cut (direction change, see DEMO-04.md). This wants
        to sit right next to the dropzone, but the dropzone (FileDropzone,
        rendered inside <main> below) is `client:only` and ships no
        build-time HTML - putting the invitation inside it would mean it
        never renders for a crawler and flashes in after hydration for a
        visitor. This is the nearest server-rendered spot, directly above
        where the dropzone appears. Kept to Sign and Redact only, same as
        the live status line below. */}
    {(tool.slug === 'sign' || tool.slug === 'redact') && (
      <p class="type-body mx-auto mb-4 max-w-[54rem] px-6 text-center text-[var(--color-muted)] min-[1024px]:mb-2 min-[1024px]:mt-0">
        {messages.airplaneModeNotice}
      </p>
    )}

    {/* SEO-10: the no-limit fact, stated where a visitor scanning the SERP
        result actually lands, not buried in the FAQ below the tool. Kept to
        one plain sentence, no badge, in the OfflineProof register: state the
        fact, then the one honest caveat, no intensifiers, no competitor.
        English edition only (LOC-02): it is hardcoded English, and a
        localized edition's own freeNoteLead already states the no-limit
        fact in its language; an English sentence in a Hebrew hero is the
        exact incumbent weakness LOC-01 documents. */}
    {tool.slug === 'merge' && locale === 'en' && (
      <p class="type-body mx-auto mb-4 max-w-[54rem] px-6 text-center text-[var(--color-muted)] min-[1024px]:mb-2 min-[1024px]:mt-0">
        Combine as many files as you like. Nothing is uploaded, so there's nothing to meter, only your device's own memory.
      </p>
    )}

    {/* !max-w-[1280px] overrides global.css's bare `main { max-width: 1400px }`
        (still 1400 for every other page type - content guides, licenses,
        404 - which never asked to match home). Keeps this tool's drop
        zone/card area the same width as the app bar and hero above it, now
        that both moved to home's 1280px. */}
    <main class="!flex !flex-col !max-w-[1280px] !px-4 !pb-4 min-[560px]:!px-6 min-[768px]:!pb-5">
      <section id="app" class="!my-0 !flex !w-full !items-start !justify-center min-[1024px]:!justify-start" aria-label={tool.ariaLabel}>
        {/* LOC-02: the Sign/Redact "editor stays English" pilot decision
            (LOCALIZED_TOOL_ISLANDS in localizedTools.ts) still needs honest
            disclosure, and data-tool-controls-english on this text is what
            scripts/localizedSeoChecks.mjs keys off to exclude #app from the
            page's Hebrew language-purity score - removing this marker
            entirely mis-scores every Sign/Redact localized page as if its
            English UI were an untranslated incumbent. Previously a large
            visible paragraph above the dropzone; that took disproportionate
            space for what it said, so it's sr-only now - still reaches a
            screen reader, costs sighted visitors nothing. */}
        {toolControlsEnglish && (
          <p class="sr-only" data-tool-controls-english>{messages.toolControlsEnglishNotice}</p>
        )}
        <slot />
      </section>
    </main>
  </div>

  {/* OfflineProof (DEMO-04): only Sign and Redact, the live status line
      only - see the component's own header comment for why the claim
      sentence is not rendered here anymore. */}
  {(tool.slug === 'sign' || tool.slug === 'redact') && <OfflineProof />}

  {/* Only Sign declares `languages` today; every other tool renders nothing
      here. It goes above "How it works" because "will my language come out
      right" is the question that decides whether the rest of the page
      matters.

      English edition only (LOC-03): the 20-language deep-dive table is not
      in TOOL_SOURCE_FIELDS (src/i18n/localizedTools.ts) - mergeLocalizedTool
      deliberately leaves `languages` structural, like sketches and icons,
      because translating 20 detailed technical claims about font/script
      coverage accurately needs the same native + technical review this
      whole file requires everywhere else, not a first pass. Rendering the
      English card unchanged on a localized page would be exactly the
      "Hebrew headline over an English tool" pattern the language-purity
      guard (scripts/localizedSeoChecks.mjs) exists to catch, so it is
      hidden rather than shipped untranslated; the RTL/Hebrew-font
      differentiator LOC-03.md asks this page to lead with instead lives in
      the translated subhead, aboutLead and FAQ (see he/sign.yaml). Revisit
      once the card itself has a reviewed translation. */}
  {tool.languages && locale === 'en' && <ToolLanguagesCard languages={tool.languages} />}

  <ToolAboutCard
    icon={tool.icon}
    heading={tool.aboutHeading}
    lead={tool.aboutLead}
    steps={tool.steps}
    freeNoteLead={tool.freeNoteLead}
    sketch={tool.aboutSketch}
    iconPos={tool.aboutIconPos}
    labels={messages}
  />

  <ToolFaqCard faq={tool.faq} sketch={tool.faqSketch} iconPos={tool.faqIconPos} labels={{ tag: messages.faqTag, heading: messages.faqHeading }} />

  <RelatedGuides currentSlug={tool.slug} locale={locale} labels={{ relatedHeading: messages.relatedHeading, inEnglish: messages.inEnglish }} editionPaths={editionPaths} />

  <ToolCrossLinks currentSlug={tool.slug} labels={messages} locale={locale} editionPaths={editionPaths} />

  <Footer variants={variants} locale={locale} labels={messages} />

  {locale !== 'en' && <LocalePackRequest locale={locale as any} />}
</BaseLayout>
