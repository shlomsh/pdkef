---
// Shared shell for the home page ("/" and, since LOC-09, "/he/" and future
// locale roots) - the same "heavy markup lives in the shared layout, thin
// page file per locale" pattern ToolPageLayout.astro/ContentPageLayout.astro
// already use for tools and guides. src/pages/index.astro renders this with
// the English homeContent object; src/pages/[locale]/index.astro renders it
// with a locale's merged content (mergeLocalizedHome). Extracted from what
// used to be one 990-line index.astro so a second locale did not mean an
// eighth near-identical home-page file (the exact thing CLAUDE.md's content-
// pages section already warns against for the SEO landing pages).
//
// Everything under "UI & State Invariants" in CLAUDE.md / .claude/rules/
// home-page.md - the one-canonical-DOM grid, the sticky pin math, the
// viewport-derived launcher row, the FileDropzone hydration-parity contract -
// is untouched by this extraction: the DOM shape, CSS and script below are
// copied verbatim from index.astro, only the copy itself is now read through
// the `home` prop instead of hardcoded.
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import HomeHero from '../components/home/HomeHero.astro';
import HomeInformation from '../components/home/HomeInformation.astro';
import LocalePackRequest from '../components/LocalePackRequest.astro';
import TheO from '../components/TheO.astro';
import '../styles/homePage.css';

import { listedTools } from '../data/tools.js';
import { documentationShellMessages, type DocumentationShellMessages } from '../i18n/documentationMessages';
import { getFileDropzoneMessages } from '../site-lib/fileDropzoneMessages';
import { getRecentFilesMessages } from '../site-lib/recentFilesMessages';
import { getLocalizedHomeContext } from '../i18n/localizedHome';
import { getPublishedEditionPaths } from '../i18n/localizedTools';
import { getToolCardCopy } from '../i18n/cardMessages';
import { documentationPath } from '../i18n/documentationLocales';
import { registerInlineStyle, theOStyle } from '../components/inlineStyles';

interface Variant {
  locale?: string;
  lang?: string;
  path?: string;
  href?: string;
  label?: string;
  nativeName?: string;
  isCurrent?: boolean;
}

interface Props {
  home: any;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  locale?: string;
  variants?: Variant[];
  messages?: DocumentationShellMessages;
  /** The name FileDropzone's practice-document caption uses for its
   * destination tool ("opens in {tool}") - defaults to the exact English
   * string the hardcoded caption always used, so the English page is
   * byte-identical to before this ticket. A localized route passes its own
   * localized Sign tool name (docs/home-page-localization-plan.md, section 2
   * row 21). */
  signToolDisplayName?: string;
}

const {
  home,
  lang = 'en',
  dir = 'ltr',
  canonical,
  locale = 'en',
  messages = documentationShellMessages.en!,
  signToolDisplayName = 'Sign & Fill',
}: Props = Astro.props;

// Same fallback ToolPageLayout.astro uses: a caller that already computed its
// own alternates/variants (the localized route) passes them explicitly, and
// the plain English page (index.astro, which historically passed neither)
// gets them resolved here instead - which is what makes the English root
// advertise a reciprocal hreflang="he" link once a Hebrew edition publishes,
// without index.astro needing to know that edition exists.
const resolvedHomeContext = await getLocalizedHomeContext(locale);
const alternates = Astro.props.alternates ?? resolvedHomeContext.alternates;
const variants = Astro.props.variants ?? resolvedHomeContext.variants;

const { title, description } = home;

// The O tells the founder story as the English page's scroll story; every
// other edition keeps the founder-story card until it has its own fourth beat
// (the ring is the O of "Open source"). See src/data/homeContent.js.
const showTheO = locale === 'en' && Boolean(home.theO);
// TheO.astro emits this style; the hash has to be registered before the <head> below is written.
if (showTheO) registerInlineStyle(Astro.csp, theOStyle);

// h1/h1Accent: see src/data/homeContent.js's header comment. h1Accent is
// validated (content.config.ts's localizedHome schema, and by construction
// for the English source) to be an exact trailing substring of h1, so this
// split can never render text that disagrees with home.h1.
const h1Prefix = home.h1.slice(0, home.h1.length - home.h1Accent.length);

const dropzoneMessages = getFileDropzoneMessages(locale as any);
const recentFilesMessages = getRecentFilesMessages(locale as any);

// The tool list (home grid + hero card) comes from the shared registry, so it
// stays in sync with the tool pages and the sitemap. Ordered by SEO priority.
// Keep the landing toolbar's priority distinct: Compress is intentionally the
// third shortcut without changing the shared registry or sitemap ordering.
//
// The home dock holds every listed tool (eleven cards; see the gap maths on `.home-dock`).
const homeToolsOrder = [...listedTools];
const compressToolIndex = homeToolsOrder.findIndex((tool) => tool.slug === 'compress');
if (compressToolIndex !== -1) {
  const [compressTool] = homeToolsOrder.splice(compressToolIndex, 1);
  homeToolsOrder.splice(2, 0, compressTool);
}

// Dock labels and links, localized the same way ToolCrossLinks.astro already
// localizes its own cross-link cards: getToolCardCopy(locale, slug) for the
// title/description (src/i18n/cardMessages.ts - every tool already has a
// reviewed Hebrew entry there), and documentationPath(slug, locale) for the
// href when that tool has a published edition in this locale, else the
// English href (never a URL that 404s). gridTitle/gridDescription still
// aren't in TOOL_SOURCE_FIELDS (design doc section 9, item 3) - this reuses
// the cross-link cards' existing, separate localization path instead of
// resolving that open question.
const dockEditionPaths = locale === 'en' ? [] : await getPublishedEditionPaths(locale as any);
const dockPublished = new Set(dockEditionPaths);
const homeTools = homeToolsOrder.map((tool) => {
  const copy = getToolCardCopy(locale, tool.slug);
  const localizedHref = locale === 'en' ? tool.href : documentationPath(tool.slug, locale as any);
  const href = dockPublished.has(localizedHref) ? localizedHref : tool.href;
  return {
    ...tool,
    href,
    gridTitle: copy?.title ?? tool.gridTitle,
    gridDescription: copy?.description ?? tool.gridDescription,
  };
});
// The launcher hands a dropped file to the same page the dock links to. Only
// a localized page needs the table; English keeps FileDropzone's `/${slug}/`
// default and its serialized island props unchanged.
const toolHrefs = locale === 'en' ? undefined : Object.fromEntries(homeTools.map((tool) => [tool.slug, tool.href]));
---

<BaseLayout title={title} description={description} lang={lang} dir={dir} canonical={canonical} alternates={alternates} socialImageAlt={messages.socialImageAlt}>
  <Fragment slot="head">
    <SeoSchema name="PDkef" description={description} faq={home.faq} />
    {/* The hero demo's handwritten caption ('Caveat Demo', or 'Gveret Levin
        Demo' in Hebrew - see HeroDemo.module.css) sits above the fold only
        on desktop - the mobile layout scrolls the demo past the first
        screen - so this is scoped to the same width the caption itself
        actually renders above the fold at, rather than making every phone
        visit pay for a font it never needs early. Only the locale's own
        caption font is preloaded; the other language's demo font is never
        requested by this page at all. */}
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href={dir === 'rtl' ? '/fonts/GveretLevinDemo-Regular.ttf' : '/fonts/CaveatDemo-Bold.ttf'}
      media="(min-width: 1024px)"
      crossorigin
    />
  </Fragment>

  <main id="home-content">
    <HomeHero h1Prefix={h1Prefix} h1Accent={home.h1Accent} subhead={home.subhead} dir={dir} locale={locale} messages={messages} homeTools={homeTools} dropzoneMessages={dropzoneMessages} recentFilesMessages={recentFilesMessages} signToolDisplayName={signToolDisplayName} toolHrefs={toolHrefs} />
    {showTheO && <TheO story={home.theO} />}
    <HomeInformation home={home} showTheO={showTheO} dir={dir} locale={locale} messages={messages} variants={variants} dropzoneMessages={dropzoneMessages} recentFilesMessages={recentFilesMessages} signToolDisplayName={signToolDisplayName} toolHrefs={toolHrefs} />
  </main>
  <script src="../site-lib/homeWorkspace.ts"></script>
  {locale !== 'en' && <LocalePackRequest locale={locale as any} />}
</BaseLayout>

<style>
  :global(html) { scroll-padding-top: 0; }
  :global(body) {
    /* AppBar.astro's [data-home-bar] is border-box with no explicit height:
       its inner row is the h-14 utility (3.5rem = 56px), but the bar element
       itself also carries border-b-[0.5px], so its rendered height is 56.5px,
       not 56px, in a real GPU-rendered browser. This is the first-paint
       default, not the only source of truth: homeWorkspace.ts measures
       [data-home-bar] at runtime and writes the same value back onto
       document.body, so a real browser sees no post-paint shift (the write is
       a no-op there) while an environment whose rendering disagrees with this
       constant - headless Chromium rounds the sub-device-pixel border up and
       renders the bar at 57px - gets corrected instead of staying wrong. See
       e2e/home/nav-height.spec.js, which asserts the resolved variable
       matches the bar's actual measured height. */
    --home-nav-height: calc(3.5rem + 0.5px);
    --home-footer-height: 0px;
    background: var(--color-bg);
  }
  #home-content { padding: 0; }
</style>
