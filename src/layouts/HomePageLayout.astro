---
// Shared shell for the home page ("/" and, since LOC-09, "/he/" and future
// locale roots) - the same "heavy markup lives in the shared layout, thin
// page file per locale" pattern ToolPageLayout.astro/ContentPageLayout.astro
// already use for tools and guides. src/pages/index.astro renders this with
// the English homeContent object; src/pages/[locale]/index.astro renders it
// with a locale's merged content (mergeLocalizedHome). Extracted from what
// used to be one 990-line index.astro so a second locale did not mean an
// eighth near-identical home-page file (the exact thing CLAUDE.md's content-
// pages section already warns against for the SEO landing pages).
//
// Everything under "UI & State Invariants" in CLAUDE.md / .claude/rules/
// home-page.md - the one-canonical-DOM grid, the sticky pin math, the
// viewport-derived launcher row, the FileDropzone hydration-parity contract -
// is untouched by this extraction: the DOM shape, CSS and script below are
// copied verbatim from index.astro, only the copy itself is now read through
// the `home` prop instead of hardcoded.
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CardDecor from '../components/CardDecor.astro';
import AppBar from '../components/AppBar.astro';
import HeroDemo from '../components/HeroDemo/HeroDemo.astro';
import OfflineProof from '../components/OfflineProof.astro';
import LocalePackRequest from '../components/LocalePackRequest.astro';
import '../styles/homePage.css';

import { Monitor, Smartphone, Compass, Sparkles, HardDriveDownload, WifiOff, HelpCircle, ShieldCheck, InfinityIcon, Lock, Code2, Type, PenLine, Trash2, Scale } from 'lucide-preact';
import { tools } from '../data/tools.js';
import FileDropzone from '../components/FileDropzone.tsx';
import { documentationShellMessages, type DocumentationShellMessages } from '../i18n/documentationMessages';
import { getFileDropzoneMessages, getRecentFilesMessages } from '../i18n/toolMessages';
import { getLocalizedHomeContext } from '../i18n/localizedHome';
import { getPublishedEditionPaths } from '../i18n/localizedTools';
import { getToolCardCopy } from '../i18n/cardMessages';
import { documentationPath } from '../i18n/documentationLocales';
import { renderInline } from '../lib/contentMarkup';

interface Variant {
  locale?: string;
  lang?: string;
  path?: string;
  href?: string;
  label?: string;
  nativeName?: string;
  isCurrent?: boolean;
}

interface Props {
  home: any;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  locale?: string;
  variants?: Variant[];
  messages?: DocumentationShellMessages;
  /** The name FileDropzone's practice-document caption uses for its
   * destination tool ("opens in {tool}") - defaults to the exact English
   * string the hardcoded caption always used, so the English page is
   * byte-identical to before this ticket. A localized route passes its own
   * localized Sign tool name (docs/home-page-localization-plan.md, section 2
   * row 21). */
  signToolDisplayName?: string;
}

const {
  home,
  lang = 'en',
  dir = 'ltr',
  canonical,
  locale = 'en',
  messages = documentationShellMessages.en!,
  signToolDisplayName = 'Sign & Fill',
}: Props = Astro.props;

// Same fallback ToolPageLayout.astro uses: a caller that already computed its
// own alternates/variants (the localized route) passes them explicitly, and
// the plain English page (index.astro, which historically passed neither)
// gets them resolved here instead - which is what makes the English root
// advertise a reciprocal hreflang="he" link once a Hebrew edition publishes,
// without index.astro needing to know that edition exists.
const resolvedHomeContext = await getLocalizedHomeContext(locale);
const alternates = Astro.props.alternates ?? resolvedHomeContext.alternates;
const variants = Astro.props.variants ?? resolvedHomeContext.variants;

const { title, description, faqKicker, faq, founderStory, draftPersistence, offlineInstall, privacyOpenSource, closing } = home;

// h1/h1Accent: see src/data/homeContent.js's header comment. h1Accent is
// validated (content.config.ts's localizedHome schema, and by construction
// for the English source) to be an exact trailing substring of h1, so this
// split can never render text that disagrees with home.h1.
const h1Prefix = home.h1.slice(0, home.h1.length - home.h1Accent.length);

const dropzoneMessages = getFileDropzoneMessages(locale as any);
const recentFilesMessages = getRecentFilesMessages(locale as any);

// The demo stays English regardless of locale (docs/home-page-localization-
// plan.md, section 4.2's RTL/direction-of-motion question is unresolved and
// explicitly out of scope for LOC-09) - shown with the same isolation-notice
// convention ToolPageLayout.astro uses for an untranslated tool island.
const heroDemoIsEnglishOnly = locale !== 'en';

// The tool list (home grid + hero card) comes from the shared registry, so it
// stays in sync with the tool pages and the sitemap. Ordered by SEO priority.
// Keep the landing toolbar's priority distinct: Compress is intentionally the
// third shortcut without changing the shared registry or sitemap ordering.
//
const homeToolsOrder = [...tools];
const compressToolIndex = homeToolsOrder.findIndex((tool) => tool.slug === 'compress');
if (compressToolIndex !== -1) {
  const [compressTool] = homeToolsOrder.splice(compressToolIndex, 1);
  homeToolsOrder.splice(2, 0, compressTool);
}

// Dock labels and links, localized the same way ToolCrossLinks.astro already
// localizes its own cross-link cards: getToolCardCopy(locale, slug) for the
// title/description (src/i18n/cardMessages.ts - every tool already has a
// reviewed Hebrew entry there), and documentationPath(slug, locale) for the
// href when that tool has a published edition in this locale, else the
// English href (never a URL that 404s). gridTitle/gridDescription still
// aren't in TOOL_SOURCE_FIELDS (design doc section 9, item 3) - this reuses
// the cross-link cards' existing, separate localization path instead of
// resolving that open question.
const dockEditionPaths = locale === 'en' ? [] : await getPublishedEditionPaths(locale as any);
const dockPublished = new Set(dockEditionPaths);
const homeTools = homeToolsOrder.map((tool) => {
  const copy = getToolCardCopy(locale, tool.slug);
  const localizedHref = locale === 'en' ? tool.href : documentationPath(tool.slug, locale as any);
  const href = dockPublished.has(localizedHref) ? localizedHref : tool.href;
  return {
    ...tool,
    href,
    gridTitle: copy?.title ?? tool.gridTitle,
    gridDescription: copy?.description ?? tool.gridDescription,
  };
});
---

<BaseLayout title={title} description={description} lang={lang} dir={dir} canonical={canonical} alternates={alternates} socialImageAlt={messages.socialImageAlt}>
  <Fragment slot="head">
    <SeoSchema name="PDkef" description={description} faq={faq} />
    {/* The hero demo's handwritten caption ('Caveat Demo', or 'Gveret Levin
        Demo' in Hebrew - see HeroDemo.module.css) sits above the fold only
        on desktop - the mobile layout scrolls the demo past the first
        screen - so this is scoped to the same width the caption itself
        actually renders above the fold at, rather than making every phone
        visit pay for a font it never needs early. Only the locale's own
        caption font is preloaded; the other language's demo font is never
        requested by this page at all. */}
    <link
      rel="preload"
      as="font"
      type="font/ttf"
      href={dir === 'rtl' ? '/fonts/GveretLevinDemo-Regular.ttf' : '/fonts/CaveatDemo-Bold.ttf'}
      media="(min-width: 1024px)"
      crossorigin
    />
  </Fragment>

  <main id="home-content">
    <div class="home-tour" id="home-tour" data-demo-track="desktop">
      <section class="home-hero" aria-labelledby="home-heading" data-demo-pin="desktop">
        <div class="home-header">
          <AppBar isHome locale={locale} labels={messages}>
            <a class="trust-chip" href="https://github.com/shlomsh/pdkef" target="_blank" rel="noopener noreferrer" aria-label={messages.starOnGithub}>
              <svg class="trust-chip-icon" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.79.62-3.38-1.37-3.38-1.37-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.34 9.34 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" /></svg>
              <span>{messages.starOnGithub}</span>
            </a>
            <a class="trust-chip" href="/licenses/" aria-label={messages.mitLicensed}><Scale class="trust-chip-icon" size={14} strokeWidth={1.9} aria-hidden="true" /><span>{messages.mitLicensed}</span></a>
            <a class="trust-chip" data-offline-link href="#offline-app" aria-label={messages.worksOffline}><WifiOff class="trust-chip-icon" size={14} strokeWidth={1.9} aria-hidden="true" /><span>{messages.worksOffline}</span></a>
          </AppBar>
          <header class="hero-header">
            <h1 id="home-heading">{h1Prefix}<span>{home.h1Accent}</span></h1>
            <p>{home.subhead}</p>
            {heroDemoIsEnglishOnly && (
              <p class="type-body hero-demo-english-notice" data-hero-demo-english-notice>{messages.heroDemoEnglishNotice}</p>
            )}
          </header>
        </div>
        {/* Source order is the mobile reading order: header, launcher, dock,
            then the demo. Desktop places the same four into a two-column grid
            with the demo beside the launcher, which is a purely visual
            arrangement - so a screen reader still meets the tools before a
            screen-tall decorative story, at both breakpoints. */}
        <div class="workspace-launcher home-workspace" id="home-files" data-working-area>
          {/* client:load, not client:only: a client:only island emits no HTML
              at build time, so the dropzone tile and the recent-documents
              card only existed once the Preact bundle had loaded and visibly
              arrived after the page had painted. Server-rendering the shell
              is only safe while FileDropzone's first client render matches it
              exactly - see the note on the `recents` state there, which is
              what keeps browser storage out of the render body. Reverting
              either half alone brings back the duplicate tiles of 203b204. */}
          <FileDropzone client:load toolTarget="sign" messages={dropzoneMessages} recentFilesMessages={recentFilesMessages} toolDisplayName={signToolDisplayName} />
        </div>
        <nav class="home-dock" aria-label="PDF tools">
            {homeTools.map((tool) => (
              <a href={tool.href} data-accent={tool.accent} class="app-card">
                <div class="app-tile">
                  <tool.icon strokeWidth={1.5} />
                </div>
                <div class="app-label">{tool.gridTitle}</div>
                <span class="app-tooltip">{tool.gridDescription}</span>
              </a>
            ))}
        </nav>
        <div class="demo-track" data-demo-track="mobile">
          <div class="home-frame" data-demo-frame data-demo-pin="mobile" data-working-area>
            <HeroDemo dir={dir} />
          </div>
        </div>
      </section>
    </div>
    <div id="home-information">
    <OfflineProof />
  <div class="card-stack">

      <FeatureCard class="relative isolate overflow-hidden">
        <CardDecor sketch="arcs" icon={Sparkles} iconPos="tr" iconSize={300} parallax />
        <div class="flex items-stretch gap-12 max-[768px]:flex-col max-[768px]:gap-8">
          <div class="min-w-0 flex-[1.2]">
            <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary-text)]">{founderStory.kicker}</span>
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">{founderStory.heading}</h2>
            <p class="type-lead space-content-row mt-0 max-w-[800px] text-[var(--color-text)]">
              {founderStory.paragraph1}
            </p>
            <p class="type-lead space-content-row mt-0 max-w-[800px] text-[var(--color-text)]">
              {founderStory.paragraph2}
            </p>
            <p class="type-body mt-0 max-w-[800px] text-[var(--color-muted)]">
              {founderStory.paragraph3}
            </p>
            <p class="mb-0 mt-5 text-[0.9rem] italic text-[var(--color-muted)]">
              <a class="font-semibold not-italic text-[var(--color-primary-text)] underline underline-offset-2 hover:text-[var(--color-primary-hover)]" href="https://github.com/shlomsh" target="_blank" rel="noopener noreferrer">Shlomi</a>
            </p>
          </div>
          <div class="flex flex-1 flex-col justify-center overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm">
            <div class="group flex items-center gap-4 px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary-text)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><InfinityIcon size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">{founderStory.pills[0].title}</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">{founderStory.pills[0].subtitle}</span>
              </div>
            </div>
            <div class="group flex items-center gap-4 border-t border-[var(--color-border)] px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary-text)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><Lock size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">{founderStory.pills[1].title}</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">{founderStory.pills[1].subtitle}</span>
              </div>
            </div>
            <div class="group flex items-center gap-4 border-t border-[var(--color-border)] px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary-text)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><Code2 size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">{founderStory.pills[2].title}</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">{founderStory.pills[2].subtitle}</span>
              </div>
            </div>
          </div>
        </div>
      </FeatureCard>

      <FeatureCard variant="highlight" class="relative isolate overflow-hidden">
        <CardDecor sketch="waves" icon={HardDriveDownload} iconPos="cr" iconSize={300} parallax />
        <div class="flex items-center gap-12 max-[768px]:flex-col-reverse max-[768px]:gap-8">
          <div class="relative flex min-h-[210px] w-full flex-[0.8] items-center justify-center py-4" aria-hidden="true">
            <div class="relative w-[290px] max-w-full rotate-[-1.5deg]">
              <div class="overflow-hidden rounded-[var(--radius-sm)] border-[1.5px] border-[var(--color-primary-soft)] bg-[var(--color-surface)] shadow-md">
                <div class="flex items-center gap-[0.3rem] border-b border-[var(--color-border)] bg-[var(--color-surface-soft)] px-3 py-[0.45rem]">
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="ms-2 h-1.5 w-16 rounded-full bg-[var(--color-border)]"></span>
                </div>
                <svg class="block w-full" viewBox="0 0 200 132" role="presentation" focusable="false">
                  <g class="fill-[var(--color-border)]">
                    <rect x="18" y="30" width="164" height="4" rx="2" />
                    <rect x="18" y="40" width="164" height="4" rx="2" />
                    <rect x="18" y="50" width="118" height="4" rx="2" />
                    <rect x="142" y="82" width="40" height="4" rx="2" />
                    <rect x="142" y="92" width="26" height="4" rx="2" />
                    <rect x="18" y="122" width="88" height="4" rx="2" />
                  </g>
                  <rect x="18" y="14" width="72" height="6" rx="3" class="fill-[var(--color-muted-light)]" />

                  <rect x="24" y="68" width="100" height="44" rx="6" class="fill-[var(--color-primary-soft)] stroke-[var(--color-primary)]" stroke-width="1.2" stroke-dasharray="4 3" stroke-opacity="0.55" />
                  <g fill="none" class="stroke-[var(--color-primary)]" stroke-linecap="round" stroke-linejoin="round">
                    <path
                      d="M 32 98 C 34 84, 40 74, 46 77 C 52 80, 44 92, 40 96 C 36 100, 46 100, 52 92 C 58 84, 62 90, 59 96 C 56 102, 64 100, 68 91 C 72 82, 77 87, 74 95 C 71 103, 80 100, 85 91 C 90 82, 96 86, 93 95 C 90 104, 99 101, 105 92"
                      stroke-width="2.2"
                    />
                    <path d="M 34 104 C 60 110, 88 107, 114 95" stroke-width="1.6" stroke-opacity="0.7" />
                  </g>
                  <g class="fill-[var(--color-surface)] stroke-[var(--color-primary)]" stroke-width="1.4">
                    <rect x="21" y="65" width="6" height="6" rx="1.5" />
                    <rect x="121" y="65" width="6" height="6" rx="1.5" />
                    <rect x="21" y="109" width="6" height="6" rx="1.5" />
                    <rect x="121" y="109" width="6" height="6" rx="1.5" />
                  </g>
                </svg>
              </div>

              <div class="absolute left-[14%] top-[54%] flex -translate-y-full items-center gap-[0.45rem] rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[0.5rem] py-[0.3rem] text-[var(--color-muted)] shadow-sm">
                <Type size={11} strokeWidth={2.2} />
                <PenLine size={11} strokeWidth={2.2} class="text-[var(--color-primary-text)]" />
                <span class="h-3 w-px bg-[var(--color-border)]"></span>
                <Trash2 size={11} strokeWidth={2.2} />
              </div>

              <div class="absolute -bottom-3 -right-3 inline-flex items-center gap-[0.35rem] rounded-[var(--radius-pill)] border border-[color-mix(in_srgb,var(--color-success)_20%,transparent)] bg-[var(--color-success-soft)] px-[0.6rem] py-[0.3rem] text-[0.7rem] font-semibold text-[var(--color-success)] shadow-sm">
                <span class="size-1.5 rounded-full bg-[var(--color-success)] animate-[pulse_2s_infinite]"></span>
                {draftPersistence.pill}
              </div>
            </div>
          </div>
          <div class="flex-[1.2]">
            <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary-text)]">{draftPersistence.kicker}</span>
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">{draftPersistence.heading}</h2>
            <p class="type-lead space-content-row mt-0 text-[var(--color-text)]">
              {draftPersistence.paragraph}
            </p>
            {/* 'inherit', not 'muted': this line's two tool names have always
                rendered as a bare <strong> inheriting the muted paragraph, and
                moving the string into homeContent.js must not restyle it. */}
            <p class="type-body m-0 text-[var(--color-muted)]" set:html={renderInline(draftPersistence.availability, 'inherit')} />
          </div>
        </div>
      </FeatureCard>

      <FeatureCard id="offline-app" class="relative isolate overflow-hidden">
        <CardDecor sketch="grid" icon={WifiOff} iconPos="br" iconSize={300} parallax />
        <div class="mx-auto mb-5 max-w-[750px] text-center">
          <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">{offlineInstall.heading}</h2>
          <p class="type-lead m-0 text-[var(--color-muted)]">{offlineInstall.lead}</p>
        </div>

        <div class="box-border mx-auto w-full max-w-[680px] overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm">
          <div class="flex border-b border-[var(--color-border)] bg-[var(--color-surface-soft)] max-[640px]:flex-col" role="tablist" aria-label="Device installation guides">
            <button class="offline-tab-btn active flex flex-1 items-center justify-center border-0 border-b-2 border-b-transparent bg-transparent p-4 text-[0.9rem] font-semibold text-[var(--color-muted)] transition-colors duration-200 ease-out hover:bg-[color-mix(in_srgb,var(--color-primary)_2%,transparent)] hover:text-[var(--color-text)] [&.active]:border-b-[var(--color-primary)] [&.active]:bg-[var(--color-surface)] [&.active]:text-[var(--color-primary-text)] max-[640px]:justify-start max-[640px]:border-b-0 max-[640px]:border-l-[3px] max-[640px]:border-l-transparent max-[640px]:px-5 max-[640px]:py-3 max-[640px]:[&.active]:border-l-[var(--color-primary)]" role="tab" aria-selected="true" aria-controls="guide-chrome" id="tab-chrome">
              <Monitor size={16} class="mr-2" />
              {offlineInstall.tabs[0].label}
            </button>
            <button class="offline-tab-btn flex flex-1 items-center justify-center border-0 border-b-2 border-b-transparent bg-transparent p-4 text-[0.9rem] font-semibold text-[var(--color-muted)] transition-colors duration-200 ease-out hover:bg-[color-mix(in_srgb,var(--color-primary)_2%,transparent)] hover:text-[var(--color-text)] [&.active]:border-b-[var(--color-primary)] [&.active]:bg-[var(--color-surface)] [&.active]:text-[var(--color-primary-text)] max-[640px]:justify-start max-[640px]:border-b-0 max-[640px]:border-l-[3px] max-[640px]:border-l-transparent max-[640px]:px-5 max-[640px]:py-3 max-[640px]:[&.active]:border-l-[var(--color-primary)]" role="tab" aria-selected="false" aria-controls="guide-ios" id="tab-ios">
              <Smartphone size={16} class="mr-2" />
              {offlineInstall.tabs[1].label}
            </button>
            <button class="offline-tab-btn flex flex-1 items-center justify-center border-0 border-b-2 border-b-transparent bg-transparent p-4 text-[0.9rem] font-semibold text-[var(--color-muted)] transition-colors duration-200 ease-out hover:bg-[color-mix(in_srgb,var(--color-primary)_2%,transparent)] hover:text-[var(--color-text)] [&.active]:border-b-[var(--color-primary)] [&.active]:bg-[var(--color-surface)] [&.active]:text-[var(--color-primary-text)] max-[640px]:justify-start max-[640px]:border-b-0 max-[640px]:border-l-[3px] max-[640px]:border-l-transparent max-[640px]:px-5 max-[640px]:py-3 max-[640px]:[&.active]:border-l-[var(--color-primary)]" role="tab" aria-selected="false" aria-controls="guide-safari" id="tab-safari">
              <Compass size={16} class="mr-2" />
              {offlineInstall.tabs[2].label}
            </button>
          </div>

          <div class="p-5">
            <div class="offline-tab-panel active hidden [&.active]:block" id="guide-chrome" role="tabpanel" aria-labelledby="tab-chrome">
              <ol class="m-0 flex list-none flex-col gap-3 p-0">
                {offlineInstall.tabs[0].steps.map((step: string, index: number) => (
                  <li class="flex items-start gap-4">
                    <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary-text)]">{index + 1}</span>
