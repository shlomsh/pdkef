---
import { getImage } from 'astro:assets';
import ogImageSrc from '../assets/og-image.jpg';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  socialImageAlt?: string;
}

const { title, description, noindex = false, lang = 'en', dir = 'ltr', canonical, alternates = [], socialImageAlt = 'PDkef - free PDF tools that run entirely in your browser.' } = Astro.props;
const canonicalURL = canonical ? new URL(canonical, Astro.site) : new URL(Astro.url.pathname, Astro.site);

// The social card, run through Astro's image pipeline rather than served raw
// from public/. Two reasons it goes through getImage() instead of a plain
// import: a plain import only hashes the file, it does not re-encode it (the
// original was a 34KB baseline JPEG for a 1200x630 card), and the returned
// object carries the real width/height, so the og:image:* tags below cannot
// drift from the file the way hand-written dimensions do.
//
// Format is pinned to jpeg on purpose. Astro's default output is WebP, which
// several social crawlers still refuse to render - a card that silently shows
// nothing on LinkedIn or Slack is a worse outcome than a slightly larger file.
const ogImage = await getImage({ src: ogImageSrc, format: 'jpeg', quality: 80 });
const ogImageURL = new URL(ogImage.src, Astro.site);
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />

    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonicalURL} />
    {alternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang ?? alternate.lang} href={new URL(alternate.href, Astro.site)} />)}

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:site_name" content="PDkef" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(ogImage.attributes.width ?? ogImage.options.width)} />
    <meta property="og:image:height" content={String(ogImage.attributes.height ?? ogImage.options.height)} />
    <meta property="og:image:alt" content={socialImageAlt} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={socialImageAlt} />

    <!-- PWA -->
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#ffffff" />
    {/* /favicon.ico must exist at the root: Bing's favicon crawler falls back to it and
        largely ignores a PNG-only rel="icon", so without it the search result shows a
        generic globe. Keep the .ico first and small (16-64px frames). */}
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icons/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/icons/favicon-16.png" type="image/png" sizes="16x16" />
    {/* Was /favicon.png, a byte-identical duplicate of this file. The 512px
        master now lives in src/assets/logo.png and is served through Astro's
        image pipeline wherever it is actually rendered (AppBar, home hero);
        this link needs a stable unhashed path, so it points at the icon set. */}
    <link rel="icon" href="/icons/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/icons/apple-touch-icon.png" />

    <slot name="head" />
  </head>
  <body>
    <slot />
    <script>
      import { inject } from '@vercel/analytics';
      import { sanitizeAnalyticsEvent } from '../lib/maintenanceTelemetry.ts';
      if (import.meta.env.PROD) {
        // Page views are aggregate maintenance signals, not a license to send
        // query strings (which can contain document names or other user data).
        // The shared boundary also makes the provider replaceable without
        // changing the product's privacy contract.
        inject({ beforeSend: sanitizeAnalyticsEvent });
      }
    </script>
    <script>
      // Registration stays production-only, but a service worker outlives the
      // build that installed it and is scoped to the origin, which on localhost
      // is just a port. Running `npm run preview` once therefore leaves a worker
      // controlling the dev server afterwards, serving that build's assets
      // cache-first alongside the dev server's own — the page ends up with
      // modules from two Vite optimize passes and hydration dies on an undefined
      // internal. Dev actively uninstalls it instead of leaving it to rot.
      if ('serviceWorker' in navigator) {
        if (import.meta.env.PROD) {
          window.addEventListener('load', () => navigator.serviceWorker.register('/sw.js'));
        } else {
          navigator.serviceWorker.getRegistrations()
            .then((registrations) => Promise.all(registrations.map((registration) => registration.unregister())))
            .catch(() => {});
          if ('caches' in window) {
            caches.keys()
              .then((keys) => Promise.all(
                keys.filter((key) => key.startsWith('pdkef-')).map((key) => caches.delete(key)),
              ))
              .catch(() => {});
          }
        }
      }
    </script>
  </body>
</html>
