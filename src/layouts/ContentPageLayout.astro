---
// Shared shell for standalone SEO/content pages that are not themselves a
// tool (long-tail landing pages, OS how-to guides). Mirrors the shape of
// ToolPageLayout.astro - hero, body slot, FAQ card, tool cross-links,
// footer - but with a plain centered hero instead of an app-mounting
// section, since these pages carry no Preact island.
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import AppBar from '../components/AppBar.astro';
import ToolFaqCard from '../components/ToolFaqCard.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import Footer from '../components/Footer.astro';
import DocumentationLanguageSelector from '../components/DocumentationLanguageSelector.astro';
import LocalePackRequest from '../components/LocalePackRequest.astro';
import type { DocumentationShellMessages } from '../i18n/documentationMessages';
import { isPublishedEditionLink } from '../i18n/localizedTools';
import '../styles/contentPage.css';

interface FaqItem {
  question: string;
  answer: string;
}
interface Cta {
  href: string;
  label: string;
}
interface Props {
  title: string;
  description: string;
  schemaName?: string;
  breadcrumb?: string;
  icon: any;
  kicker: string;
  h1: string;
  subhead: string;
  primaryCta: Cta;
  faq: FaqItem[];
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  noindex?: boolean;
  locale?: string;
  variants?: { locale?: string; lang?: string; path?: string; href?: string; label?: string; nativeName?: string; isCurrent?: boolean }[];
  preview?: boolean;
  messages: DocumentationShellMessages;
  previewNotice?: string;
  /** ISO timestamp from src/lib/gitLastModified.js - the same value the
   * sitemap reports as <lastmod> for this URL, never a hand-typed date. */
  lastModified: string;
  /** LOC-05: this locale's own published site paths (src/i18n/localizedTools.ts
   * getPublishedEditionPaths), the same list ToolCrossLinks/RelatedGuides use
   * to decide whether a card's target has a localized edition. `primaryCta`
   * is authored as a plain href (some guides point at an untranslated tool -
   * see docs/sign-tool-product-decisions.md's disclosure rule), so this is
   * what tells the CTA apart from a resolved-in-edition link without
   * re-deciding the question its own way. */
  editionPaths?: readonly string[];
}

const {
  title,
  description,
  schemaName = 'PDkef',
  breadcrumb,
  icon: Icon,
  kicker,
  h1,
  subhead,
  primaryCta,
  faq,
  lang = 'en', dir = 'ltr', canonical, alternates, noindex = false, locale = 'en', variants = [], preview = false, messages, previewNotice,
  lastModified,
  editionPaths = [],
} = Astro.props;

// SEO-29: the date is formatted at build time in UTC so the same commit
// renders the same string on every machine. `datetime` carries the calendar
// date only; the reader-facing text follows the page's own language.
const lastModifiedDate = lastModified.slice(0, 10);
const lastModifiedLabel = new Intl.DateTimeFormat(lang, { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(lastModified));

// LOC-05: the primaryCta's href is authored as a plain string (some guides
// deliberately point at a tool with no edition in this locale yet - see
// docs/sign-tool-product-decisions.md), so it needs the same "is this really
// in the reader's edition" check ToolCrossLinks/RelatedGuides already run per
// card, not a fresh guess at whether the URL looks localized.
const ctaIsEnglishFallback = !isPublishedEditionLink(primaryCta.href, locale, editionPaths);
---

<BaseLayout title={title} description={description} lang={lang} dir={dir} canonical={canonical} alternates={alternates} noindex={noindex} socialImageAlt={messages.socialImageAlt}>
  <Fragment slot="head">
    <SeoSchema name={schemaName} description={description} faq={faq} />
  </Fragment>

  <AppBar toolName={breadcrumb} labels={messages} locale={locale} />

  {preview && <aside class="mx-auto mt-4 max-w-[720px] rounded-[var(--radius-md)] border border-[var(--color-primary-tint)] bg-[var(--color-primary-soft)] px-4 py-3 text-center text-[0.9rem] text-[var(--color-text)]" role="status">{previewNotice ?? messages.previewNotice}</aside>}

  {/* No CTA button in the hero, deliberately. Every one of these pages makes a
      case first (what the platform's own tool covers, where it stops, when to
      just use that instead) - a "Sign a PDF now" pill above all of that reads
      as pushing past the argument the page exists to make, and sits oddly next
      to the honest "use the built-in tool" card further down. The action sits
      after the content earns it, in the section below <slot />. A reader who
      wants to skip straight there still can: the first how-it-works card's own
      step 1 always links to the tool. */}
  <header class="mx-auto max-w-[720px] px-6 pb-6 pt-14 text-center min-[768px]:pb-8 min-[768px]:pt-[4.5rem]">
    <div class="mb-5 inline-flex size-16 items-center justify-center rounded-[var(--radius-lg)] bg-[var(--color-primary-soft)] text-[var(--color-primary-text)]">
      <Icon size={30} strokeWidth={1.75} />
    </div>
    <span class="mb-2 block text-[0.72rem] font-bold uppercase text-[var(--color-primary-text)]">{kicker}</span>
    <h1 class="type-hero space-heading-content mt-0 text-[var(--color-text)]">{h1}</h1>
    <p class="type-lead mx-auto mb-0 mt-0 max-w-[56ch] text-[var(--color-muted)]">{subhead}</p>
    <p class="mb-0 mt-5 text-[0.85rem] text-[var(--color-muted)]">
      {messages.lastUpdated} <time datetime={lastModifiedDate}>{lastModifiedLabel}</time>
    </p>
  </header>

  <DocumentationLanguageSelector variants={variants} currentLocale={locale} label={messages.language} />

  <main>
    <slot />
  </main>

  <section class="mx-auto mb-16 w-full max-w-[720px] px-6 text-center min-[768px]:mb-24">
    <a
      href={primaryCta.href}
      hreflang={ctaIsEnglishFallback ? 'en' : undefined}
      class="inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-[var(--color-primary)] px-7 py-3 text-[0.98rem] font-semibold text-[var(--color-surface)] no-underline shadow-sm transition-[transform,background-color,color] duration-200 ease-out hover:-translate-y-0.5 hover:bg-[var(--color-primary-hover)]"
    >
      {primaryCta.label}
      {ctaIsEnglishFallback && messages.inEnglish && (
        <span class="ms-2 inline-block align-middle text-[0.7rem] font-semibold uppercase text-[var(--color-surface)]" lang="en" title={messages.inEnglish}>EN</span>
      )}
    </a>
  </section>

  <ToolFaqCard faq={faq} labels={{ tag: messages.faqTag, heading: messages.faqHeading }} />

  <ToolCrossLinks currentSlug="" />

  <Footer labels={messages} />

  {locale !== 'en' && <LocalePackRequest locale={locale as any} />}
</BaseLayout>
