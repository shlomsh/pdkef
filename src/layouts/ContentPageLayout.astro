---
// Shared shell for standalone SEO/content pages that are not themselves a
// tool (long-tail landing pages, OS how-to guides). Mirrors the shape of
// ToolPageLayout.astro - hero, body slot, FAQ card, tool cross-links,
// footer - but with a plain centered hero instead of an app-mounting
// section, since these pages carry no Preact island.
import BaseLayout from './BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import AppBar from '../components/AppBar.astro';
import ToolFaqCard from '../components/ToolFaqCard.astro';
import ToolCrossLinks from '../components/ToolCrossLinks.astro';
import Footer from '../components/Footer.astro';
import DocumentationLanguageSelector from '../components/DocumentationLanguageSelector.astro';
import '../styles/global.css';

interface FaqItem {
  question: string;
  answer: string;
}
interface Cta {
  href: string;
  label: string;
}
interface Props {
  title: string;
  description: string;
  schemaName?: string;
  breadcrumb?: string;
  icon: any;
  kicker: string;
  h1: string;
  subhead: string;
  primaryCta: Cta;
  faq: FaqItem[];
  lang?: string;
  dir?: 'ltr' | 'rtl';
  canonical?: string;
  alternates?: { lang?: string; hreflang?: string; href: string }[];
  noindex?: boolean;
  locale?: string;
  variants?: { locale?: string; lang?: string; path?: string; href?: string; label?: string; nativeName?: string; isCurrent?: boolean }[];
  preview?: boolean;
  labels?: Record<string, string>;
}

const {
  title,
  description,
  schemaName = 'PDkef',
  breadcrumb,
  icon: Icon,
  kicker,
  h1,
  subhead,
  primaryCta,
  faq,
  lang = 'en', dir = 'ltr', canonical, alternates, noindex = false, locale = 'en', variants = [], preview = false, labels = {},
} = Astro.props;
const hebrewLabels = {
  language: 'שפה', homeAriaLabel: 'דף הבית של PDkef, כל הכלים', onDevice: 'במכשיר שלך',
  previewNotice: 'תרגום בתצוגה מקדימה לבדיקת דוברי עברית. דף זה אינו מאונדקס.',
  faqTag: 'יש שאלות?', faqHeading: 'שאלות נפוצות', otherDevices: 'חותמים במכשיר אחר?',
  openSignTool: 'פתיחת כלי החתימה והמילוי (באנגלית)', relatedKicker: 'עוד על הכלי הזה',
  relatedHeading: 'מדריכים לכלי זה', builtWith: 'נבנה עם', by: 'על ידי',
  socialImageAlt: 'PDkef - כלים חינמיים ל-PDF שפועלים במלואם בדפדפן שלך.',
};
const uiLabels = lang === 'he' ? { ...hebrewLabels, ...labels } : labels;
---

<BaseLayout title={title} description={description} lang={lang} dir={dir} canonical={canonical} alternates={alternates} noindex={noindex} socialImageAlt={uiLabels.socialImageAlt}>
  <Fragment slot="head">
    <SeoSchema name={schemaName} description={description} faq={faq} />
  </Fragment>

  <AppBar toolName={breadcrumb} labels={uiLabels} />

  {preview && <aside class="mx-auto mt-4 max-w-[720px] rounded-[var(--radius-md)] border border-[var(--color-primary-tint)] bg-[var(--color-primary-soft)] px-4 py-3 text-center text-[0.9rem] text-[var(--color-text)]" role="status">{uiLabels.previewNotice ?? 'Preview translation for native review. This page is not indexed.'}</aside>}

  {/* No CTA button in the hero, deliberately. Every one of these pages makes a
      case first (what the platform's own tool covers, where it stops, when to
      just use that instead) - a "Sign a PDF now" pill above all of that reads
      as pushing past the argument the page exists to make, and sits oddly next
      to the honest "use the built-in tool" card further down. The action sits
      after the content earns it, in the section below <slot />. A reader who
      wants to skip straight there still can: the first how-it-works card's own
      step 1 always links to the tool. */}
  <header class="mx-auto max-w-[720px] px-6 pb-6 pt-14 text-center min-[768px]:pb-8 min-[768px]:pt-[4.5rem]">
    <div class="mb-5 inline-flex size-16 items-center justify-center rounded-[var(--radius-lg)] bg-[var(--color-primary-soft)] text-[var(--color-primary)]">
      <Icon size={30} strokeWidth={1.75} />
    </div>
    <span class="mb-2 block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">{kicker}</span>
    <h1 class="mb-4 mt-0 text-[clamp(1.85rem,4.4vw,2.6rem)] font-bold leading-[1.15] text-[var(--color-text)]">{h1}</h1>
    <p class="mx-auto mb-0 mt-0 max-w-[56ch] text-[1.02rem] leading-[1.6] text-[var(--color-muted)]">{subhead}</p>
  </header>

  <DocumentationLanguageSelector variants={variants} currentLocale={locale} label={uiLabels.language ?? 'Language'} />

  <main>
    <slot />
  </main>

  <section class="mx-auto mb-16 w-full max-w-[720px] px-6 text-center min-[768px]:mb-24">
    <a
      href={primaryCta.href}
      class="inline-flex items-center justify-center rounded-[var(--radius-pill)] bg-[var(--color-primary)] px-7 py-3 text-[0.98rem] font-semibold text-[var(--color-surface)] no-underline shadow-sm transition-[transform,background-color,color] duration-200 ease-out hover:-translate-y-0.5 hover:bg-[var(--color-primary-hover)]"
    >
      {primaryCta.label}
    </a>
  </section>

  <ToolFaqCard faq={faq} labels={{ tag: uiLabels.faqTag, heading: uiLabels.faqHeading }} />

  <ToolCrossLinks currentSlug="" />

  <Footer labels={uiLabels} />
</BaseLayout>
