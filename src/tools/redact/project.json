{
  "name": "tool-redact",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "projectType": "library",
  "sourceRoot": "src/tools/redact",
  "tags": ["scope:tool", "tool:redact"],
  "targets": {
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx vitest run src/tools/redact/",
        "cwd": "{workspaceRoot}"
      }
    },
    "e2e": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npx playwright test --project=chromium --project=webkit src/tools/redact/e2e/",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
