---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import { FONT_MANIFEST } from '../../scripts/font-manifest.mjs';
import { RUNTIME_LICENSE_PACKAGES } from '../data/runtimeLicenseInventory.js';
import '../styles/licensesPage.css';

const title = 'Open Source Licenses - PDkef';
const description =
  'Third-party open source software used to build PDkef, and their license terms.';

const softwarePackages = RUNTIME_LICENSE_PACKAGES;

const fontPackages = FONT_MANIFEST.map((font) => ({
  name: `${font.family} Font`,
  version: font.license.version,
  license: 'OFL-1.1',
  url: font.license.url,
  copyright: font.license.copyright,
}));

const packages = [...softwarePackages, ...fontPackages];
---

<BaseLayout title={title} description={description} noindex={true}>
  <header>
    <h1 class="type-hero space-heading-content mt-0 text-[var(--color-text)]">Open Source Licenses</h1>
    <p class="type-lead m-0 text-[var(--color-muted)]">The open source software that powers PDkef, and their license terms.</p>
  </header>

  <main>
    <section id="licenses" class="mx-auto max-w-[760px] px-4 pb-12 pt-8 text-[var(--color-text)]">
      <p class="leading-[1.6] text-[var(--color-muted)]">
        PDkef is built with the following open source packages. We're grateful to their authors and
        maintainers. The browser-runtime inventory is checked against the lockfile in CI; full notices
        are preserved in our <a href="https://github.com/shlomsh/pdkef/blob/main/THIRD_PARTY_LICENSES.md" target="_blank" rel="noopener noreferrer">source repository</a>.
      </p>

      <table class="my-6 w-full border-collapse text-[0.9rem]">
        <thead>
          <tr>
            <th class="border-b border-[var(--color-border)] px-3 py-3 text-start font-semibold text-[var(--color-muted)]" scope="col">Package</th>
            <th class="border-b border-[var(--color-border)] px-3 py-3 text-start font-semibold text-[var(--color-muted)]" scope="col">Version</th>
            <th class="border-b border-[var(--color-border)] px-3 py-3 text-start font-semibold text-[var(--color-muted)]" scope="col">License</th>
          </tr>
        </thead>
        <tbody>
          {packages.map((pkg) => (
            <tr>
              <td class="border-b border-[var(--color-border)] px-3 py-3">
                <a href={pkg.url} target="_blank" rel="noopener noreferrer">{pkg.name}</a>
              </td>
              <td class="border-b border-[var(--color-border)] px-3 py-3">{pkg.version}</td>
              <td class="border-b border-[var(--color-border)] px-3 py-3">{pkg.license}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <p class="leading-[1.6] text-[var(--color-muted)]">
        Full license texts are also available in this project's
        <a href="https://github.com/shlomsh/pdkef/blob/main/THIRD_PARTY_LICENSES.md" target="_blank" rel="noopener noreferrer">THIRD_PARTY_LICENSES.md</a>.
      </p>
    </section>
  </main>

  <Footer />
</BaseLayout>
