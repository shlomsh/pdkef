---
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CardDecor from '../components/CardDecor.astro';
import CompareTable from '../components/CompareTable.astro';
import OtherGuides from '../components/OtherGuides.astro';
import { Monitor, Printer } from 'lucide-preact';

const title = 'How to Sign a PDF on Windows (No Install) | PDkef';
const description =
  'Sign a PDF on Windows without printing and scanning it. Edge can draw on a page but not much more - here is what it covers, and how to fill the rest in Chrome or Edge, free.';

const faq = [
  {
    question: 'Do I need to install any software on Windows to sign a PDF?',
    answer:
      "No. It's a website that runs in the browser tab you already have open, so there's nothing to download, nothing to keep updated, and no admin password to talk a work laptop into accepting.",
  },
  {
    question: "Edge can already draw on a PDF. Isn't that enough?",
    answer:
      "It is, for a quick scribble. Edge's Draw pen is freehand ink, so a signature comes out as whatever your mouse managed, and there's no way to type into a scanned form or tick a real checkbox. If the document is a form rather than a page to initial, you'll hit that ceiling quickly.",
  },
  {
    question: 'Do I still need to print, sign, and scan it back in?',
    answer:
      "No, and that's mostly what this page exists to spare you. Printing and scanning is the standard Windows workaround because nothing in Windows itself signs a PDF, not because the result is any better. A signature added on-screen is cleaner and stays a real, selectable PDF.",
  },
  {
    question: 'Does this work in both Chrome and Edge?',
    answer: 'Yes, and in Firefox. There is no browser-specific setup, and nothing to enable first.',
  },
  {
    question: 'Can I sign with a touchscreen or a pen instead of a mouse?',
    answer:
      'Yes. Drawing works the same with a mouse, a trackpad, a touchscreen, or a stylus. On a Surface or any pen-enabled laptop, the pen gives by far the most natural-looking signature.',
  },
  {
    question: 'Where does the signed file go?',
    answer:
      'To your Downloads folder, as a new file alongside the original. Nothing overwrites what you started with.',
  },
];

const compareRows = [
  { task: 'Add a handwritten signature', builtIn: 'Freehand ink only, with the Draw pen', here: 'Draw it, type it, or upload a photo of one' },
  { task: 'Fill a form that has real fillable fields', builtIn: 'Yes', here: 'Yes' },
  { task: 'Type onto a flat or scanned form', builtIn: 'Possible, but sizing and alignment are fiddly', here: 'Click where you want it and type' },
  { task: 'Tick a checkbox on a scanned form', builtIn: '', here: 'Yes' },
  { task: 'Reorder or delete pages before you send it', builtIn: '', here: 'Yes' },
  { task: 'Permanently remove text from a page', builtIn: '', here: 'Yes' },
];
---

<ContentPageLayout
  title={title}
  description={description}
  breadcrumb="Windows"
  icon={Monitor}
  kicker="Windows, no install"
  h1="How to Sign a PDF on Windows"
  subhead="Windows has no equivalent of Preview, which is why signing a PDF on a PC so often ends with printing the page, signing it by hand, and scanning it back in. You can skip all of that in the browser you already have open."
  primaryCta={{ href: '/sign/', label: 'Sign a PDF now' }}
  faq={faq}
>
  <FeatureCard density="flow" variant="highlight" class="relative isolate overflow-hidden">
    <CardDecor sketch="arcs" icon={Monitor} iconPos="tr" iconSize={280} />
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Four steps</span>
    <h2 class="mb-4 mt-0 text-[1.6rem] font-bold text-[var(--color-text)]">Sign a PDF on Windows</h2>
    <ol class="m-0 flex list-none flex-col gap-5 p-0">
      <li class="flex items-start gap-4">
        <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">1</span>
        <span class="text-[0.98rem] leading-[1.6] text-[var(--color-text)]"><strong class="font-semibold">Open <a class="text-[var(--color-primary)] underline underline-offset-2 hover:text-[var(--color-primary-hover)]" href="/sign/">pdkef.com/sign</a></strong> in Chrome or Edge.</span>
      </li>
      <li class="flex items-start gap-4">
        <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">2</span>
        <span class="text-[0.98rem] leading-[1.6] text-[var(--color-text)]"><strong class="font-semibold">Drag the PDF in</strong> from File Explorer, or straight out of the Downloads bar if it just came in by email.</span>
      </li>
      <li class="flex items-start gap-4">
        <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">3</span>
        <span class="text-[0.98rem] leading-[1.6] text-[var(--color-text)]"><strong class="font-semibold">Fill in the fields, then add your signature.</strong> Draw it with the mouse, trackpad, touchscreen or pen, type it in a handwriting font, or upload a photo of one you signed on paper.</span>
      </li>
      <li class="flex items-start gap-4">
        <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">4</span>
        <span class="text-[0.98rem] leading-[1.6] text-[var(--color-text)]"><strong class="font-semibold">Download it.</strong> The signed PDF lands in Downloads as a new file, next to your untouched original.</span>
      </li>
    </ol>
  </FeatureCard>

  <FeatureCard density="flow" class="relative isolate overflow-hidden">
    <CardDecor sketch="grid" icon={Monitor} iconPos="br" iconSize={280} />
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Edge, side by side</span>
    <h2 class="mb-4 mt-0 text-[1.6rem] font-bold text-[var(--color-text)]">How far Edge's own PDF tools get you</h2>
    <p class="mb-6 mt-0 max-w-[68ch] text-[1.02rem] leading-[1.65] text-[var(--color-text)]">
      Edge opens PDFs by default on Windows and has a small annotation toolbar of its own. It's genuinely useful for
      marking up a document you're reviewing. It was built for annotating rather than for completing forms, though, and
      the difference shows the moment the thing in front of you is a scanned page with boxes to tick.
    </p>
    <CompareTable
      builtInLabel="Microsoft Edge"
      rows={compareRows}
      caption="Both run locally on your PC with nothing uploaded, so this is about what each one can do, not about privacy."
    />
  </FeatureCard>

  <FeatureCard density="flow" class="relative isolate overflow-hidden">
    <CardDecor sketch="waves" icon={Printer} iconPos="cl" iconSize={280} />
    <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">The habit worth dropping</span>
    <h2 class="mb-4 mt-0 text-[1.6rem] font-bold text-[var(--color-text)]">Print, sign, scan is a workaround, not a standard</h2>
    <p class="mb-4 mt-0 max-w-[68ch] text-[1.02rem] leading-[1.65] text-[var(--color-text)]">
      Almost nobody prefers printing a form out. It survives because Windows never shipped an answer to this, so it
      became the thing you fall back on when a deadline is closer than a solution. The scan that comes back is heavier,
      often crooked, and no longer real text, which matters if anyone downstream needs to search or copy from it.
    </p>
    <p class="m-0 max-w-[68ch] text-[1.02rem] leading-[1.65] text-[var(--color-text)]">
      Signing on screen keeps the file a proper PDF the whole way through. If the scan already happened and you're
      working from a photographed page, that's fine too, you can <a class="text-[var(--color-primary)] underline underline-offset-2 hover:text-[var(--color-primary-hover)]" href="/image-to-pdf/">turn the photos back into a PDF</a>
      first and carry on from there.
    </p>
  </FeatureCard>

  <OtherGuides currentHref="/how-to-sign-a-pdf-on-windows/" />
</ContentPageLayout>
