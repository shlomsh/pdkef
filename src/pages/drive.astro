---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import DriveOpen from '../site-lib/DriveOpen.tsx';
import Doodle from '../components/Doodle.astro';
import PromiseStickers from '../components/PromiseStickers.astro';
import '../styles/openPage.css';

// MERGE-25: where Google Drive's "Open with > PDkef" lands. The approved exception to "no external
// origins": Google's sign-in script and its Drive API, on this page only. Every other page keeps
// `connect-src 'self'`; the file still goes straight from Drive to this device.
// Adding a script resource replaces the base script-src source list for this page, so 'self' is restated.
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource('https://accounts.google.com/gsi/client');
Astro.csp?.insertDirective("connect-src 'self' https://www.googleapis.com https://accounts.google.com");

const title = 'Open a PDF from Google Drive - PDkef';
const description = 'Open a PDF from Google Drive in PDkef: it goes from Drive to your device, then you choose what to do with it.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <header class="mx-auto max-w-[540px] px-6 pb-4 pt-[3.5rem] text-center">
    <Doodle figure="cloud-to-device" />
    <h1 class="type-hero space-heading-content mt-3 text-[var(--color-text)]">Open a PDF from Google Drive</h1>
    <p class="mx-auto mt-3 max-w-[26rem] text-[var(--color-muted)]">From Drive to your device, and no further.</p>
  </header>

  <main class="mx-auto mb-16 max-w-[540px] px-6">
    <DriveOpen client:load />

    <PromiseStickers
      label="What to expect"
      items={[
        { kind: 'private', line: 'Your PDF goes from Drive to this device and nowhere else.' },
        { kind: 'free' },
        { kind: 'open-source' },
        { kind: 'local' },
      ]}
    />
  </main>

  <Footer />
</BaseLayout>
