---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import DriveOpen from '../site-lib/DriveOpen.tsx';
import Doodle from '../components/Doodle.astro';
import PromiseStickers from '../components/PromiseStickers.astro';
import '../styles/openPage.css';

// MERGE-25 / DRIVE-01: where Google Drive's "Open with > PDkef" lands and where tools send a person to pick
// a file. The approved exception to "no external origins": Google's sign-in script, Picker and Drive API,
// on this page only. Every other page keeps `connect-src 'self'`, plus the one analytics address when the build sets it; the file still goes straight from Drive
// to this device. These values were proven on a real device; the Picker draws its own frame and styles.
// Adding a script resource replaces the base script-src source list for this page, so 'self' is restated.
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource('https://accounts.google.com/gsi/client');
Astro.csp?.insertScriptResource('https://apis.google.com');
// MEM-45: this literal replaces the base connect-src, so the optional analytics origin is restated here.
const analyticsHost = import.meta.env.PUBLIC_ANALYTICS_HOST;
const analyticsKey = import.meta.env.PUBLIC_ANALYTICS_KEY;
let analyticsOrigin = '';
try {
  const url = typeof analyticsKey === 'string' && analyticsKey !== '' ? new URL(analyticsHost) : null;
  if (url?.protocol === 'https:') analyticsOrigin = ` ${url.origin}`;
} catch {
  // expected: a malformed host means no analytics origin
}
Astro.csp?.insertDirective(`connect-src 'self' https://www.googleapis.com https://accounts.google.com https://content.googleapis.com https://docs.google.com${analyticsOrigin}`);
Astro.csp?.insertDirective('frame-src https://docs.google.com https://drive.google.com https://accounts.google.com https://content.googleapis.com');
// Astro's directive type leaves out style-src-elem; the browser honours it and test:csp pins it on this page alone.
Astro.csp?.insertDirective("style-src-elem 'self' 'unsafe-inline'" as Parameters<NonNullable<typeof Astro.csp>['insertDirective']>[0]);
Astro.csp?.insertDirective("img-src 'self' data: blob: https:");

const title = 'Open a file from Google Drive - PDkef';
const description = 'Open a file from Google Drive in PDkef: it goes from Google Drive to your device, then you choose what to do with it.';
---

<BaseLayout title={title} description={description} noindex={true}>
  <header class="mx-auto max-w-[540px] px-6 pb-4 pt-[3.5rem] text-center">
    <Doodle figure="cloud-to-device" />
    <h1 class="type-hero space-heading-content mt-3 text-[var(--color-text)]">Open a file from Google Drive</h1>
    <p class="mx-auto mt-3 max-w-[26rem] text-[var(--color-muted)]">From Google Drive to your device, and no further.</p>
  </header>

  <main class="mx-auto mb-16 max-w-[540px] px-6">
    <DriveOpen client:load />

    <PromiseStickers
      label="What to expect"
      items={[
        { kind: 'private', line: 'Your file goes from Google Drive to this device and nowhere else.' },
        { kind: 'free' },
        { kind: 'open-source' },
        { kind: 'local' },
      ]}
    />
  </main>

  <Footer />
</BaseLayout>
