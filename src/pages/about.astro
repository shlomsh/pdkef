---
import BaseLayout from '../layouts/BaseLayout.astro';
import Footer from '../components/Footer.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Doodle from '../components/Doodle.astro';
import PromiseStickers from '../components/PromiseStickers.astro';
import { renderInline } from '../site-lib/contentMarkup.ts';
import { staticPages } from '../data/staticPages.js';
import '../styles/staticPage.css';

const page = staticPages.find((p) => p.slug === 'about');
if (!page) throw new Error('staticPages is missing the "about" entry');

// FORM-11: the identity of the build this page was served from. The service
// worker calls `skipWaiting()` only once every open tab is idle (csp-scripts-pwa),
// so an old bundle serving after a deploy is an expected state, not an edge case - and
// "am I looking at the new code?" had no answer anywhere in the product. It is
// the same id `sw.js` already carries: `scripts/generate-precache-manifest.mjs`
// hashes dist/ and substitutes `__BUILD_ID__` in both files, so this page and
// the cache version can never disagree. `astro dev` has no dist to hash and
// says so rather than printing the raw placeholder.
const buildId = import.meta.env.DEV ? 'dev' : '__BUILD_ID__';
---

<BaseLayout title={page.title} description={page.description}>
  <SeoSchema name="PDkef" description={page.description} />
  <header class="mx-auto max-w-[720px] px-6 pb-6 pt-[3.5rem] text-center">
    <Doodle figure="slides-to-pdf" />
    <h1 class="type-hero space-heading-content mt-3 text-[var(--color-text)]">{page.h1}</h1>
    <p class="mx-auto mt-3 max-w-[26rem] text-balance text-[var(--color-muted)]">I built it for an errand, then wanted to share it.</p>
  </header>

  <main>
    <section class="mx-auto max-w-[720px] px-6 pb-16 text-[var(--color-text)]">
      {page.sections.map((section, index) => (
        <div class="mb-8 last:mb-0">
          {section.heading && (
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">{section.heading}</h2>
          )}
          {section.paragraphs.map((paragraph) => (
            <p class="type-body mb-4 leading-[1.7] text-[var(--color-muted)] last:mb-0" set:html={renderInline(paragraph)} />
          ))}
          {index === 0 && (
            <PromiseStickers
              items={[
                { kind: 'private', line: 'Your PDFs are never uploaded.' },
                { kind: 'free', line: 'No account, no page limit, no watermark.' },
                { kind: 'open-source', line: 'Read every line on GitHub, MIT licensed.' },
                { kind: 'local', line: 'It runs in your browser, like a desktop app, with nothing to install.' },
              ]}
            />
          )}
        </div>
      ))}
    </section>
    {/* Not part of the page's content: no heading, outside <main>'s prose
        section and absent from the Markdown twin and the JSON-LD, because it
        is a fact about the bytes in front of you rather than anything to read.
        Deliberately findable, though - it is here so that answering "is this
        the current version?" takes seconds instead of a browser session. */}
    <p class="mx-auto max-w-[720px] px-6 pb-16 type-body text-[var(--color-muted)]">Build {buildId}</p>
  </main>

  <Footer />
</BaseLayout>
