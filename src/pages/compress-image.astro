---
import ToolPageLayout from '../layouts/ToolPageLayout.astro';
import PdfCompressTool from '../components/PdfCompressTool.tsx';
import { toolsBySlug } from '../data/tools.js';

const tool = toolsBySlug['compress-image'];
---

<ToolPageLayout tool={tool}>
  <PdfCompressTool
    client:load
    analyticsTool="compress-image"
    initialMode="target"
  />
</ToolPageLayout>
