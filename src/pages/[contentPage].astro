---
// English keeps the existing root URLs. Localized editions use the shared
// renderer below through /[locale]/[contentPage].astro, so the article shape,
// language picker, cross-links, and SEO metadata cannot drift by language.
import { getCollection } from 'astro:content';
import ContentPageLayout from '../layouts/ContentPageLayout.astro';
import ContentPage from '../components/ContentPage.astro';
import { CONTENT_ICONS } from '../data/contentIcons';
import { contentPages } from '../data/contentPages.js';
import { getDocumentationContext } from '../i18n/documentation';
import { getDocumentationShellMessages } from '../i18n/documentationMessages';

export async function getStaticPaths() {
  const entries = await getCollection('contentPages');
  const fromCollection = entries.map((entry) => entry.id).sort();
  const fromRegistry = contentPages.map((page) => page.href.replace(/^\/|\/$/g, '')).sort();
  const orphaned = fromCollection.filter((slug) => !fromRegistry.includes(slug));
  const missing = fromRegistry.filter((slug) => !fromCollection.includes(slug));
  if (orphaned.length > 0 || missing.length > 0) {
    throw new Error(
      'Content pages are out of sync between src/content/content-pages/ and src/data/contentPages.js.\n' +
        (orphaned.length ? `  No registry entry: ${orphaned.join(', ')}\n` : '') +
        (missing.length ? `  No content file: ${missing.join(', ')}\n` : ''),
    );
  }
  return entries.map((entry) => ({ params: { contentPage: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const pageId = entry.id;
const page = entry.data;
const context = await getDocumentationContext(pageId, 'en');
const messages = getDocumentationShellMessages(context.effectiveLocale);
---

<ContentPageLayout
  title={page.title}
  description={page.description}
  breadcrumb={page.breadcrumb}
  icon={CONTENT_ICONS[page.icon]}
  kicker={page.kicker}
  h1={page.h1}
  subhead={page.subhead}
  primaryCta={page.primaryCta}
  faq={page.faq}
  canonical={context.path}
  alternates={context.alternates}
  locale="en"
  variants={context.variants}
  messages={messages}
>
  <ContentPage
    entry={entry}
    pageId={pageId}
    locale="en"
    labels={messages}
    resolveLink={(targetPageId: string, targetLocale: string) => context.resolveDocumentationLink(targetPageId, targetLocale)}
  />
</ContentPageLayout>
