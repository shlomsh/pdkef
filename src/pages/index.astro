---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CardDecor from '../components/CardDecor.astro';
import AppBar from '../components/AppBar.astro';
import HeroDemo from '../components/HeroDemo/HeroDemo.astro';
import OfflineProof from '../components/OfflineProof.astro';
import '../styles/homePage.css';

const title = 'Free PDF Tools - Private, Local, No Sign-Up | PDkef';
const description = 'A free, open-source suite of PDF tools that run entirely in your browser. Merge, sign, split, redact, compress, and convert PDFs with nothing uploaded, no account, and no watermark. Your files never leave your device.';

import { Monitor, Smartphone, Compass, Sparkles, HardDriveDownload, WifiOff, HelpCircle, ShieldCheck, InfinityIcon, Lock, Code2, Type, PenLine, Trash2 } from 'lucide-preact';
import { tools } from '../data/tools.js';
import FileDropzone from '../components/FileDropzone.tsx';

// FAQ schema mirrors the visible questions rendered in the footer below.
const faq = [
  { question: 'Are the tools really free?', answer: 'Yes, completely and permanently - no paywalls, no premium tier, no limits, and no watermark on your exported PDFs.' },
  { question: 'Do I need to sign up or create an account?', answer: 'No. There is no account, no email, and no trial period. Open a tool and use it immediately.' },
  { question: 'Are my files uploaded to a server?', answer: 'No. The tools run 100% locally in your browser, on desktop or mobile. Your PDF files are never sent over the network - they stay on your device the entire time.' },
  { question: 'Is PDkef open source?', answer: 'Yes. The entire codebase is open source under the MIT license, so you can inspect exactly what runs on your device.' },
];

// The tool list (home grid + hero card) comes from the shared registry, so it
// stays in sync with the tool pages and the sitemap. Ordered by SEO priority.
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <SeoSchema name="PDkef" description={description} faq={faq} />
  </Fragment>

  <div class="home-header">
    <AppBar isHome>
      <a href="https://github.com/shlomsh/pdkef" target="_blank" rel="noopener noreferrer">Star us on GitHub ☆</a>
      <a href="/licenses/">MIT licensed</a>
      <a href="#offline-app">Works offline</a>
    </AppBar>
    <header class="hero-header">
      <h1>Free PDF tools that run <span>on your device</span></h1>
      <p>Merge, sign, split, redact and compress PDFs. No signup, no install, nothing leaves your device.</p>
    </header>
  </div>
  <main id="home-content">
    <div class="home-tour" id="home-tour">
      <div class="home-scene" data-working-area>
        <div class="workspace-launcher">
          <FileDropzone client:only="preact" toolTarget="sign" />
          <div class="tour-actions">
            <a href="#home-information" data-tour-only>About PDkef ↓</a>
            <button type="button" data-tour-skip data-tour-only>Go to workspace</button>
            <button type="button" data-tour-replay data-workspace-only>Replay the demos</button>
          </div>
        </div>
        <HeroDemo />
      </div>
    </div>
    <div id="home-information">
    <OfflineProof />
  <div class="card-stack">

      <FeatureCard class="relative isolate overflow-hidden">
        <CardDecor sketch="arcs" icon={Sparkles} iconPos="tr" iconSize={300} parallax />
        <div class="flex items-stretch gap-12 max-[768px]:flex-col max-[768px]:gap-8">
          <div class="min-w-0 flex-[1.2]">
            <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Why I made this</span>
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">The tools I wanted, shared with everyone</h2>
            <p class="type-lead space-content-row mt-0 max-w-[800px] text-[var(--color-text)]">
              It started with a couple of ordinary errands. Someone close to me needed to combine a stack of course slides into one PDF before an exam, and to sign a summer-camp form that had arrived over WhatsApp. Simple things. But every tool we tried either capped the pages, wanted a subscription and a Windows install, or looked like the last place you would want to send a personal document.
            </p>
            <p class="type-lead space-content-row mt-0 max-w-[800px] text-[var(--color-text)]">
              So I built the PDF tools I wanted for myself. Then I realised I wanted to share them. I believe simple, everyday tools like these should just be free and available to everyone, with no account, no paywall, and nothing uploaded to anyone's server.
            </p>
            <p class="type-body mt-0 max-w-[800px] text-[var(--color-muted)]">
              That is why PDkef runs entirely in your browser. There is no server to send your files to, which is what keeps it private and cheap enough to stay free for good. And it is open source, so you never have to take my word for any of it.
            </p>
            <p class="mb-0 mt-5 text-[0.9rem] italic text-[var(--color-muted)]">
              <a class="font-semibold not-italic text-[var(--color-primary)] underline underline-offset-2 hover:text-[var(--color-primary-hover)]" href="https://github.com/shlomsh" target="_blank" rel="noopener noreferrer">Shlomi</a>
            </p>
          </div>
          <div class="flex flex-1 flex-col justify-center overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm">
            <div class="group flex items-center gap-4 px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><InfinityIcon size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">Free Forever</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">No limits, no catch</span>
              </div>
            </div>
            <div class="group flex items-center gap-4 border-t border-[var(--color-border)] px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><Lock size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">Private</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">Files never leave your device</span>
              </div>
            </div>
            <div class="group flex items-center gap-4 border-t border-[var(--color-border)] px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><Code2 size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">Open Source</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">Audit the code yourself</span>
              </div>
            </div>
          </div>
        </div>
      </FeatureCard>

      <FeatureCard variant="highlight" class="relative isolate overflow-hidden">
        <CardDecor sketch="waves" icon={HardDriveDownload} iconPos="cr" iconSize={300} parallax />
        <div class="flex items-center gap-12 max-[768px]:flex-col-reverse max-[768px]:gap-8">
          <div class="relative flex min-h-[210px] w-full flex-[0.8] items-center justify-center py-4" aria-hidden="true">
            <div class="relative w-[290px] max-w-full rotate-[-1.5deg]">
              <div class="overflow-hidden rounded-[var(--radius-sm)] border-[1.5px] border-[var(--color-primary-soft)] bg-[var(--color-surface)] shadow-md">
                <div class="flex items-center gap-[0.3rem] border-b border-[var(--color-border)] bg-[var(--color-surface-soft)] px-3 py-[0.45rem]">
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="ms-2 h-1.5 w-16 rounded-full bg-[var(--color-border)]"></span>
                </div>
                <svg class="block w-full" viewBox="0 0 200 132" role="presentation" focusable="false">
                  <g class="fill-[var(--color-border)]">
                    <rect x="18" y="30" width="164" height="4" rx="2" />
                    <rect x="18" y="40" width="164" height="4" rx="2" />
                    <rect x="18" y="50" width="118" height="4" rx="2" />
                    <rect x="142" y="82" width="40" height="4" rx="2" />
                    <rect x="142" y="92" width="26" height="4" rx="2" />
                    <rect x="18" y="122" width="88" height="4" rx="2" />
                  </g>
                  <rect x="18" y="14" width="72" height="6" rx="3" class="fill-[var(--color-muted-light)]" />

                  <rect x="24" y="68" width="100" height="44" rx="6" class="fill-[var(--color-primary-soft)] stroke-[var(--color-primary)]" stroke-width="1.2" stroke-dasharray="4 3" stroke-opacity="0.55" />
                  <g fill="none" class="stroke-[var(--color-primary)]" stroke-linecap="round" stroke-linejoin="round">
                    <path
                      d="M 32 98 C 34 84, 40 74, 46 77 C 52 80, 44 92, 40 96 C 36 100, 46 100, 52 92 C 58 84, 62 90, 59 96 C 56 102, 64 100, 68 91 C 72 82, 77 87, 74 95 C 71 103, 80 100, 85 91 C 90 82, 96 86, 93 95 C 90 104, 99 101, 105 92"
                      stroke-width="2.2"
                    />
                    <path d="M 34 104 C 60 110, 88 107, 114 95" stroke-width="1.6" stroke-opacity="0.7" />
                  </g>
                  <g class="fill-[var(--color-surface)] stroke-[var(--color-primary)]" stroke-width="1.4">
                    <rect x="21" y="65" width="6" height="6" rx="1.5" />
                    <rect x="121" y="65" width="6" height="6" rx="1.5" />
                    <rect x="21" y="109" width="6" height="6" rx="1.5" />
                    <rect x="121" y="109" width="6" height="6" rx="1.5" />
                  </g>
                </svg>
              </div>

              <div class="absolute left-[14%] top-[54%] flex -translate-y-full items-center gap-[0.45rem] rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[0.5rem] py-[0.3rem] text-[var(--color-muted)] shadow-sm">
                <Type size={11} strokeWidth={2.2} />
                <PenLine size={11} strokeWidth={2.2} class="text-[var(--color-primary)]" />
                <span class="h-3 w-px bg-[var(--color-border)]"></span>
                <Trash2 size={11} strokeWidth={2.2} />
              </div>

              <div class="absolute -bottom-3 -right-3 inline-flex items-center gap-[0.35rem] rounded-[var(--radius-pill)] border border-[color-mix(in_srgb,var(--color-success)_20%,transparent)] bg-[var(--color-success-soft)] px-[0.6rem] py-[0.3rem] text-[0.7rem] font-semibold text-[var(--color-success)] shadow-sm">
                <span class="size-1.5 rounded-full bg-[var(--color-success)] animate-[pulse_2s_infinite]"></span>
                Autosaved to device
              </div>
            </div>
          </div>
          <div class="flex-[1.2]">
            <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Privacy & Convenience</span>
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">Work survives restarts and crashes</h2>
            <p class="type-lead space-content-row mt-0 text-[var(--color-text)]">
              PDkef auto-saves your in-progress work locally to your browser's secure database. If you close the tab, restart your computer, or experience a crash, your PDF and edits are restored exactly where you left off.
            </p>
            <p class="type-body m-0 text-[var(--color-muted)]">
              Because it runs 100% on your device, we get "pick up where you left off" without sending a single byte of your file to a server. Available now in <strong>Sign & Fill</strong> and <strong>Redact & Blur</strong>.
            </p>
          </div>
        </div>
      </FeatureCard>

      <FeatureCard class="relative isolate overflow-hidden">
        <CardDecor sketch="grid" icon={WifiOff} iconPos="br" iconSize={300} parallax />
        <div class="mx-auto mb-8 max-w-[750px] text-center">
          <h2 id="offline-app" class="type-section space-heading-content mt-0 text-[var(--color-text)]">Run PDkef offline as an app</h2>
          <p class="type-lead m-0 text-[var(--color-muted)]">Because PDkef runs entirely in your web browser with zero server uploads, you can install it on your device and use it just like a native desktop or mobile application, even when you don't have internet access.</p>
        </div>

        <div class="box-border mx-auto w-full max-w-[680px] overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm">
          <div class="flex border-b border-[var(--color-border)] bg-[var(--color-surface-soft)] max-[640px]:flex-col" role="tablist" aria-label="Device installation guides">
            <button class="offline-tab-btn active flex flex-1 items-center justify-center border-0 border-b-2 border-b-transparent bg-transparent p-4 text-[0.9rem] font-semibold text-[var(--color-muted)] transition-colors duration-200 ease-out hover:bg-[color-mix(in_srgb,var(--color-primary)_2%,transparent)] hover:text-[var(--color-text)] [&.active]:border-b-[var(--color-primary)] [&.active]:bg-[var(--color-surface)] [&.active]:text-[var(--color-primary)] max-[640px]:justify-start max-[640px]:border-b-0 max-[640px]:border-l-[3px] max-[640px]:border-l-transparent max-[640px]:px-5 max-[640px]:py-3 max-[640px]:[&.active]:border-l-[var(--color-primary)]" role="tab" aria-selected="true" aria-controls="guide-chrome" id="tab-chrome">
              <Monitor size={16} class="mr-2" />
              Chrome & Edge
            </button>
            <button class="offline-tab-btn flex flex-1 items-center justify-center border-0 border-b-2 border-b-transparent bg-transparent p-4 text-[0.9rem] font-semibold text-[var(--color-muted)] transition-colors duration-200 ease-out hover:bg-[color-mix(in_srgb,var(--color-primary)_2%,transparent)] hover:text-[var(--color-text)] [&.active]:border-b-[var(--color-primary)] [&.active]:bg-[var(--color-surface)] [&.active]:text-[var(--color-primary)] max-[640px]:justify-start max-[640px]:border-b-0 max-[640px]:border-l-[3px] max-[640px]:border-l-transparent max-[640px]:px-5 max-[640px]:py-3 max-[640px]:[&.active]:border-l-[var(--color-primary)]" role="tab" aria-selected="false" aria-controls="guide-ios" id="tab-ios">
              <Smartphone size={16} class="mr-2" />
              Safari (iOS)
            </button>
            <button class="offline-tab-btn flex flex-1 items-center justify-center border-0 border-b-2 border-b-transparent bg-transparent p-4 text-[0.9rem] font-semibold text-[var(--color-muted)] transition-colors duration-200 ease-out hover:bg-[color-mix(in_srgb,var(--color-primary)_2%,transparent)] hover:text-[var(--color-text)] [&.active]:border-b-[var(--color-primary)] [&.active]:bg-[var(--color-surface)] [&.active]:text-[var(--color-primary)] max-[640px]:justify-start max-[640px]:border-b-0 max-[640px]:border-l-[3px] max-[640px]:border-l-transparent max-[640px]:px-5 max-[640px]:py-3 max-[640px]:[&.active]:border-l-[var(--color-primary)]" role="tab" aria-selected="false" aria-controls="guide-safari" id="tab-safari">
              <Compass size={16} class="mr-2" />
              Safari (macOS)
            </button>
          </div>

          <div class="p-8">
            <div class="offline-tab-panel active hidden [&.active]:block" id="guide-chrome" role="tabpanel" aria-labelledby="tab-chrome">
              <ol class="m-0 flex list-none flex-col gap-5 p-0">
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">1</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Navigate to the site in Chrome or Edge.</span>
                </li>
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">2</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Click the <strong class="font-semibold">Install</strong> icon (the screen with a down arrow) at the right of the address bar.</span>
                </li>
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">3</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Alternatively, click the browser menu (three dots), select <strong class="font-semibold">Save and share</strong>, and click <strong class="font-semibold">Install PDkef</strong>.</span>
                </li>
              </ol>
            </div>

            <div class="offline-tab-panel hidden [&.active]:block" id="guide-ios" role="tabpanel" aria-labelledby="tab-ios">
              <ol class="m-0 flex list-none flex-col gap-5 p-0">
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">1</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Open the site in <strong class="font-semibold">Safari</strong> on your iPhone or iPad.</span>
                </li>
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">2</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Tap the <strong class="font-semibold">Share</strong> button (square with an up arrow) in the toolbar.</span>
                </li>
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">3</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Scroll down the options list and select <strong class="font-semibold">Add to Home Screen</strong>.</span>
                </li>
              </ol>
            </div>

            <div class="offline-tab-panel hidden [&.active]:block" id="guide-safari" role="tabpanel" aria-labelledby="tab-safari">
              <ol class="m-0 flex list-none flex-col gap-5 p-0">
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">1</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Open the site in <strong class="font-semibold">Safari</strong> on your Mac.</span>
                </li>
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">2</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Click the <strong class="font-semibold">Share</strong> button in the top-right Safari toolbar.</span>
                </li>
                <li class="flex items-start gap-4">
                  <span class="mt-[0.1rem] flex size-6 shrink-0 items-center justify-center rounded-full bg-[var(--color-primary-soft)] text-[0.8rem] font-bold text-[var(--color-primary)]">3</span>
                  <span class="text-[0.95rem] leading-[1.5] text-[var(--color-text)]">Select <strong class="font-semibold">Add to Dock...</strong> from the dropdown menu and click <strong class="font-semibold">Add</strong>.</span>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </FeatureCard>

    <script>
      const tabs = document.querySelectorAll('.offline-tab-btn');
      const panels = document.querySelectorAll('.offline-tab-panel');

      tabs.forEach(tab => {
        tab.addEventListener('click', () => {
          // Deactivate current active tab & panel
          tabs.forEach(t => {
            t.classList.remove('active');
            t.setAttribute('aria-selected', 'false');
          });
          panels.forEach(p => p.classList.remove('active'));

          // Activate clicked tab & panel (visibility is handled by CSS on .active)
          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          const panelId = tab.getAttribute('aria-controls');
          if (!panelId) return;
          const targetPanel = document.getElementById(panelId);
          if (targetPanel) {
            targetPanel.classList.add('active');
          }
        });
      });
    </script>

    <FeatureCard class="relative isolate overflow-hidden">
      <CardDecor sketch="rings" icon={HelpCircle} iconPos="bl" iconSize={300} parallax />
      <div class="space-heading-content text-center">
        <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Got Questions?</span>
        <h2 class="type-section m-0 text-[var(--color-text)]">Frequently asked questions</h2>
      </div>
      <div class="space-layout-gap grid grid-cols-2 gap-x-12 max-[768px]:grid-cols-1">
        <div class="faq-card">
          <h3 class="type-card mb-2 mt-0 text-[var(--color-text)]">Are the tools really free?</h3>
          <p class="type-body m-0 text-[var(--color-muted)]">Yes, completely and permanently - no paywalls, no premium tier, no limits, and no watermark on your exported PDFs.</p>
        </div>
        <div class="faq-card">
          <h3 class="type-card mb-2 mt-0 text-[var(--color-text)]">Do I need to sign up or create an account?</h3>
          <p class="type-body m-0 text-[var(--color-muted)]">No. There is no account, no email, and no trial period. Open a tool and use it immediately.</p>
        </div>
        <div class="faq-card">
          <h3 class="type-card mb-2 mt-0 text-[var(--color-text)]">Are my files uploaded to a server?</h3>
          <p class="type-body m-0 text-[var(--color-muted)]">No. The tools run 100% locally in your browser, on desktop or mobile. Your PDF files are never sent over the network - they stay on your device the entire time.</p>
        </div>
        <div class="faq-card">
          <h3 class="type-card mb-2 mt-0 text-[var(--color-text)]">Is PDkef open source?</h3>
          <p class="type-body m-0 text-[var(--color-muted)]">Yes. The entire codebase is open source under the MIT license, so you can inspect exactly what runs on your device.</p>
        </div>
      </div>
    </FeatureCard>

    <FeatureCard variant="highlight" class="relative isolate overflow-hidden">
      <CardDecor sketch="arcs" icon={ShieldCheck} iconPos="cl" iconSize={300} parallax />
      <div class="w-full">
        <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Transparent & Secure</span>
        <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">Open source & privacy</h2>
        <div class="space-layout-gap grid grid-cols-2 max-[768px]:grid-cols-1">
          <div class="rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] p-7 shadow-xs transition-[transform,box-shadow,border-color,color] duration-300 ease-out hover:-translate-y-[3px] hover:border-[var(--color-border-strong)] hover:shadow-md">
