      top: calc(var(--home-header-height) + var(--stack-gap));
      /* Down to the bottom edge of the viewport, not to a matching gap
         above it, and that is a correctness rule rather than a taste one.
         These cards are content-height with a floor, so they are only equal
         while every one of them clears the floor - and the tallest card is
         also the first, so any card that overruns leaves a band of itself
         showing under every card stacked over it. A card that runs to the
         bottom edge cannot. */
      min-height: calc(100svh - var(--home-header-height) - var(--stack-gap));
      /* The box runs to the viewport bottom, but the bottom
