---
// The English home page. Thin by design (LOC-09): the actual markup lives in
// HomePageLayout.astro, shared with src/pages/[locale]/index.astro, the same
// "thin page file over a shared layout" pattern sign.astro/merge.astro already
// use over ToolPageLayout.astro. This file's only job is to supply the
// English content object and the English shell messages, unchanged from
// before this ticket - so the rendered output stays byte-identical.
import HomePageLayout from '../layouts/HomePageLayout.astro';
import { homeContent } from '../data/homeContent.js';
import { documentationShellMessages } from '../i18n/documentationMessages';
---

<HomePageLayout home={homeContent} lang="en" dir="ltr" locale="en" messages={documentationShellMessages.en!} signToolDisplayName="Sign & Fill" />
