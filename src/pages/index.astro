---
import BaseLayout from '../layouts/BaseLayout.astro';
import SeoSchema from '../components/SeoSchema.astro';
import Footer from '../components/Footer.astro';
import FeatureCard from '../components/FeatureCard.astro';
import CardDecor from '../components/CardDecor.astro';
import AppBar from '../components/AppBar.astro';
import HeroDemo from '../components/HeroDemo/HeroDemo.astro';
import OfflineProof from '../components/OfflineProof.astro';
import '../styles/global.css';

const title = 'Free PDF Tools - Private, Local, No Sign-Up | PDkef';
const description = 'A free, open-source suite of PDF tools that run entirely in your browser. Merge, sign, split, redact, compress, and convert PDFs with nothing uploaded, no account, and no watermark. Your files never leave your device.';

import { Monitor, Smartphone, Compass, Sparkles, HardDriveDownload, WifiOff, HelpCircle, ShieldCheck, InfinityIcon, Lock, Code2, Type, PenLine, Trash2 } from 'lucide-preact';
import { tools } from '../data/tools.js';
import FileDropzone from '../components/FileDropzone.tsx';
import { Image } from 'astro:assets';
import logo from '../assets/logo.png';

// FAQ schema mirrors the visible questions rendered in the footer below.
const faq = [
  { question: 'Are the tools really free?', answer: 'Yes, completely and permanently - no paywalls, no premium tier, no limits, and no watermark on your exported PDFs.' },
  { question: 'Do I need to sign up or create an account?', answer: 'No. There is no account, no email, and no trial period. Open a tool and use it immediately.' },
  { question: 'Are my files uploaded to a server?', answer: 'No. The tools run 100% locally in your browser, on desktop or mobile. Your PDF files are never sent over the network - they stay on your device the entire time.' },
  { question: 'Is PDkef open source?', answer: 'Yes. The entire codebase is open source under the MIT license, so you can inspect exactly what runs on your device.' },
];

// The tool list (home grid + hero card) comes from the shared registry, so it
// stays in sync with the tool pages and the sitemap. Ordered by SEO priority.
---

<BaseLayout title={title} description={description}>
  <Fragment slot="head">
    <SeoSchema name="PDkef" description={description} faq={faq} />
  </Fragment>

  <AppBar isHome />
  {/* DEMO-05, variant T: the two-column first screen, after usetape.app.
      Above 1320px the hero, dropzone and tool dock stay exactly as they were
      but occupy the left column and stick there, while the demo runs in the
      right column beside them. Stacked, the demo and the hero compete for one
      vertical budget, which is what forced the choice between a legible demo
      (about 410px) and keeping the dock on the first screen. Side by side they
      share the budget instead, so the demo gets the full column height and the
      dock does not move at all.

      Below 1320px this is a plain block and everything falls back to the
      stacked order, which is what phones already had; see the media query in
      the <style> block below for why the threshold is 1320 and not the 1024
      it shipped at. Reverting the whole variant is deleting this wrapper and
      moving <HeroDemo /> back below <OfflineProof />; DEMO-05 requires
      placement to stay cheap to reverse. */}
  <div class="home-first bg-[linear-gradient(180deg,var(--color-bg),var(--color-primary-tint))]">
  <div class="home-first-main pb-12 min-[1024px]:flex min-[1024px]:min-h-[calc(100svh-3.5rem)] min-[1024px]:flex-col min-[1024px]:justify-center min-[1024px]:box-border min-[1024px]:pt-2 min-[1024px]:pb-6">
    <header class="hero-header">
      <div class="mb-3 flex items-center justify-center gap-4">
        <Image src={logo} width={56} height={56} densities={[1, 2]} loading="eager" decoding="sync" fetchpriority="high" alt="" aria-hidden="true" class="shrink-0" />
        <h1 class="type-hero m-0 text-start">Free PDF tools that run <span class="text-[var(--color-primary)]">on your device</span></h1>
      </div>
      <p class="type-lead mx-auto max-w-[54rem] min-[1024px]:mt-[0.6rem]">Merge, sign, split, redact, and compress PDFs without signing up, installing anything, or uploading a single file. Everything runs in your browser, on your phone or computer, so your files never leave your device.</p>
      
      <div class="mt-6 flex flex-wrap justify-center gap-[0.6rem] min-[1024px]:mt-4">
        <a class="inline-flex items-center gap-[0.45rem] rounded-[10px] border-[0.5px] border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.45rem] text-[0.8rem] font-semibold text-[var(--color-text)] no-underline transition-[transform,border-color,color] duration-150 ease-out hover:-translate-y-px hover:border-[var(--color-border-strong)] hover:text-[var(--color-text)]" href="https://github.com/shlomsh/pdkef" target="_blank" rel="noopener noreferrer">
          <svg class="shrink-0 text-[var(--color-text)]" width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.85 9.73.5.1.68-.22.68-.49 0-.24-.01-.88-.01-1.72-2.79.62-3.38-1.37-3.38-1.37-.46-1.19-1.11-1.5-1.11-1.5-.91-.64.07-.62.07-.62 1 .07 1.53 1.06 1.53 1.06.89 1.56 2.34 1.11 2.91.85.09-.66.35-1.11.63-1.36-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.34 9.34 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9 0 1.37-.01 2.47-.01 2.81 0 .27.18.6.69.49A10.02 10.02 0 0 0 22 12.25C22 6.58 17.52 2 12 2z" />
          </svg>
          Star us on GitHub
          <svg class="shrink-0 text-[var(--color-primary)]" width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14l-5-4.87 7.1-1.01L12 2z" />
          </svg>
        </a>
        <span class="inline-flex items-center gap-[0.45rem] rounded-[10px] border-[0.5px] border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.45rem] text-[0.8rem] font-semibold text-[var(--color-muted)]">
          <svg class="shrink-0 text-[var(--color-muted-light)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v18" /><path d="M7 7l-4 6a4 4 0 0 0 8 0l-4-6z" /><path d="M17 7l-4 6a4 4 0 0 0 8 0l-4-6z" /><path d="M6 21h12" /><path d="M8 5h8" />
          </svg>
          MIT licensed
        </span>
        <span class="inline-flex items-center gap-[0.45rem] rounded-[10px] border-[0.5px] border-[var(--color-border)] bg-[var(--color-surface)] px-[0.8rem] py-[0.45rem] text-[0.8rem] font-semibold text-[var(--color-muted)]">
          <svg class="shrink-0 text-[var(--color-muted-light)]" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 20h.01" /><path d="M8.5 16.429a5 5 0 0 1 7 0" /><path d="M5 12.859a10 10 0 0 1 5.17-2.69" /><path d="M19 12.859a10 10 0 0 0-2.007-1.523" /><path d="M2 8.82a15 15 0 0 1 4.177-2.643" /><path d="M22 8.82a15 15 0 0 0-11.288-3.764" /><path d="m2 2 20 20" />
          </svg>
          Works offline
        </span>
      </div>
    </header>

  <main class="min-[1024px]:!flex min-[1024px]:!min-h-0 min-[1024px]:!flex-1 min-[1024px]:!flex-col min-[1024px]:!pb-0">
    {/* Large Dropzone CTA */}
    <div class="merge-tool first-screen-frame mx-auto mb-16 box-border max-w-[1080px] p-6 min-[1024px]:!mb-4 min-[1024px]:!p-4">
      {/* .first-screen-frame (scoped rule below) grows to fill whatever room
          the first-screen budget has left over between the header and the
          tool dock (flex:1 inside <main>'s own flex column), then centers
          its fixed-size child vertically (justify-content:center) rather
          than leaving that room as a flat gap below a static-height box. At
          a short viewport the child sits nearly flush against its own
          padding; at a tall one it gets more air above and below - the
          growing/shrinking budget shows up as calm framing around the CTA
          instead of as dead space beneath it. It is a scoped class, not
          Tailwind utilities, so this one-off layout ships only on this page
          - see the <style> block at the end of the file. See the
          --first-screen-slot custom property below (child's own height
          contract, not this wrapper) for how a future demo resizes it. */}
      {/* Reserves the dropzone's rendered height before it exists.
          FileDropzone is `client:only`, so Astro emits an empty <astro-island>
          here and the box paints nothing until its chunk loads and hydrates -
          on the highest-traffic page in the site, that is the primary CTA
          missing on first paint and the tool grid below it jumping down when
          it arrives. It has to stay client:only: the component reads saved
          drafts out of localStorage in a lazy useState initializer, which on
          the server always reports "no drafts", so server-rendering it would
          trade this shift for a wrong-state flash on every returning visitor.
          Holding the space instead costs nothing and removes the shift.

          The three figures are measured, not derived, and they are the one
          hand-computed thing in this file. To redo them after any change to
          the dropzone's content, padding or type scale: build, serve dist/,
          and read the height back at each breakpoint -
            document.querySelector('[data-empty-state]').getBoundingClientRect().height
          Under 412px the "Private. Files never leave your device." pill wraps
          to a second line (+21.8px); at 1024px Dropzone.module.css drops the
          block padding from 3rem to 1.5rem (-48px). Round up, never down: an
          over-reservation is dead space, an under-reservation is the shift
          this exists to prevent. The 412px step tracks a text wrap, so it
          moves with font metrics - a platform that wraps later shifts by at
          most that 22px, against 333px before this.

          The 1024px+ tier reads --first-screen-slot (default 264px, this
          same measured figure) instead of a bare min-h-[264px], so the
          HeroDemo work landing in this slot can raise the reservation to
          whatever height its own component needs by setting the one custom
          property - on this div, or an ancestor - without touching the
          surrounding flex/centering layout in the parent above. Nothing
          currently overrides it, so today's rendered height is unchanged. */}
      <div class="min-h-[333px] min-[412px]:min-h-[312px] min-[1024px]:min-h-[var(--first-screen-slot,264px)]">
        <FileDropzone client:only="preact" href="/sign?action=open" toolTarget="sign" className="min-[1024px]:!py-6" />
      </div>
    </div>

    {/* App Grid for all tools */}
    <div class="mx-auto mb-12 flex max-w-[1080px] flex-wrap justify-center gap-6 p-6 min-[1024px]:!mt-auto min-[1024px]:mb-0 min-[1024px]:gap-5 min-[1024px]:p-3">
      {tools.map((tool) => (
        <a href={tool.href} data-accent={tool.accent} class="app-card relative flex w-20 shrink-0 cursor-pointer flex-col items-center gap-3 text-inherit no-underline outline-none">
          <div class="app-tile flex size-16 items-center justify-center">
            <tool.icon strokeWidth={1.5} />
          </div>
          <div class="text-center text-[0.8rem] font-semibold leading-[1.25] text-[var(--color-muted)]">{tool.gridTitle}</div>
          <span class="app-tooltip">{tool.gridDescription}</span>
        </a>
      ))}
    </div>
  </main>
</div>

  {/* HeroDemo (DEMO-02) in the right column above 1320px, below the first
      screen otherwise. position: sticky is killed with no error by any
      ancestor carrying overflow/transform/filter/contain, so neither
      .home-first nor this column may ever grow one - the demo's own panels
      and the left column both depend on it. */}
  <div class="home-first-demo">
    <HeroDemo />
  </div>
</div>

    {/* OfflineProof (DEMO-04): the live half of "your document stays on
        your phone." HeroDemo below already says the claim sentence and the
        airplane-mode invitation, so this only adds what static copy can't:
        when the visitor really is offline, say so and say it still works.

        It sits outside the first-screen wrapper on purpose. That wrapper is
        one composed unit whose tool grid is pinned to the bottom with
        mt-auto, and anything added inside it pushes the dock off the
        viewport (see the comment above and DEMO-05). Online it renders an
        empty, padding-less paragraph that its own :empty rule hides, so it
        costs no height in the common case either way. */}
    <OfflineProof />

  {/* The story cards stack rather than scroll past: each one pins below the
      app bar and the next slides up over it, so they arrive as a deck being
      dealt instead of a column being scrolled. The wrapper is what bounds
      it - `position: sticky` holds an element for as long as its containing
      block is in view, so without this the first card would stay pinned
      behind the footer. It must never grow overflow, transform, filter or
      contain: any of those makes it a containing block and kills sticky on
      every card at once, with no error anywhere.

      Rules are in the <style> block below, and only apply from 768px up.
      Below that the cards have no min-height and run taller than the
      viewport, so pinning one would cut off its own bottom. */}
  <div class="card-stack">

      <FeatureCard class="relative isolate overflow-hidden">
        <CardDecor sketch="arcs" icon={Sparkles} iconPos="tr" iconSize={300} parallax />
        <div class="flex items-stretch gap-12 max-[768px]:flex-col max-[768px]:gap-8">
          <div class="min-w-0 flex-[1.2]">
            <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Why I made this</span>
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">The tools I wanted, shared with everyone</h2>
            <p class="type-lead space-content-row mt-0 max-w-[800px] text-[var(--color-text)]">
              It started with a couple of ordinary errands. Someone close to me needed to combine a stack of course slides into one PDF before an exam, and to sign a summer-camp form that had arrived over WhatsApp. Simple things. But every tool we tried either capped the pages, wanted a subscription and a Windows install, or looked like the last place you would want to send a personal document.
            </p>
            <p class="type-lead space-content-row mt-0 max-w-[800px] text-[var(--color-text)]">
              So I built the PDF tools I wanted for myself. Then I realised I wanted to share them. I believe simple, everyday tools like these should just be free and available to everyone, with no account, no paywall, and nothing uploaded to anyone's server.
            </p>
            <p class="type-body mt-0 max-w-[800px] text-[var(--color-muted)]">
              That is why PDkef runs entirely in your browser. There is no server to send your files to, which is what keeps it private and cheap enough to stay free for good. And it is open source, so you never have to take my word for any of it.
            </p>
            <p class="mb-0 mt-5 text-[0.9rem] italic text-[var(--color-muted)]">
              <a class="font-semibold not-italic text-[var(--color-primary)] underline underline-offset-2 hover:text-[var(--color-primary-hover)]" href="https://github.com/shlomsh" target="_blank" rel="noopener noreferrer">Shlomi</a>
            </p>
          </div>
          <div class="flex flex-1 flex-col justify-center overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm">
            <div class="group flex items-center gap-4 px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><InfinityIcon size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">Free Forever</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">No limits, no catch</span>
              </div>
            </div>
            <div class="group flex items-center gap-4 border-t border-[var(--color-border)] px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><Lock size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">Private</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">Files never leave your device</span>
              </div>
            </div>
            <div class="group flex items-center gap-4 border-t border-[var(--color-border)] px-6 py-5 transition-colors duration-[250ms] ease-out hover:bg-[var(--color-primary-tint)]">
              <div class="flex size-11 shrink-0 items-center justify-center rounded-[var(--radius-sm)] bg-[var(--color-primary-soft)] text-[var(--color-primary)] transition-[transform,background-color,color] duration-[250ms] ease-out group-hover:scale-105 group-hover:bg-[var(--color-primary)] group-hover:text-[var(--color-surface)]"><Code2 size={20} strokeWidth={2} /></div>
              <div class="flex min-w-0 flex-col gap-[0.2rem]">
                <strong class="text-[0.95rem] font-semibold text-[var(--color-text)]">Open Source</strong>
                <span class="text-[0.85rem] text-[var(--color-muted)]">Audit the code yourself</span>
              </div>
            </div>
          </div>
        </div>
      </FeatureCard>

      <FeatureCard variant="highlight" class="relative isolate overflow-hidden">
        <CardDecor sketch="waves" icon={HardDriveDownload} iconPos="cr" iconSize={300} parallax />
        <div class="flex items-center gap-12 max-[768px]:flex-col-reverse max-[768px]:gap-8">
          <div class="relative flex min-h-[210px] w-full flex-[0.8] items-center justify-center py-4" aria-hidden="true">
            <div class="relative w-[290px] max-w-full rotate-[-1.5deg]">
              <div class="overflow-hidden rounded-[var(--radius-sm)] border-[1.5px] border-[var(--color-primary-soft)] bg-[var(--color-surface)] shadow-md">
                <div class="flex items-center gap-[0.3rem] border-b border-[var(--color-border)] bg-[var(--color-surface-soft)] px-3 py-[0.45rem]">
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="size-1.5 rounded-full bg-[var(--color-muted-light)]"></span>
                  <span class="ms-2 h-1.5 w-16 rounded-full bg-[var(--color-border)]"></span>
                </div>
                <svg class="block w-full" viewBox="0 0 200 132" role="presentation" focusable="false">
                  <g class="fill-[var(--color-border)]">
                    <rect x="18" y="30" width="164" height="4" rx="2" />
                    <rect x="18" y="40" width="164" height="4" rx="2" />
                    <rect x="18" y="50" width="118" height="4" rx="2" />
                    <rect x="142" y="82" width="40" height="4" rx="2" />
                    <rect x="142" y="92" width="26" height="4" rx="2" />
                    <rect x="18" y="122" width="88" height="4" rx="2" />
                  </g>
                  <rect x="18" y="14" width="72" height="6" rx="3" class="fill-[var(--color-muted-light)]" />

                  <rect x="24" y="68" width="100" height="44" rx="6" class="fill-[var(--color-primary-soft)] stroke-[var(--color-primary)]" stroke-width="1.2" stroke-dasharray="4 3" stroke-opacity="0.55" />
                  <g fill="none" class="stroke-[var(--color-primary)]" stroke-linecap="round" stroke-linejoin="round">
                    <path
                      d="M 32 98 C 34 84, 40 74, 46 77 C 52 80, 44 92, 40 96 C 36 100, 46 100, 52 92 C 58 84, 62 90, 59 96 C 56 102, 64 100, 68 91 C 72 82, 77 87, 74 95 C 71 103, 80 100, 85 91 C 90 82, 96 86, 93 95 C 90 104, 99 101, 105 92"
                      stroke-width="2.2"
                    />
                    <path d="M 34 104 C 60 110, 88 107, 114 95" stroke-width="1.6" stroke-opacity="0.7" />
                  </g>
                  <g class="fill-[var(--color-surface)] stroke-[var(--color-primary)]" stroke-width="1.4">
                    <rect x="21" y="65" width="6" height="6" rx="1.5" />
                    <rect x="121" y="65" width="6" height="6" rx="1.5" />
                    <rect x="21" y="109" width="6" height="6" rx="1.5" />
                    <rect x="121" y="109" width="6" height="6" rx="1.5" />
                  </g>
                </svg>
              </div>

              <div class="absolute left-[14%] top-[54%] flex -translate-y-full items-center gap-[0.45rem] rounded-[var(--radius-pill)] border border-[var(--color-border)] bg-[var(--color-surface)] px-[0.5rem] py-[0.3rem] text-[var(--color-muted)] shadow-sm">
                <Type size={11} strokeWidth={2.2} />
                <PenLine size={11} strokeWidth={2.2} class="text-[var(--color-primary)]" />
                <span class="h-3 w-px bg-[var(--color-border)]"></span>
                <Trash2 size={11} strokeWidth={2.2} />
              </div>

              <div class="absolute -bottom-3 -right-3 inline-flex items-center gap-[0.35rem] rounded-[var(--radius-pill)] border border-[color-mix(in_srgb,var(--color-success)_20%,transparent)] bg-[var(--color-success-soft)] px-[0.6rem] py-[0.3rem] text-[0.7rem] font-semibold text-[var(--color-success)] shadow-sm">
                <span class="size-1.5 rounded-full bg-[var(--color-success)] animate-[pulse_2s_infinite]"></span>
                Autosaved to device
              </div>
            </div>
          </div>
          <div class="flex-[1.2]">
            <span class="mb-2 inline-block text-[0.72rem] font-bold uppercase text-[var(--color-primary)]">Privacy & Convenience</span>
            <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">Work survives restarts and crashes</h2>
            <p class="type-lead space-content-row mt-0 text-[var(--color-text)]">
              PDkef auto-saves your in-progress work locally to your browser's secure database. If you close the tab, restart your computer, or experience a crash, your PDF and edits are restored exactly where you left off.
            </p>
            <p class="type-body m-0 text-[var(--color-muted)]">
              Because it runs 100% on your device, we get "pick up where you left off" without sending a single byte of your file to a server. Available now in <strong>Sign & Fill</strong> and <strong>Redact & Blur</strong>.
            </p>
          </div>
        </div>
      </FeatureCard>

      <FeatureCard class="relative isolate overflow-hidden">
        <CardDecor sketch="grid" icon={WifiOff} iconPos="br" iconSize={300} parallax />
        <div class="mx-auto mb-8 max-w-[750px] text-center">
          <h2 class="type-section space-heading-content mt-0 text-[var(--color-text)]">Run PDkef offline as an app</h2>
          <p class="type-lead m-0 text-[var(--color-muted)]">Because PDkef runs entirely in your web browser with zero server uploads, you can install it on your device and use it just like a native desktop or mobile application, even when you don't have internet access.</p>
        </div>

        <div class="box-border mx-auto w-full max-w-[680px] overflow-hidden rounded-[var(--radius)] border border-[var(--color-border)] bg-[var(--color-surface)] shadow-sm">
          <div class="flex border-b border-[var(--color-border)] bg-[var(--color-surface-soft)] max-[640px]:flex-col" role="tablist" aria-label="Device installation guides">
