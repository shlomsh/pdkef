---
import ContentPageLayout from '../../layouts/ContentPageLayout.astro';
import ContentPage from '../../components/ContentPage.astro';
import { CONTENT_ICONS } from '../../data/contentIcons';
import { documentationLocales, getDocumentationLocaleByPrefix } from '../../i18n/documentationLocales';
import { getDocumentationContext, getDocumentationVariants } from '../../i18n/documentation';
import { getDocumentationShellMessages } from '../../i18n/documentationMessages';

export async function getStaticPaths() {
  const variants = await getDocumentationVariants();
  return variants
    .filter((variant) => variant.locale !== 'en')
    .map((variant) => {
      const locale = documentationLocales.find((record) => record.id === variant.locale)!;
      return {
        params: { locale: locale.prefix, contentPage: variant.pageId },
        props: { pageId: variant.pageId, localeId: variant.locale },
      };
    });
}

const { pageId, localeId } = Astro.props;
const routeLocale = getDocumentationLocaleByPrefix(Astro.params.locale ?? '');
if (!routeLocale || routeLocale.id !== localeId) {
  throw new Error(`Invalid documentation locale route: ${Astro.params.locale}`);
}

const context = await getDocumentationContext(pageId, localeId);
const entry: any = context.entry;
const page = entry.data;
const messages = getDocumentationShellMessages(context.effectiveLocale);
// ARCH-09 supplies source freshness separately from publication state. A stale
// draft remains a noindex preview, with a more specific localized notice.
const stale = context.preview && context.freshness === 'stale';
---

<ContentPageLayout
  title={page.title}
  description={page.description}
  breadcrumb={page.breadcrumb}
  icon={CONTENT_ICONS[page.icon as keyof typeof CONTENT_ICONS]}
  kicker={page.kicker}
  h1={page.h1}
  subhead={page.subhead}
  primaryCta={page.primaryCta}
  faq={page.faq}
  lang={context.lang}
  dir={context.dir}
  canonical={context.path}
  alternates={context.preview ? [] : context.alternates}
  noindex={context.preview}
  locale={context.effectiveLocale}
  variants={context.variants}
  preview={context.preview}
  messages={messages}
  previewNotice={stale ? messages.stalePreviewNotice : messages.previewNotice}
>
  <ContentPage
    entry={entry}
    pageId={pageId}
    locale={context.effectiveLocale}
    labels={messages}
    resolveLink={(targetPageId: string, targetLocale: string) => context.resolveDocumentationLink(targetPageId, targetLocale)}
  />
</ContentPageLayout>
