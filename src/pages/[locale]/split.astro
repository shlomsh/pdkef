---
import LocalizedToolLayout from '../../layouts/LocalizedToolLayout.astro';
import { localizedToolPaths, loadLocalizedToolPage } from '../../site-lib/localizedToolPage';
import PdfSplitTool from '../../tools/split/PdfSplitTool.tsx';

export function getStaticPaths() {
  return localizedToolPaths('split');
}

const page = await loadLocalizedToolPage('split', Astro.props.localeId, Astro.params.locale ?? '');
---

<LocalizedToolLayout page={page}>
  <PdfSplitTool client:load messages={page.toolMessages} shellMessages={page.shellMessages} />
</LocalizedToolLayout>
