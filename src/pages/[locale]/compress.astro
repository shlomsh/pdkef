---
import LocalizedToolLayout from '../../layouts/LocalizedToolLayout.astro';
import { localizedToolPaths, loadLocalizedToolPage } from '../../site-lib/localizedToolPage';
import PdfCompressTool from '../../tools/compress/PdfCompressTool.tsx';

export function getStaticPaths() {
  return localizedToolPaths('compress');
}

const page = await loadLocalizedToolPage('compress', Astro.props.localeId, Astro.params.locale ?? '');
---

<LocalizedToolLayout page={page}>
  <PdfCompressTool client:load messages={page.toolMessages} shellMessages={page.shellMessages} />
</LocalizedToolLayout>
