---
import LocalizedToolLayout from '../../layouts/LocalizedToolLayout.astro';
import { localizedToolPaths, loadLocalizedToolPage } from '../../site-lib/localizedToolPage';
import PdfMergeTool from '../../tools/merge/PdfMergeTool.tsx';

export function getStaticPaths() {
  return localizedToolPaths('merge');
}

const page = await loadLocalizedToolPage('merge', Astro.props.localeId, Astro.params.locale ?? '');
---

<LocalizedToolLayout page={page}>
  <PdfMergeTool client:load messages={page.toolMessages as any} shellMessages={page.shellMessages} />
</LocalizedToolLayout>
