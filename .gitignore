node_modules/
dist/
.astro/
.DS_Store
*.log
.vercel
# .claude/ is local (settings, worktrees, skills) except rules/, which is
# team-shared agent guidance loaded per matching file (see CLAUDE.md), and
# agents/, the shared subagent types.
.claude/*
!.claude/rules/
!.claude/agents/
playwright-report/
test-results/
.nx/
# Synced from node_modules/pdfjs-dist/wasm/ by scripts/sync-pdfjs-wasm.mjs
# (postinstall) - see src/lib/pdfjsWasm.js.
public/pdfjs-dist-wasm/
.ci-narrowing-cache/
# Impeccable (design skill) is a local, per-person install (user level:
# `npx impeccable install`), never vendored. A project-level install writes
# these paths; keep them out of git.
.github/skills/impeccable/
.github/agents/impeccable-*
.github/hooks/impeccable.json
.claude/skills/impeccable/
.claude/agents/impeccable-*
.agents/skills/impeccable/
.codex/hooks.json

# Local env files: `vercel env pull` writes secrets here (the error-report store token).
.env*.local
