{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": [],
  "jsPlugins": [
    {
      "name": "landmines-testing",
      "specifier": "@interfere/landmines/testing"
    },
    {
      "name": "landmines-style",
      "specifier": "@interfere/landmines/style"
    },
    {
      "name": "landmines-structure",
      "specifier": "@interfere/landmines/structure"
    },
    {
      "name": "landmines-types",
      "specifier": "@interfere/landmines/types"
    }
  ],
  "rules": {
    "landmines-testing/no-unsignaled-poll": "error",
    "landmines-testing/no-flake-masking": [
      "error",
      {
        "allow": {
          "scripts/vitest-worker-watchdog.test.mjs": 5,
          "src/test/cross-tool/draftCheckingPlaceholder.test.tsx": 2,
          "src/tools/redact/lib/check/realForms.test.js": 1,
          "src/tools/redact/lib/check/runCheck.test.ts": 1,
          "src/tools/redact/lib/find/glyphBoxes.corpus.test.js": 4,
          "src/tools/scan/lib/edges/corpus.test.ts": 2,
          "src/tools/scan/lib/edges/realCorpus.test.ts": 2,
          "src/tools/scan/lib/edges/repair.test.ts": 1,
          "src/tools/security/lib/security.test.js": 1,
          "src/tools/sign/PdfSignTool.test.tsx": 1,
          "src/tools/sign/lib/fields/corpus/layout/layout.test.js": 1,
          "src/tools/sign/lib/flatten.js": 1
        }
      }
    ],
    "landmines-testing/no-fixed-sleep": [
      "error",
      {
        "allow": {
          "scripts/vitest-worker-watchdog.test.mjs": 1
        }
      }
    ],
    "landmines-testing/no-test-doubles": "off",
    "landmines-testing/strict-msw": [
      "error",
      {
        "allow": {
          "src/test/support/network.ts": 1,
          "src/test/support/network.browser.ts": 1
        }
      }
    ],
    "landmines-structure/colocated-tests": "error",
    "landmines-structure/test-file-names": "error",
    "landmines-structure/package-exports": "error",
    "landmines-types/no-explicit-return-types": "error",
    "landmines-style/no-comments": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "node:*"
            ],
            "message": "Browser code runs without Node: no node: imports outside build helpers, scripts and tests."
          }
        ],
        "paths": [
          {
            "name": "fs",
            "message": "Browser code runs without Node."
          },
          {
            "name": "path",
            "message": "Browser code runs without Node."
          },
          {
            "name": "os",
            "message": "Browser code runs without Node."
          },
          {
            "name": "url",
            "message": "Browser code runs without Node."
          },
          {
            "name": "crypto",
            "message": "Browser code runs without Node."
          },
          {
            "name": "child_process",
            "message": "Browser code runs without Node."
          },
          {
            "name": "zlib",
            "message": "Browser code runs without Node."
          },
          {
            "name": "module",
            "message": "Browser code runs without Node."
          },
          {
            "name": "util",
            "message": "Browser code runs without Node."
          },
          {
            "name": "stream",
            "message": "Browser code runs without Node."
          },
          {
            "name": "buffer",
            "message": "Browser code runs without Node."
          },
          {
            "name": "process",
            "message": "Browser code runs without Node."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "Buffer",
        "message": "Browser code runs without Node."
      },
      {
        "name": "process",
        "message": "Browser code runs without Node."
      },
      {
        "name": "__dirname",
        "message": "Browser code runs without Node."
      },
      {
        "name": "__filename",
        "message": "Browser code runs without Node."
      },
      {
        "name": "require",
        "message": "Browser code runs without Node."
      },
      {
        "name": "global",
        "message": "Browser code runs without Node."
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "public/**",
    "src/test/browser-public/**",
    "test-results/**",
    "playwright-report/**",
    "**/*.astro"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**",
        "api/**",
        "middleware.ts",
        "spikes/**",
        "e2e/**",
        "**/e2e/**",
        "*.config.*",
        "**/*.test.*",
        "**/*.test-helper.*",
        "src/test/**",
        "src/site-lib/cspHash.js",
        "src/site-lib/flagFiles.ts",
        "src/site-lib/gitLastModified.js",
        "src/site-lib/notesAtBuild.ts",
        "src/site-lib/ratingAggregate.ts",
        "src/tools/sign/lib/fields/corpus/**"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
