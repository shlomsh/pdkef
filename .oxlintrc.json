{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "off"
  },
  "plugins": [],
  "jsPlugins": [
    {
      "name": "landmines",
      "specifier": "@interfere/landmines"
    }
  ],
  "rules": {
    "landmines/no-unsignaled-poll": [
      "error",
      {
        "allow": {
          "e2e/demo/heroDemoHelpers.js": 1,
          "scripts/vitest-worker-watchdog.test.mjs": 1,
          "src/test/cross-tool/draftCheckingPlaceholder.test.tsx": 1,
          "src/test/support/redactTool.browser.tsx": 1,
          "src/test/support/until.js": 1
        }
      }
    ],
    "landmines/no-flake-masking": [
      "error",
      {
        "allow": {
          "scripts/vitest-worker-watchdog.test.mjs": 5,
          "src/test/cross-tool/draftCheckingPlaceholder.test.tsx": 2,
          "src/tools/redact/lib/check/realForms.test.js": 1,
          "src/tools/redact/lib/check/runCheck.test.ts": 1,
          "src/tools/redact/lib/find/glyphBoxes.corpus.test.js": 4,
          "src/tools/scan/lib/edges/corpus.test.ts": 2,
          "src/tools/scan/lib/edges/realCorpus.test.ts": 2,
          "src/tools/scan/lib/edges/repair.test.ts": 1,
          "src/tools/security/lib/security.test.js": 1,
          "src/tools/sign/PdfSignTool.test.tsx": 1,
          "src/tools/sign/lib/fields/corpus/layout/layout.test.js": 1
        }
      }
    ],
    "landmines/no-fixed-sleep": [
      "error",
      {
        "allow": {
          "e2e/cross-tool/page-grid-parity.spec.js": 1,
          "e2e/demo/autoplay-and-slide.spec.js": 1,
          "e2e/handoff/editor-handoff-cls.spec.js": 1,
          "e2e/home/demo-fits.spec.js": 2,
          "e2e/home/launcher-picker-pinned.spec.js": 1,
          "e2e/localized/rtl-shell.spec.js": 1,
          "e2e/offline/app-update.spec.js": 4,
          "e2e/offline/offline-workflows.spec.js": 5,
          "e2e/tool-empty-state-keyboard.spec.js": 1,
          "e2e/tool-hero-first-screen.spec.js": 6,
          "e2e/tool-hero-throttled-cls.spec.js": 1,
          "e2e/tool-hero-verb-replay.spec.js": 1,
          "e2e/tool-toolbars/toolbar-double-click-lock-timed.spec.js": 1,
          "e2e/tool-toolbars/toolbar-export-quiet.spec.js": 1,
          "scripts/generate-scan-examples.mjs": 3,
          "scripts/vitest-worker-watchdog.test.mjs": 1,
          "src/tools/compress/e2e/compress-note-no-shift.spec.js": 2,
          "src/tools/merge/e2e/merge-direction-a.spec.js": 2,
          "src/tools/merge/e2e/merge-mobile.spec.js": 2,
          "src/tools/merge/e2e/merge-saved-work-restore-acceptance.spec.js": 4,
          "src/tools/redact/e2e/redact-hidden-traces.spec.js": 1,
          "src/tools/redact/e2e/redact-saved-work-restore-acceptance.spec.js": 1,
          "src/tools/sign/e2e/field-move-scroll.spec.js": 2,
          "src/tools/sign/e2e/fill-mode-phone-regressions.spec.js": 2,
          "src/tools/sign/e2e/fill-mode-zoom.spec.js": 3,
          "src/tools/sign/e2e/sign-saved-work-restore-acceptance.spec.js": 1
        }
      }
    ],
    "landmines/no-test-doubles": "error",
    "landmines/strict-msw": [
      "error",
      {
        "allow": {
          "src/test/support/network.ts": 1,
          "src/test/support/network.browser.ts": 1
        }
      }
    ],
    "landmines/colocated-tests": "error",
    "landmines/test-file-names": "off",
    "landmines/package-exports": "error",
    "landmines/no-explicit-return-types": "off",
    "landmines/no-comments": "off",
    "landmines/no-shared-signal": "error",
    "landmines/no-stale-render-assertion": "error",
    "landmines/no-styling-class-assertion": "error",
    "landmines/no-clipboard-read-text": "error",
    "landmines/no-imported-mutation": "error",
    "landmines/no-self-container-query": "error",
    "landmines/no-github-scripts": "error",
    "landmines/no-parameter-branch": [
      "error",
      {
        "allow": {
          "src/tools/edit-pages/PdfEditPagesTool.open.test.tsx": 1
        }
      }
    ],
    "landmines/no-elapsed-time-bound": "error",
    "landmines/no-silent-catch": "error",
    "landmines/no-cold-import-in-test": "error",
    "landmines/no-cold-start-in-test": "error",
    "landmines/no-conditional-expect": "error",
    "landmines/declared-test-inputs": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": [
              "node:*"
            ],
            "message": "Browser code runs without Node: no node: imports outside build helpers, scripts and tests."
          }
        ],
        "paths": [
          {
            "name": "fs",
            "message": "Browser code runs without Node."
          },
          {
            "name": "path",
            "message": "Browser code runs without Node."
          },
          {
            "name": "os",
            "message": "Browser code runs without Node."
          },
          {
            "name": "url",
            "message": "Browser code runs without Node."
          },
          {
            "name": "crypto",
            "message": "Browser code runs without Node."
          },
          {
            "name": "child_process",
            "message": "Browser code runs without Node."
          },
          {
            "name": "zlib",
            "message": "Browser code runs without Node."
          },
          {
            "name": "module",
            "message": "Browser code runs without Node."
          },
          {
            "name": "util",
            "message": "Browser code runs without Node."
          },
          {
            "name": "stream",
            "message": "Browser code runs without Node."
          },
          {
            "name": "buffer",
            "message": "Browser code runs without Node."
          },
          {
            "name": "process",
            "message": "Browser code runs without Node."
          }
        ]
      }
    ],
    "no-restricted-globals": [
      "error",
      {
        "name": "Buffer",
        "message": "Browser code runs without Node."
      },
      {
        "name": "process",
        "message": "Browser code runs without Node."
      },
      {
        "name": "__dirname",
        "message": "Browser code runs without Node."
      },
      {
        "name": "__filename",
        "message": "Browser code runs without Node."
      },
      {
        "name": "require",
        "message": "Browser code runs without Node."
      },
      {
        "name": "global",
        "message": "Browser code runs without Node."
      }
    ]
  },
  "ignorePatterns": [
    "dist/**",
    ".astro/**",
    "public/**",
    "src/test/browser-public/**",
    "test-results/**",
    "playwright-report/**",
    "**/*.astro"
  ],
  "overrides": [
    {
      "files": [
        "scripts/**",
        "api/**",
        "middleware.ts",
        "spikes/**",
        "e2e/**",
        "**/e2e/**",
        "*.config.*",
        "**/*.test.*",
        "**/*.test-helper.*",
        "src/test/**",
        "src/site-lib/cspHash.js",
        "src/site-lib/flagFiles.ts",
        "src/site-lib/gitLastModified.js",
        "src/site-lib/notesAtBuild.ts",
        "src/site-lib/ratingAggregate.ts",
        "src/tools/sign/lib/fields/corpus/**"
      ],
      "rules": {
        "no-restricted-imports": "off",
        "no-restricted-globals": "off"
      }
    }
  ]
}
